---
export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
}

const { title, description, permalink, current = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={permalink} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Top Highlight Banner for Taptap Send Referral -->
    <div class="promo-top-bar">
      <div class="promo-inner">
        <span class="promo-tag">🎁 EXCLUSIVE BONUS</span>
        <span class="promo-text">Send money from Cyprus with <strong>0% fee</strong>! Use promo code <span class="promo-code" id="promo-code-btn" title="Click to copy">MDSAIDUR240</span> for an instant cashback bonus!</span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="promo-link">Claim Bonus →</a>
      </div>
    </div>

    <!-- Navigation Header -->
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo">Cyprus <span>Student Guide</span></a>
        <nav class="site-nav">
          <a href="/" class={current === 'home' ? 'active' : ''}>HOME</a>
          <a href="/about/" class={current === 'about' ? 'active' : ''}>ABOUT</a>
          <a href="/blog/" class={current === 'blog' ? 'active' : ''}>BLOG</a>
          <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">☀️ / 🌙</button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; 2026 CyprusStudentGuide.com - Built with authenticity for international students.</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg-color: #0f172a;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --card-bg: #1e293b;
        --border-color: rgba(255, 255, 255, 0.1);
        --primary-blue: #38bdf8;
      }

      html:not(.dark) {
        --bg-color: #f8fafc;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --card-bg: #ffffff;
        --border-color: rgba(0, 0, 0, 0.08);
        --primary-blue: #2563eb;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        line-height: 1.6;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      /* Highlighted Sticky Top Promo Bar */
      .promo-top-bar {
        background: linear-gradient(90deg, #1e3a8a, #2563eb, #0284c7);
        color: #ffffff;
        padding: 0.55rem 1rem;
        font-size: 0.88rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      }

      .promo-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        text-align: center;
      }

      .promo-tag {
        background: #facc15;
        color: #000000;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        letter-spacing: 0.03em;
      }

      .promo-code {
        background: rgba(0, 0, 0, 0.3);
        border: 1px dashed #facc15;
        color: #facc15;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-family: monospace;
        font-weight: 700;
        cursor: pointer;
        user-select: all;
      }

      .promo-link {
        color: #ffffff;
        font-weight: 700;
        text-decoration: underline;
        margin-left: 0.25rem;
      }

      .promo-link:hover {
        color: #facc15;
      }

      /* Site Header & Navigation */
      .site-header {
        border-bottom: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      html:not(.dark) .site-header {
        background: rgba(255, 255, 255, 0.9);
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .site-logo {
        font-size: 1.35rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--text-main);
      }

      .site-logo span {
        color: var(--primary-blue);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .site-nav a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s ease;
      }

      .site-nav a:hover,
      .site-nav a.active {
        color: var(--primary-blue);
      }

      .theme-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.9rem;
        color: inherit;
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        padding: 2.5rem 1rem;
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 4rem;
      }
    </style>

    <script is:inline>
      // Theme toggler
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // Copy code alert on click
      const promoBtn = document.getElementById('promo-code-btn');
      if (promoBtn) {
        promoBtn.addEventListener('click', () => {
          navigator.clipboard.writeText('MDSAIDUR240');
          const orig = promoBtn.innerText;
          promoBtn.innerText = 'COPIED!';
          setTimeout(() => {
            promoBtn.innerText = orig;
          }, 2000);
        });
      }
    </script>
  </body>
</html>
