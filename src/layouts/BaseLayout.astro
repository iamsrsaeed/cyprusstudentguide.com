---
import DisclaimerNotice from '../components/DisclaimerNotice.astro';

export interface Props {
  title?: string;
  description?: string;
  permalink?: string;
  current?: string;
  image?: string;
  hideDisclaimer?: boolean;
}

const {
  title = "Cyprus Student Guide - Complete Guide for International Students in Cyprus",
  description = "Complete guide for international students in Cyprus covering study, jobs, student visa, living costs, and life in North and South Cyprus.",
  permalink = "https://cyprusstudentguide.com",
  current = "",
  image = "/assets/banner.png",
  hideDisclaimer = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://cyprusstudentguide.com').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a href="/" class="logo">
          <span class="logo-badge">CY</span>
          <strong>Cyprus Student Guide</strong>
        </a>
        <div class="nav-links">
          <a href="/" class={current === "home" ? "active" : ""}>Home</a>
          <a href="/guides/" class={current === "guides" ? "active" : ""}>Guides</a>
          <a href="/calculator/" class={current === "calculator" ? "active" : ""}>📊 Budget</a>
          <a href="/shift-tracker/" class={current === "tracker" ? "active" : ""}>⏱️ Work Tracker</a>
          <a href="/about/" class={current === "about" ? "active" : ""}>About</a>
        </div>
      </nav>
    </header>

    <main class="main-content">
      <slot />

      <!-- Automatic Site-Wide Legal Disclaimer Notice -->
      {!hideDisclaimer && current !== "disclaimer" && (
        <div class="layout-disclaimer-wrapper">
          <DisclaimerNotice />
        </div>
      )}
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>Cyprus Student Guide</h3>
            <p>Independent educational and financial information portal supporting international students in Cyprus.</p>
          </div>
          <div class="footer-links">
            <h4>Quick Links</h4>
            <ul>
              <li><a href="/guides/">Student Guides</a></li>
              <li><a href="/shift-tracker/">Shift Tracker</a></li>
              <li><a href="/calculator/">Cost Calculator</a></li>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact Us</a></li>
            </ul>
          </div>
          <div class="footer-legal">
            <h4>Legal & Policies</h4>
            <ul>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Service</a></li>
              <li><a href="/disclaimer/">Legal Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} CyprusStudentGuide.com. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary-blue: #2563eb;
    --primary-glow: rgba(37, 99, 235, 0.15);
    --text-main: #1e293b;
    --text-muted: #64748b;
    --bg-color: #ffffff;
    --card-bg: #ffffff;
    --card-border: #e2e8f0;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  html.dark {
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --bg-color: #0b0f19;
    --card-bg: #111827;
    --card-border: #1f2937;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    box-sizing: border-box;
  }

  .layout-disclaimer-wrapper {
    max-width: 980px;
    margin: 0 auto;
  }

  /* Header & Navigation */
  .site-header {
    background: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.85rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-main);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .logo-badge {
    background: var(--primary-blue);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
  }
  .nav-links {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }
  .nav-links a:hover, .nav-links a.active {
    color: var(--primary-blue);
  }

  /* Footer */
  .site-footer {
    background: var(--card-bg);
    border-top: 1px solid var(--card-border);
    padding: 3rem 1rem 1.5rem;
    margin-top: auto;
  }
  .footer-container {
    max-width: 1080px;
    margin: 0 auto;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .footer-brand h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    color: var(--text-main);
  }
  .footer-brand p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
  }
  .footer-links h4, .footer-legal h4 {
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-main);
  }
  .footer-links ul, .footer-legal ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-links a, .footer-legal a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }
  .footer-links a:hover, .footer-legal a:hover {
    color: var(--primary-blue);
  }
  .footer-bottom {
    border-top: 1px solid var(--card-border);
    padding-top: 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .nav-links {
      gap: 0.75rem;
      font-size: 0.82rem;
    }
  }
</style>
