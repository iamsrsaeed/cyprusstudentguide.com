---
export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
}

const { title, description, permalink, current = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={permalink} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google AdSense Verification & Auto Ads Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4089174887676363" crossorigin="anonymous"></script>

    <!-- Open Graph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cyprus Student Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={permalink} />
    <meta property="og:image" content="https://cyprusstudentguide.com/favicon.svg" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cyprusstudentguide.com/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

    <!-- Immediate Theme Persistence -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <!-- Top Highlight Banner for Taptap Send Referral (€10 New User Bonus) -->
    <div class="promo-top-bar notranslate">
      <div class="promo-inner">
        <span class="promo-tag">🎁 TAPTAP SEND BONUS</span>
        <span class="promo-text">Send money from Cyprus with <strong>0% fee</strong>! Code: <span class="promo-code" id="promo-code-btn" title="Click to copy">MDSAIDUR240</span></span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="promo-link">Claim €10 Bonus ➔</a>
      </div>
    </div>

    <!-- Glowing Background Mesh -->
    <div class="bg-mesh-glow"></div>

    <!-- Responsive Navigation Header -->
    <header class="site-header notranslate">
      <div class="header-container">
        <a href="/" class="site-logo">
          <span class="logo-badge">CY</span>
          <span class="logo-text">Cyprus <strong>Student Guide</strong></span>
        </a>
        
        <div class="header-right">
          <nav class="site-nav">
            <a href="/" class={current === 'home' ? 'active' : ''}>Home</a>
            <a href="/blog/" class={current === 'blog' ? 'active' : ''}>All Guides</a>
            <a href="/calculator/" class={current === 'calculator' ? 'active nav-highlight' : 'nav-highlight'}>🧮 Cost Calculator</a>
            <a href="/about/" class={current === 'about' ? 'active' : ''}>About</a>
          </nav>

          <div class="header-controls">
            <!-- International Student Language Selector -->
            <div class="lang-dropdown">
              <select id="custom-language-select" aria-label="Select Language">
                <option value="en">🇬🇧 EN</option>
                <option value="bn">🇧🇩 BN</option>
                <option value="hi">🇮🇳 HI</option>
                <option value="ur">🇵🇰 UR</option>
                <option value="ne">🇳🇵 NE</option>
                <option value="el">🇨🇾 EL</option>
                <option value="ar">🇸🇦 AR</option>
                <option value="fr">🇫🇷 FR</option>
              </select>
            </div>

            <!-- Theme Toggle Button -->
            <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
              <span class="sun-icon">☀️</span>
              <span class="moon-icon">🌙</span>
            </button>
          </div>
        </div>
      </div>
      <!-- Global Sticky Reading Progress Bar Container -->
      <div id="site-reading-progress" class="site-reading-progress"></div>
    </header>

    <!-- Hidden native translation container -->
    <div id="google_translate_element" style="display: none;"></div>

    <main class="main-content">
      <slot />
    </main>

    <!-- Global Visual Footer with Legal Policy Links -->
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-brand notranslate">
          <a href="/" class="site-logo footer-logo">
            <span class="logo-badge">CY</span>
            <span class="logo-text">Cyprus <strong>Student Guide</strong></span>
          </a>
          <p class="footer-tagline">The most trusted, verified, and hype-free resource portal for international students in Cyprus.</p>
        </div>

        <div class="footer-share-section">
          <p class="share-site-label">Share This Knowledge Base:</p>
          <div class="footer-share-links">
            <a href="https://api.whatsapp.com/send?text=Check%20out%20Cyprus%20Student%20Guide%20-%20The%20definitive%20resource%20for%20students%20in%20Cyprus%3A%20https%3A%2F%2Fcyprusstudentguide.com" target="_blank" rel="noopener noreferrer" class="foot-share-btn notranslate">💬 WhatsApp</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fcyprusstudentguide.com" target="_blank" rel="noopener noreferrer" class="foot-share-btn notranslate">📘 Facebook</a>
            <a href="https://twitter.com/intent/tweet?text=Check%20out%20Cyprus%20Student%20Guide&url=https%3A%2F%2Fcyprusstudentguide.com" target="_blank" rel="noopener noreferrer" class="foot-share-btn notranslate">𝕏 Post</a>
          </div>
        </div>

        <div class="footer-links-row notranslate">
          <a href="/about/">About Us</a>
          <span class="sep">•</span>
          <a href="/calculator/">Cost Calculator</a>
          <span class="sep">•</span>
          <a href="/privacy/">Privacy Policy</a>
          <span class="sep">•</span>
          <a href="/terms/">Terms of Service</a>
          <span class="sep">•</span>
          <a href="/disclaimer/">Disclaimer</a>
          <span class="sep">•</span>
          <a href="/contact/">Contact Desk</a>
        </div>

        <div class="footer-bottom notranslate">
          <p class="copyright">&copy; 2026 CyprusStudentGuide.com • Built with precision & authentic field data.</p>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --font-main: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        
        --bg-color: #f8fafc;
        --text-main: #0f172a;
        --text-muted: #475569;
        --card-bg: #ffffff;
        --card-border: rgba(15, 23, 42, 0.08);
        --primary-blue: #2563eb;
        --primary-glow: rgba(37, 99, 235, 0.15);
        --table-bg: #ffffff;
        --table-stripe: #f8fafc;
      }

      html.dark {
        --bg-color: #080d1a;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --card-bg: #0f172a;
        --card-border: rgba(255, 255, 255, 0.08);
        --primary-blue: #38bdf8;
        --primary-glow: rgba(56, 189, 248, 0.15);
        --table-bg: #0f172a;
        --table-stripe: #131d31;
      }

      .goog-te-banner-frame.skiptranslate, 
      .goog-te-gadget-icon, 
      #goog-gt-tt, 
      .goog-te-balloon-frame {
        display: none !important;
      }
      body {
        top: 0px !important;
        margin: 0;
        padding: 0;
        font-family: var(--font-main);
        background-color: var(--bg-color);
        color: var(--text-main);
        line-height: 1.75;
        position: relative;
        overflow-x: hidden;
        transition: background-color 0.25s ease, color 0.25s ease;
      }

      * { box-sizing: border-box; }

      .bg-mesh-glow {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 100vw;
        height: 480px;
        background: radial-gradient(circle at 50% 10%, var(--primary-glow) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
      }

      .promo-top-bar {
        background: linear-gradient(90deg, #1d4ed8, #2563eb, #0284c7);
        color: #ffffff;
        padding: 0.5rem 0.75rem;
        font-size: 0.84rem;
        position: relative;
        z-index: 60;
        box-shadow: 0 2px 10px rgba(37, 99, 235, 0.2);
      }

      .promo-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.4rem 0.6rem;
        text-align: center;
      }

      .promo-tag {
        background: #facc15;
        color: #000000;
        font-size: 0.7rem;
        font-weight: 800;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        letter-spacing: 0.03em;
        white-space: nowrap;
      }

      .promo-code {
        background: #0b1120;
        border: 1px dashed #facc15;
        color: #facc15;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: 0.88rem;
        font-weight: 700;
        cursor: pointer;
        display: inline-block;
        white-space: nowrap;
      }

      .promo-link {
        color: #ffffff;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 2px;
        white-space: nowrap;
      }

      .promo-link:hover { color: #facc15; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--card-border);
      }

      html.dark .site-header {
        background: rgba(8, 13, 26, 0.9);
      }

      .site-reading-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3.5px;
        width: 0%;
        background: linear-gradient(90deg, #2563eb 0%, #38bdf8 50%, #facc15 100%);
        pointer-events: none;
        transition: width 0.05s ease-out;
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.75rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
      }

      .site-logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text-main);
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        flex-shrink: 0;
      }

      .logo-badge {
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 800;
        padding: 0.25rem 0.45rem;
        border-radius: 6px;
      }

      .site-logo strong { color: var(--primary-blue); }

      .header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 0.85rem;
      }

      .site-nav a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.88rem;
        font-weight: 600;
        transition: color 0.15s ease;
        white-space: nowrap;
      }

      .site-nav a:hover,
      .site-nav a.active { color: var(--primary-blue); }

      .nav-highlight {
        color: #2563eb !important;
        font-weight: 700 !important;
      }
      html.dark .nav-highlight {
        color: #38bdf8 !important;
      }

      .header-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .lang-dropdown select {
        background: rgba(150, 150, 150, 0.1);
        color: inherit;
        border: 1px solid var(--card-border);
        padding: 0.3rem 0.45rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        outline: none;
      }

      .theme-btn {
        background: rgba(150, 150, 150, 0.1);
        border: 1px solid var(--card-border);
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        color: inherit;
      }

      html.dark .sun-icon { display: inline; }
      html.dark .moon-icon { display: none; }
      html:not(.dark) .sun-icon { display: none; }
      html:not(.dark) .moon-icon { display: inline; }

      .main-content {
        max-width: 960px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        position: relative;
        z-index: 1;
      }

      .site-footer {
        border-top: 1px solid var(--card-border);
        background: rgba(150, 150, 150, 0.03);
        padding: 3.5rem 1rem 2.5rem;
        position: relative;
        z-index: 1;
      }

      .footer-container { max-width: 900px; margin: 0 auto; text-align: center; }
      .footer-brand { margin-bottom: 1.75rem; }
      .footer-logo { justify-content: center; margin-bottom: 0.5rem; }
      .footer-tagline { color: var(--text-muted); font-size: 0.92rem; max-width: 500px; margin: 0 auto; }
      .footer-share-section { margin-bottom: 1.75rem; }
      .share-site-label { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.65rem; }
      .footer-share-links { display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .foot-share-btn {
        background: var(--card-bg);
        color: var(--text-main);
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 600;
        border: 1px solid var(--card-border);
      }
      .foot-share-btn:hover { border-color: var(--primary-blue); color: var(--primary-blue); }

      .footer-links-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
      }

      .footer-links-row a {
        color: var(--text-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      .footer-links-row a:hover {
        color: var(--primary-blue);
      }

      .sep {
        color: var(--text-muted);
        opacity: 0.4;
      }

      .footer-bottom { padding-top: 1.25rem; border-top: 1px solid var(--card-border); font-size: 0.82rem; color: var(--text-muted); }

      @media (max-width: 768px) {
        .header-container {
          flex-direction: column;
          align-items: stretch;
          gap: 0.6rem;
          padding: 0.6rem 0.85rem;
        }

        .header-right {
          justify-content: space-between;
          width: 100%;
          gap: 0.5rem;
        }

        .site-logo {
          justify-content: center;
          font-size: 1.1rem;
        }

        .site-nav {
          gap: 0.6rem;
          overflow-x: auto;
          white-space: nowrap;
          padding-bottom: 2px;
        }

        .site-nav a {
          font-size: 0.82rem;
        }

        .main-content {
          padding: 1.5rem 0.85rem 3.5rem;
        }
      }
    </style>

    <!-- Google Translate Script -->
    <script is:inline>
      function googleTranslateElementInit() {
        new google.translate.TranslateElement({
          pageLanguage: 'en',
          includedLanguages: 'en,bn,hi,ur,ne,el,ar,fr',
          autoDisplay: false
        }, 'google_translate_element');
      }
    </script>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <!-- Theme & Promo Script -->
    <script is:inline>
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      const promoBtn = document.getElementById('promo-code-btn');
      if (promoBtn) {
        promoBtn.addEventListener('click', () => {
          navigator.clipboard.writeText('MDSAIDUR240');
          const orig = promoBtn.innerText;
          promoBtn.innerText = 'COPIED!';
          setTimeout(() => {
            promoBtn.innerText = orig;
          }, 2000);
        });
      }

      const langSelect = document.getElementById('custom-language-select');
      function setLanguage(lang) {
        const domain = window.location.hostname;
        document.cookie = `googtrans=/en/${lang}; path=/; domain=${domain}`;
        document.cookie = `googtrans=/en/${lang}; path=/;`;
        localStorage.setItem('preferred_lang', lang);
        
        const select = document.querySelector('.goog-te-combo');
        if (select) {
          select.value = lang;
          select.dispatchEvent(new Event('change'));
        } else {
          location.reload();
        }
      }

      if (langSelect) {
        const savedLang = localStorage.getItem('preferred_lang') || 'en';
        langSelect.value = savedLang;

        langSelect.addEventListener('change', (e) => {
          setLanguage(e.target.value);
        });
      }
    </script>
  </body>
</html>
