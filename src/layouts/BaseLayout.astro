---
export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
}

const { title, description, permalink, current = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={permalink} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Immediate Theme Persistence -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <!-- Top Highlight Banner for Taptap Send Referral -->
    <div class="promo-top-bar">
      <div class="promo-inner">
        <span class="promo-tag">🎁 EXCLUSIVE BONUS</span>
        <span class="promo-text">Send money from Cyprus with <strong>0% fee</strong>! Use promo code <span class="promo-code" id="promo-code-btn" title="Click to copy">MDSAIDUR240</span> for an instant cashback bonus!</span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="promo-link">Claim Bonus →</a>
      </div>
    </div>

    <!-- Navigation Header -->
    <header class="site-header">
      <div class="header-container">
        <a href="/" class="site-logo">Cyprus <span>Student Guide</span></a>
        
        <nav class="site-nav">
          <a href="/" class={current === 'home' ? 'active' : ''}>HOME</a>
          <a href="/about/" class={current === 'about' ? 'active' : ''}>ABOUT</a>
          <a href="/blog/" class={current === 'blog' ? 'active' : ''}>BLOG</a>

          <!-- Language Selector -->
          <div class="lang-dropdown">
            <select id="language-select" aria-label="Select Language">
              <option value="en" selected>🇬🇧 EN</option>
              <option value="bn">🇧🇩 BN</option>
              <option value="el">🇨🇾 EL</option>
            </select>
          </div>

          <!-- Theme Toggle Button -->
          <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
            <span class="sun-icon">☀️</span>
            <span class="moon-icon">🌙</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <p>&copy; 2026 CyprusStudentGuide.com - Built with authenticity for international students.</p>
      </div>
    </footer>

    <style is:global>
      :root {
        --bg-color: #f8fafc;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --card-bg: #ffffff;
        --border-color: rgba(0, 0, 0, 0.08);
        --primary-blue: #2563eb;
        --table-bg: #ffffff;
        --table-stripe: #f1f5f9;
      }

      html.dark {
        --bg-color: #0b1120;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --card-bg: #1e293b;
        --border-color: rgba(255, 255, 255, 0.1);
        --primary-blue: #38bdf8;
        --table-bg: #1e293b;
        --table-stripe: #182234;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        line-height: 1.7;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      /* Highlighted Sticky Top Promo Bar */
      .promo-top-bar {
        background: linear-gradient(90deg, #1e3a8a, #2563eb, #0284c7);
        color: #ffffff;
        padding: 0.6rem 1rem;
        font-size: 0.9rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      }

      .promo-inner {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.6rem;
        text-align: center;
      }

      .promo-tag {
        background: #facc15;
        color: #000000;
        font-size: 0.75rem;
        font-weight: 800;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        letter-spacing: 0.03em;
      }

      .promo-code {
        background: #0f172a;
        border: 1px dashed #facc15;
        color: #facc15;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        cursor: pointer;
        display: inline-block;
      }

      .promo-code:hover {
        background: #1e293b;
      }

      .promo-link {
        color: #ffffff;
        font-weight: 700;
        text-decoration: underline;
        margin-left: 0.25rem;
      }

      .promo-link:hover {
        color: #facc15;
      }

      /* Site Header & Navigation */
      .site-header {
        border-bottom: 1px solid var(--border-color);
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(8px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      html.dark .site-header {
        background: rgba(11, 17, 32, 0.9);
      }

      .header-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0.85rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .site-logo {
        font-size: 1.35rem;
        font-weight: 800;
        text-decoration: none;
        color: var(--text-main);
      }

      .site-logo span {
        color: var(--primary-blue);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .site-nav a {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.2s ease;
      }

      .site-nav a:hover,
      .site-nav a.active {
        color: var(--primary-blue);
      }

      .lang-dropdown select {
        background: rgba(150, 150, 150, 0.12);
        color: inherit;
        border: 1px solid var(--border-color);
        padding: 0.3rem 0.5rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        outline: none;
      }

      .theme-btn {
        background: rgba(150, 150, 150, 0.12);
        border: 1px solid var(--border-color);
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        color: inherit;
      }

      html.dark .sun-icon { display: inline; }
      html.dark .moon-icon { display: none; }
      html:not(.dark) .sun-icon { display: none; }
      html:not(.dark) .moon-icon { display: inline; }

      /* Global Markdown Article & Table Styling */
      .main-content {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }

      .main-content h1 {
        font-size: 2.25rem;
        line-height: 1.3;
        margin-bottom: 1rem;
      }

      .main-content h2 {
        font-size: 1.6rem;
        margin-top: 2.5rem;
        margin-bottom: 0.85rem;
        color: var(--primary-blue);
      }

      .main-content h3 {
        font-size: 1.25rem;
        margin-top: 1.75rem;
        margin-bottom: 0.65rem;
      }

      .main-content p {
        margin-bottom: 1.25rem;
        font-size: 1.05rem;
      }

      .main-content ul, .main-content ol {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }

      .main-content li {
        margin-bottom: 0.5rem;
        font-size: 1.02rem;
      }

      .main-content hr {
        border: 0;
        height: 1px;
        background: var(--border-color);
        margin: 2.5rem 0;
      }

      /* Clean Markdown Tables */
      .main-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.75rem 0;
        background: var(--table-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        font-size: 0.95rem;
      }

      .main-content th {
        background: rgba(37, 99, 235, 0.12);
        color: var(--primary-blue);
        text-align: left;
        padding: 0.85rem 1rem;
        font-weight: 700;
        border-bottom: 2px solid var(--border-color);
      }

      .main-content td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--border-color);
      }

      .main-content tr:nth-child(even) {
        background-color: var(--table-stripe);
      }

      .main-content blockquote {
        border-left: 4px solid var(--primary-blue);
        background: rgba(37, 99, 235, 0.06);
        margin: 1.5rem 0;
        padding: 1rem 1.25rem;
        border-radius: 0 8px 8px 0;
      }

      .site-footer {
        border-top: 1px solid var(--border-color);
        padding: 2.5rem 1rem;
        text-align: center;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 4rem;
      }

      @media (max-width: 768px) {
        .main-content table {
          display: block;
          overflow-x: auto;
          white-space: nowrap;
        }
      }
    </style>

    <script is:inline>
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          document.documentElement.classList.toggle('dark');
          const isDark = document.documentElement.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      const promoBtn = document.getElementById('promo-code-btn');
      if (promoBtn) {
        promoBtn.addEventListener('click', () => {
          navigator.clipboard.writeText('MDSAIDUR240');
          const orig = promoBtn.innerText;
          promoBtn.innerText = 'COPIED!';
          setTimeout(() => {
            promoBtn.innerText = orig;
          }, 2000);
        });
      }
    </script>
  </body>
</html>
