---
import DisclaimerNotice from '../components/DisclaimerNotice.astro';

export interface Props {
  title?: string;
  description?: string;
  permalink?: string;
  current?: string;
  image?: string;
  hideDisclaimer?: boolean;
}

const {
  title = "Cyprus Student Guide - Complete Guide for International Students in Cyprus",
  description = "Complete guide for international students in Cyprus covering study, jobs, student visa, living costs, and life in North and South Cyprus.",
  permalink = "https://cyprusstudentguide.com",
  current = "",
  image = "/assets/banner.png",
  hideDisclaimer = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://cyprusstudentguide.com').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <!-- Top Bar: Remittance / Promo Announcement -->
    <aside class="top-announcement-bar notranslate">
      <div class="top-announcement-inner">
        <span>⚡ Send money from Cyprus with <strong>0% fee</strong>! Use Code: <strong>MDSAIDUR240</strong></span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="btn-top-claim">Claim €10 Bonus ➔</a>
      </div>
    </aside>

    <!-- Site Header -->
    <header class="site-header">
      <nav class="nav-container notranslate">
        <a href="/" class="logo">
          <span class="logo-badge">CY</span>
          <span class="logo-text">Cyprus Student Guide</span>
        </a>

        <div class="nav-menu">
          <a href="/" class={current === "home" ? "nav-link active" : "nav-link"}>Home</a>
          <a href="/guides/" class={current === "guides" ? "nav-link active" : "nav-link"}>Guides</a>
          <a href="/calculator/" class={current === "calculator" ? "nav-link active" : "nav-link"}>📊 Budget</a>
          <a href="/shift-tracker/" class={current === "tracker" ? "nav-link active" : "nav-link"}>⏱️ Work Tracker</a>
          <a href="/about/" class={current === "about" ? "nav-link active" : "nav-link"}>About</a>
        </div>

        <div class="nav-actions">
          <!-- Language Selector -->
          <div class="lang-selector">
            <span class="lang-icon">🇬🇧 EN ▾</span>
          </div>

          <!-- Theme Toggle -->
          <button type="button" id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle Dark Mode">
            🌙
          </button>
        </div>
      </nav>
    </header>

    <!-- Main Page Content Slot -->
    <main class="main-wrapper">
      <slot />

      <!-- Global Legal Disclaimer Component -->
      {!hideDisclaimer && current !== "disclaimer" && (
        <div class="site-disclaimer-wrapper">
          <DisclaimerNotice />
        </div>
      )}
    </main>

    <!-- Site Footer -->
    <footer class="site-footer notranslate">
      <div class="footer-inner">
        <div class="footer-columns">
          <div class="footer-col brand-col">
            <div class="footer-logo">
              <span class="logo-badge">CY</span>
              <strong>Cyprus Student Guide</strong>
            </div>
            <p class="footer-tagline">
              Comprehensive and verified guides, cost calculators, shift splitters, and living advice for international students in the Republic of Cyprus.
            </p>
          </div>

          <div class="footer-col">
            <h4>Essential Tools</h4>
            <ul>
              <li><a href="/shift-tracker/">🛵 Delivery Shift & Wage Tracker</a></li>
              <li><a href="/calculator/">📊 Student Budget Calculator</a></li>
              <li><a href="/guides/">📚 All Student Guides</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Company & Support</h4>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact Support</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Legal & Policy</h4>
            <ul>
              <li><a href="/disclaimer/">Legal Disclaimer</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Service</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom-bar">
          <p>© {new Date().getFullYear()} Cyprus Student Guide (cyprusstudentguide.com). All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Base Variables */
  :root {
    --primary-blue: #2563eb;
    --primary-glow: rgba(37, 99, 235, 0.15);
    --text-main: #1e293b;
    --text-muted: #64748b;
    --bg-color: #f8fafc;
    --card-bg: #ffffff;
    --card-border: #e2e8f0;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  html.dark {
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --bg-color: #0b0f19;
    --card-bg: #111827;
    --card-border: #1f2937;
  }

  body {
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* Top Bar */
  .top-announcement-bar {
    background: #0f172a;
    color: #f8fafc;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid #1e293b;
  }
  .top-announcement-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .btn-top-claim {
    background: #facc15;
    color: #0f172a;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.74rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }

  /* Header */
  .site-header {
    background: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-main);
    font-weight: 800;
  }
  .logo-badge {
    background: var(--primary-blue);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
  }
  .logo-text {
    font-size: 1.05rem;
    font-weight: 800;
  }

  .nav-menu {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .nav-link {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 700;
    font-size: 0.88rem;
    transition: color 0.15s ease;
  }
  .nav-link:hover, .nav-link.active {
    color: var(--primary-blue);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang-selector {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
  }
  .theme-toggle-btn {
    background: transparent;
    border: none;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.2rem;
  }

  /* Main Wrapper */
  .main-wrapper {
    flex: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
    box-sizing: border-box;
  }
  .site-disclaimer-wrapper {
    max-width: 980px;
    margin: 0 auto;
  }

  /* Footer */
  .site-footer {
    background: var(--card-bg);
    border-top: 1px solid var(--card-border);
    padding: 3rem 1rem 1.5rem;
    margin-top: auto;
  }
  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }
  .footer-col h4 {
    margin: 0 0 0.75rem;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--text-main);
  }
  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .footer-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.84rem;
    font-weight: 600;
  }
  .footer-col a:hover {
    color: var(--primary-blue);
  }
  .footer-bottom-bar {
    border-top: 1px solid var(--card-border);
    padding-top: 1.25rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 820px) {
    .footer-columns { grid-template-columns: 1fr; gap: 1.5rem; }
    .nav-menu { gap: 0.75rem; font-size: 0.8rem; }
    .top-announcement-inner { justify-content: center; text-align: center; }
  }
</style>
