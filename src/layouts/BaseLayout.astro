---
import DisclaimerNotice from '../components/DisclaimerNotice.astro';

export interface Props {
  title: string;
  description: string;
  permalink: string;
  current?: string;
  hideDisclaimer?: boolean;
}

const { title, description, permalink, current = '', hideDisclaimer = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={permalink} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#2563eb" />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4089174887676363" crossorigin="anonymous"></script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cyprus Student Guide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={permalink} />
    <meta property="og:image" content="https://cyprusstudentguide.com/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet" />

    <slot name="head" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body>
    <div class="csg-announcement-bar notranslate">
      <span>🎁 <strong>TAPTAP SEND BONUS:</strong> Send money from Cyprus with 0% fee! Code: <code>MDSAIDUR240</code></span>
      <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/">Claim €10 Bonus ➔</a>
    </div>

    <header class="csg-header">
      <div class="csg-container csg-nav-inner">
        <a href="/" class="csg-brand notranslate">
          <span class="csg-logo-badge">CY</span>
          <span class="csg-brand-text">Cyprus <span>Student Guide</span></span>
        </a>

        <nav class="csg-nav-links notranslate">
          <a href="/" class={current === 'home' ? 'active' : ''}>Home</a>
          <a href="/blog/" class={current === 'guides' ? 'active' : ''}>Guides</a>
          <a href="/pink-slip-tracker/" class={current === 'tracker' ? 'active' : ''}>📋 Pink Slip</a>
          <a href="/calculator/" class={current === 'calculator' ? 'active' : ''}>💶 Budget</a>
          <a href="/shift-tracker/" class={current === 'shift' ? 'active' : ''}>⏱️ Work Tracker</a>
          <a href="/about/" class={current === 'about' ? 'active' : ''}>About</a>
        </nav>

        <div class="csg-nav-actions notranslate">
          <div id="nav-auth-container" class="nav-auth-wrap">
            <a href="/profile/" id="nav-login-btn" class="nav-btn-signin" title="Sign in with Google">
              👤 Sign In
            </a>
            <a href="/profile/" id="nav-user-avatar-btn" class="nav-user-avatar" style="display: none;" title="My Student Passport">
              <img id="nav-user-avatar-img" src="" alt="Profile" />
            </a>
          </div>

          <div class="csg-lang-wrapper">
            <select id="language-switcher" aria-label="Select Language" class="csg-lang-select">
              <option value="en">🇬🇧 EN</option>
              <option value="bn">🇧🇩 BN</option>
              <option value="el">🇨🇾 EL</option>
              <option value="hi">🇮🇳 HI</option>
            </select>
          </div>

          <button id="theme-toggle" type="button" aria-label="Toggle Dark Mode" class="csg-theme-btn">
            🌙
          </button>

          <button id="mobile-menu-toggle" type="button" aria-label="Toggle Navigation Menu" class="csg-hamburger-btn">
            <span class="hamburger-icon">☰</span>
          </button>
        </div>
      </div>

      <div id="mobile-nav-drawer" class="csg-mobile-drawer notranslate" style="display: none;">
        <nav class="csg-mobile-links">
          <a href="/profile/" class={current === 'profile' ? 'active' : ''}>👤 Student Passport & Profile</a>
          <a href="/" class={current === 'home' ? 'active' : ''}>🏠 Home</a>
          <a href="/blog/" class={current === 'guides' ? 'active' : ''}>📚 All Guides</a>
          <a href="/pink-slip-tracker/" class={current === 'tracker' ? 'active' : ''}>📋 Pink Slip Tracker</a>
          <a href="/calculator/" class={current === 'calculator' ? 'active' : ''}>💶 Budget Calculator</a>
          <a href="/shift-tracker/" class={current === 'shift' ? 'active' : ''}>⏱️ Shift Work Tracker</a>
          <a href="/about/" class={current === 'about' ? 'active' : ''}>ℹ️ About Us</a>
          <a href="/contact/" class={current === 'contact' ? 'active' : ''}>✉️ Contact Support</a>
        </nav>
      </div>
    </header>

    <div id="google_translate_element" style="display:none;"></div>

    <main class="csg-main">
      <div class="csg-container">
        <slot />
        {!hideDisclaimer && current !== 'disclaimer' && (
          <DisclaimerNotice />
        )}
      </div>
    </main>

    <footer class="csg-footer notranslate">
      <div class="csg-container csg-footer-inner">
        <div class="csg-footer-brand">
          <div class="csg-brand">
            <span class="csg-logo-badge">CY</span>
            <span class="csg-brand-text">Cyprus <span>Student Guide</span></span>
          </div>
          <p>The definitive lifestyle, university, job tracking, and legal living handbook for international students in Cyprus.</p>
        </div>

        <div class="csg-footer-links-grid">
          <div class="csg-footer-col">
            <h4>Essential Tools</h4>
            <ul>
              <li><a href="/profile/">👤 Student Passport</a></li>
              <li><a href="/pink-slip-tracker/">📋 Pink Slip 90-Day Tracker</a></li>
              <li><a href="/shift-tracker/">🛵 Delivery Shift Splitter</a></li>
              <li><a href="/calculator/">💶 Cost of Living Calculator</a></li>
              <li><a href="/blog/">📚 All Student Guides</a></li>
            </ul>
          </div>
          <div class="csg-footer-col">
            <h4>Legal & Trust</h4>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/contact/">Contact Us</a></li>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/terms/">Terms of Service</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
            </ul>
          </div>
        </div>
      </div>

      <div class="csg-container csg-footer-bottom">
        <p>© 2026 Cyprus Student Guide. All rights reserved. Designed for international students.</p>
      </div>
    </footer>

    <script is:inline type="module">
      import('../lib/firebase.js').then(({ auth }) => {
        import('https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js').then(({ onAuthStateChanged }) => {
          const navLoginBtn = document.getElementById('nav-login-btn');
          const navAvatarBtn = document.getElementById('nav-user-avatar-btn');
          const navAvatarImg = document.getElementById('nav-user-avatar-img');

          onAuthStateChanged(auth, (user) => {
            if (user) {
              if (navLoginBtn) navLoginBtn.style.display = 'none';
              if (navAvatarBtn) navAvatarBtn.style.display = 'flex';
              if (navAvatarImg) navAvatarImg.src = user.photoURL || '/favicon.svg';
            } else {
              if (navLoginBtn) navLoginBtn.style.display = 'inline-flex';
              if (navAvatarBtn) navAvatarBtn.style.display = 'none';
            }
          });
        });
      }).catch((err) => {
        console.warn('Auth UI state skipped on build:', err);
      });
    </script>

    <script is:inline>
      const themeToggleBtn = document.getElementById('theme-toggle');
      if (themeToggleBtn) {
        const isDark = document.documentElement.classList.contains('dark');
        themeToggleBtn.innerText = isDark ? '☀️' : '🌙';

        themeToggleBtn.addEventListener('click', () => {
          const currentlyDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', currentlyDark ? 'dark' : 'light');
          themeToggleBtn.innerText = currentlyDark ? '☀️' : '🌙';
        });
      }

      const mobileToggleBtn = document.getElementById('mobile-menu-toggle');
      const mobileDrawer = document.getElementById('mobile-nav-drawer');
      if (mobileToggleBtn && mobileDrawer) {
        mobileToggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = mobileDrawer.style.display === 'block';
          mobileDrawer.style.display = isOpen ? 'none' : 'block';
          mobileToggleBtn.querySelector('.hamburger-icon').innerText = isOpen ? '☰' : '✕';
        });

        document.addEventListener('click', (e) => {
          if (!mobileDrawer.contains(e.target) && !mobileToggleBtn.contains(e.target)) {
            mobileDrawer.style.display = 'none';
            mobileToggleBtn.querySelector('.hamburger-icon').innerText = '☰';
          }
        });
      }

      function googleTranslateElementInit() {
        if (window.google && window.google.translate) {
          new window.google.translate.TranslateElement({
            pageLanguage: 'en',
            includedLanguages: 'en,bn,el,hi',
            autoDisplay: false
          }, 'google_translate_element');
        }
      }

      (function() {
        const gtScript = document.createElement('script');
        gtScript.type = 'text/javascript';
        gtScript.async = true;
        gtScript.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
        document.head.appendChild(gtScript);
      })();

      const langSwitcher = document.getElementById('language-switcher');
      if (langSwitcher) {
        const match = document.cookie.match(/(^|;) ?googtrans=([^;]*)(;|$)/);
        if (match) {
          const langCode = match[2].split('/')[2];
          if (langCode) langSwitcher.value = langCode;
        }

        langSwitcher.addEventListener('change', () => {
          const lang = langSwitcher.value;
          const host = window.location.hostname;
          const domain = host.includes('.') ? host.substring(host.lastIndexOf('.', host.lastIndexOf('.') - 1) + 1) : host;

          if (lang === 'en') {
            document.cookie = `googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=${domain};`;
            document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
          } else {
            document.cookie = `googtrans=/en/${lang}; path=/; domain=${domain};`;
            document.cookie = `googtrans=/en/${lang}; path=/;`;
          }
          window.location.reload();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #f8fafc;
    --card-bg: #ffffff;
    --card-border: #e2e8f0;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --primary-blue: #2563eb;
    --primary-blue-hover: #1d4ed8;
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  html.dark {
    --bg-color: #0b0f19;
    --card-bg: #111827;
    --card-border: #1f2937;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --primary-blue: #3b82f6;
    --primary-blue-hover: #60a5fa;
  }

  *, *:before, *:after { box-sizing: border-box; margin: 0; padding: 0; }
  
  html, body {
    max-width: 100vw !important;
    overflow-x: hidden !important;
  }

  body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: var(--font-sans);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .csg-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1.25rem;
    width: 100%;
    box-sizing: border-box;
  }

  .csg-announcement-bar {
    background: #0f172a;
    color: #f8fafc;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    border-bottom: 1px solid #1e293b;
    text-align: center;
  }
  .csg-announcement-bar code {
    background: #1e293b;
    color: #fbbf24;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }
  .csg-announcement-bar a {
    color: #60a5fa;
    text-decoration: none;
    font-weight: 800;
  }
  .csg-announcement-bar a:hover { text-decoration: underline; }

  .csg-header {
    background: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }
  
  .csg-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 60px;
    gap: 0.5rem;
    width: 100%;
  }

  .csg-brand {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--text-main);
    flex-shrink: 1;
    min-width: 0;
  }
  .csg-logo-badge {
    background: linear-gradient(135deg, #2563eb, #0284c7);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 900;
    padding: 0.28rem 0.5rem;
    border-radius: 7px;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
    flex-shrink: 0;
  }
  .csg-brand-text {
    font-size: clamp(0.85rem, 3.4vw, 1.15rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .csg-brand-text span { color: var(--primary-blue); }

  .csg-nav-links {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }
  .csg-nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-weight: 700;
    transition: color 0.15s ease;
  }
  .csg-nav-links a:hover,
  .csg-nav-links a.active {
    color: var(--primary-blue);
  }

  .csg-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .nav-btn-signin {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.32rem 0.65rem;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .nav-btn-signin:hover {
    background: var(--primary-blue);
    color: #ffffff;
  }
  .nav-user-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }
  .nav-user-avatar img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--primary-blue);
    object-fit: cover;
  }

  .csg-lang-select {
    background: rgba(150, 150, 150, 0.1);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 0.3rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    outline: none;
    font-family: var(--font-sans);
  }

  .csg-theme-btn {
    background: rgba(150, 150, 150, 0.1);
    border: 1px solid var(--card-border);
    font-size: 0.9rem;
    padding: 0.3rem 0.45rem;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .csg-hamburger-btn {
    display: none;
    background: rgba(150, 150, 150, 0.1);
    border: 1px solid var(--card-border);
    font-size: 1rem;
    padding: 0.3rem 0.48rem;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text-main);
  }

  .csg-mobile-drawer {
    border-top: 1px solid var(--card-border);
    background: var(--card-bg);
    padding: 1rem 1.25rem 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }
  .csg-mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .csg-mobile-links a {
    text-decoration: none;
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.4rem 0.2rem;
    border-bottom: 1px dashed var(--card-border);
  }
  .csg-mobile-links a.active {
    color: var(--primary-blue);
  }

  .csg-main {
    flex: 1;
    padding: 2rem 0 3rem;
  }

  .csg-footer {
    background: var(--card-bg);
    border-top: 1px solid var(--card-border);
    padding: 3.5rem 0 1.5rem;
    margin-top: auto;
  }
  .csg-footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .csg-footer-brand { max-width: 380px; }
  .csg-footer-brand p {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin-top: 0.85rem;
    line-height: 1.5;
  }
  .csg-footer-links-grid {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }
  .csg-footer-col h4 {
    font-size: 0.95rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--text-main);
  }
  .csg-footer-col ul { list-style: none; }
  .csg-footer-col li { margin-bottom: 0.5rem; }
  .csg-footer-col a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
    transition: color 0.15s;
  }
  .csg-footer-col a:hover { color: var(--primary-blue); }

  .csg-footer-bottom {
    border-top: 1px dashed var(--card-border);
    padding-top: 1.5rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .goog-te-banner-frame,
  .goog-te-gadget,
  #google_translate_element {
    display: none !important;
    visibility: hidden !important;
  }
  body { top: 0px !important; }

  @media (max-width: 860px) {
    .csg-nav-links { display: none; }
    .csg-hamburger-btn { display: flex; align-items: center; justify-content: center; }
    .csg-footer-links-grid { gap: 2rem; }
  }

  @media (max-width: 480px) {
    .csg-container { padding: 0 0.75rem; }
    .csg-nav-inner { min-height: 56px; gap: 0.25rem; }
    .csg-logo-badge { font-size: 0.78rem; padding: 0.2rem 0.4rem; }
    .csg-lang-select { font-size: 0.72rem; padding: 0.22rem 0.25rem; }
    .csg-theme-btn { padding: 0.22rem 0.4rem; font-size: 0.82rem; }
    .csg-hamburger-btn { padding: 0.22rem 0.42rem; font-size: 0.9rem; }
    .nav-btn-signin { font-size: 0.72rem; padding: 0.25rem 0.45rem; }
  }
</style>
