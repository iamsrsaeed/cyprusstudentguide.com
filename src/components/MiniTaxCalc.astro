---
// src/components/MiniTaxCalc.astro
// Interactive In-Article Calculator for high retention and zero layout shift
---

<div class="interactive-calc-card notranslate">
  <div class="calc-header">
    <div class="calc-badge">⚡ LIVE INTERACTIVE WIDGET</div>
    <h3 class="calc-title">Cyprus Student Net Wage & GeSY Estimator</h3>
    <p class="calc-sub">Calculate your official take-home pay under the legal 20h/week student limit.</p>
  </div>

  <div class="calc-body">
    <div class="calc-inputs-grid">
      <div class="calc-field">
        <label for="hourly-wage">Hourly Wage (€ / hr)</label>
        <div class="input-wrap">
          <span class="currency-symbol">€</span>
          <input type="number" id="hourly-wage" value="6.50" step="0.25" min="4" max="25" />
        </div>
      </div>

      <div class="calc-field">
        <label for="weekly-hours">Weekly Hours (Max 20h Legal)</label>
        <div class="input-wrap">
          <input type="number" id="weekly-hours" value="20" min="1" max="38" />
          <span class="hours-unit">hrs/wk</span>
        </div>
      </div>
    </div>

    <!-- Sliders for instant engagement -->
    <div class="slider-row">
      <input type="range" id="hours-slider" min="1" max="20" value="20" class="styled-slider" />
    </div>

    <!-- Realtime Live Payout Matrix -->
    <div class="calc-results-matrix">
      <div class="result-tile">
        <span class="tile-label">Gross Monthly Income</span>
        <span class="tile-val gross-val" id="res-gross">€563.33</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">Social Insurance (8.3%)</span>
        <span class="tile-val deduction-val" id="res-si">-€46.76</span>
      </div>
      <div class="result-tile">
        <span class="tile-label">GeSY Healthcare (2.65%)</span>
        <span class="tile-val deduction-val" id="res-gesy">-€14.93</span>
      </div>
      <div class="result-tile highlight-net">
        <span class="tile-label">Net Take-Home Pay</span>
        <span class="tile-val net-val" id="res-net">€501.64</span>
      </div>
    </div>

    <div class="calc-footer-action">
      <span class="footer-note">ℹ️ Deductions are legally enforced under Republic of Cyprus employment law.</span>
      <a href="/shift-tracker/" class="calc-deep-link">Open Full Shift & Fuel Split Tracker ➔</a>
    </div>
  </div>
</div>

<script is:inline>
  function setupMiniTaxCalc() {
    const wageInput = document.getElementById('hourly-wage');
    const hoursInput = document.getElementById('weekly-hours');
    const slider = document.getElementById('hours-slider');

    const resGross = document.getElementById('res-gross');
    const resSi = document.getElementById('res-si');
    const resGesy = document.getElementById('res-gesy');
    const resNet = document.getElementById('res-net');

    if (!wageInput || !hoursInput || !slider) return;

    function recalculate() {
      const wage = parseFloat(wageInput.value) || 0;
      const hours = parseFloat(hoursInput.value) || 0;

      // 52 weeks / 12 months = ~4.333 weeks per month
      const monthlyGross = (wage * hours * 52) / 12;
      const socialInsurance = monthlyGross * 0.083;
      const gesy = monthlyGross * 0.0265;
      const net = monthlyGross - socialInsurance - gesy;

      if (resGross) resGross.innerText = `€${monthlyGross.toFixed(2)}`;
      if (resSi) resSi.innerText = `-€${socialInsurance.toFixed(2)}`;
      if (resGesy) resGesy.innerText = `-€${gesy.toFixed(2)}`;
      if (resNet) resNet.innerText = `€${net.toFixed(2)}`;
    }

    hoursInput.addEventListener('input', (e) => {
      slider.value = e.target.value;
      recalculate();
    });

    slider.addEventListener('input', (e) => {
      hoursInput.value = e.target.value;
      recalculate();
    });

    wageInput.addEventListener('input', recalculate);
    recalculate();
  }

  // Run on first load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMiniTaxCalc);
  } else {
    setupMiniTaxCalc();
  }
</script>

<style>
  .interactive-calc-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    padding: 1.5rem;
    margin: 2.5rem 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .calc-header {
    border-bottom: 1px solid #1e293b;
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
  }

  .calc-badge {
    display: inline-block;
    background: rgba(37, 99, 235, 0.15);
    color: #38bdf8;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    margin-bottom: 0.4rem;
  }

  .calc-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.25rem 0;
  }

  .calc-sub {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0;
  }

  .calc-inputs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .calc-field label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #cbd5e1;
    margin-bottom: 0.35rem;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.4rem 0.75rem;
  }

  .currency-symbol, .hours-unit {
    color: #94a3b8;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .input-wrap input {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 800;
    width: 100%;
    outline: none;
    padding: 0 0.35rem;
  }

  .slider-row {
    margin-bottom: 1.25rem;
  }

  .styled-slider {
    width: 100%;
    height: 6px;
    background: #334155;
    border-radius: 4px;
    outline: none;
    accent-color: #2563eb;
    cursor: pointer;
  }

  .calc-results-matrix {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1.25rem;
  }

  .result-tile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tile-label {
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .tile-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
  }

  .deduction-val {
    color: #f87171;
  }

  .highlight-net {
    border-left: 2px solid #10b981;
    padding-left: 0.6rem;
  }

  .highlight-net .tile-val {
    color: #34d399;
    font-size: 1.2rem;
  }

  .calc-footer-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-note {
    font-size: 0.76rem;
    color: #64748b;
  }

  .calc-deep-link {
    font-size: 0.84rem;
    font-weight: 800;
    color: #38bdf8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .calc-deep-link:hover {
    color: #60a5fa;
    text-decoration: underline;
  }
</style>
