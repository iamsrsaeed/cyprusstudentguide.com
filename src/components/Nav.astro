---
import ThemeToggleButton from './ThemeToggleButton.svelte';
const { current = '' } = Astro.props;
---

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 0.5rem 0;
    margin-bottom: 1rem;
    font-family: var(--font-family-sans);
    font-weight: 700;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    padding: 6px 4px;
    font-size: 0.9rem;
    position: relative;
    opacity: 0.75;
  }

  .nav-links a.selected {
    opacity: 1;
    color: var(--primary-color, #2563eb);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-select-wrapper select {
    background: rgba(150, 150, 150, 0.1);
    color: inherit;
    border: 1px solid rgba(150, 150, 150, 0.25);
    border-radius: 6px;
    padding: 0.25rem 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
  }

  .theme-toggle-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.theme-toggle) {
    display: flex !important;
    align-items: center;
    cursor: pointer;
  }

  /* Mobile Responsive Fix */
  @media screen and (max-width: 600px) {
    nav {
      justify-content: space-between;
      gap: 0.5rem;
    }
    .nav-links {
      gap: 0.5rem;
    }
    .nav-links a {
      font-size: 0.8rem;
      padding: 4px 2px;
    }
    .lang-select-wrapper select {
      padding: 0.2rem 0.3rem;
      font-size: 0.75rem;
    }
  }

  /* Hide Google Translate raw elements */
  :global(.goog-te-banner-frame),
  :global(.goog-te-gadget),
  :global(#google_translate_element) {
    display: none !important;
    visibility: hidden !important;
  }

  :global(body) {
    top: 0px !important;
  }
</style>

<nav>
  <div class="nav-links">
    <a class={current === "" ? "selected" : ""} href='/'>home</a>
    <a class={current === "about" ? "selected" : ""} href='/about'>about</a>
    <a class={current === "blog" ? "selected" : ""} href='/blog'>blog</a>
  </div>

  <div class="nav-actions">
    <div class="lang-select-wrapper">
      <select id="language-switcher" aria-label="Select Language">
        <option value="en">🇬🇧 EN</option>
        <option value="bn">🇧🇩 BN</option>
        <option value="el">🇨🇾 EL</option>
        <option value="hi">🇮🇳 HI</option>
      </select>
    </div>

    <div class="theme-toggle-container">
      <ThemeToggleButton client:load />
    </div>
  </div>
</nav>

<div id="google_translate_element" style="display:none;"></div>
