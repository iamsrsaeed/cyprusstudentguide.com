---
export interface Props {
  customText?: string;
}

const { customText } = Astro.props;
---

<div class="csg-disclaimer-box notranslate">
  <div class="csg-disclaimer-icon">⚠️</div>
  <div class="csg-disclaimer-body">
    <h4>Official Regulation & Pricing Notice</h4>
    <p>
      {customText || "Regulations, non-EU student work conditions (20h/week limit), minimum wages, and transport/living costs in Cyprus are subject to periodic changes by relevant government authorities and providers. Always confirm critical updates through official ministries or service counters."}
    </p>
    <a href="/disclaimer/" class="csg-disclaimer-link">Read Full Legal Disclosure ➔</a>
  </div>
</div>

<style>
  .csg-disclaimer-box {
    background: rgba(245, 158, 11, 0.06);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-left: 4px solid #f59e0b;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin: 2rem 0 1.5rem;
  }
  .csg-disclaimer-icon {
    font-size: 1.25rem;
    line-height: 1;
    margin-top: 0.15rem;
  }
  .csg-disclaimer-body h4 {
    margin: 0 0 0.25rem;
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-main);
  }
  .csg-disclaimer-body p {
    margin: 0 0 0.45rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .csg-disclaimer-link {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
