---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Student Passport & Profile Settings | Cyprus Student Guide';
const description = 'Manage your Cyprus student profile, customize tools settings, and sync shifts and checklists across all devices.';
const permalink = 'https://cyprusstudentguide.com/profile/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="profile">
  <div class="profile-container notranslate">
    
    <!-- 1. Unauthenticated Gate Card -->
    <div id="auth-gate" class="auth-card">
      <div class="auth-icon">🔐</div>
      <h1>Student Passport & Cloud Sync</h1>
      <p>Sign in with your Google account to customize your student profile, backup delivery shift logs, and sync your 90-day Pink Slip timeline across devices.</p>
      
      <button type="button" id="btn-login-gate" class="btn-google-primary">
        <svg width="18" height="18" viewBox="0 0 18 18"><path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/><path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.258c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/><path fill="#FBBC05" d="M3.964 10.707c-.18-.54-.282-1.117-.282-1.707 0-.59.102-1.167.282-1.707V4.961H.957C.347 6.173 0 7.548 0 9s.347 2.827.957 4.039l3.007-2.332z"/><path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.961L3.964 7.293C4.672 5.166 6.656 3.58 9 3.58z"/></svg>
        Sign In with Google
      </button>
      <div id="login-error-msg" style="color: #ef4444; font-size: 0.85rem; margin-top: 1rem; display: none;"></div>
    </div>

    <!-- 2. Authenticated Profile Dashboard -->
    <div id="profile-dashboard" class="profile-dashboard-view">
      <div class="privacy-trust-bar">
        <span>🔒 <strong>Private & Client-Scoped:</strong> Your financial data, shift earnings, and arrival deadlines are private to your Google ID. We never collect or monetize personal inputs.</span>
      </div>

      <header class="profile-header-card">
        <div class="profile-avatar-wrap">
          <img id="user-avatar-img" src="/favicon.svg" alt="Student Avatar" class="profile-avatar" />
          <label class="avatar-edit-badge" title="Upload custom profile photo">
            📷
            <input type="file" id="avatar-file-input" accept="image/*" style="display: none;" />
          </label>
        </div>
        <div class="profile-header-info">
          <div class="badge-row">
            <span class="verified-pill">🎓 Verified Student Member</span>
            <span id="sync-status-pill" class="sync-pill">⚡ Auto-Linked across all Tools</span>
          </div>
          <h1 id="user-display-name">Student Member</h1>
          <p id="user-email-text" class="email-muted">loading...</p>
        </div>
        <div class="profile-header-actions">
          <button type="button" id="btn-logout" class="btn-logout">Logout</button>
        </div>
      </header>

      <form id="profile-form" class="customization-grid">
        <div class="settings-card">
          <div class="card-title-row">
            <h2>📍 Student Identity & Legal Migration</h2>
            <span class="auto-badge">⚡ Auto-syncs to Pink Slip Tracker</span>
          </div>
          <p class="card-desc">Personalize your student identity. Setting your arrival date here will automatically sync your 90-day compliance checklist.</p>
          
          <div class="form-group">
            <label for="input-name">Display Name</label>
            <input type="text" id="input-name" placeholder="Enter your full name" />
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="select-city">Current City in Cyprus</label>
              <select id="select-city">
                <option value="Limassol">Limassol (Lemesos)</option>
                <option value="Nicosia">Nicosia (Lefkosia)</option>
                <option value="Larnaca">Larnaca</option>
                <option value="Paphos">Paphos</option>
              </select>
            </div>

            <div class="form-group">
              <label for="input-institution">University / College</label>
              <input type="text" id="input-institution" placeholder="e.g. UCLan Cyprus, Frederick, CDA, CTL" />
            </div>
          </div>

          <div class="form-group">
            <label for="input-arrival">Cyprus Entry / Airport Arrival Date</label>
            <input type="date" id="input-arrival" />
            <small>Used across the website to calculate your 90-day Pink Slip countdown seamlessly.</small>
          </div>
        </div>

        <div class="settings-card">
          <div class="card-title-row">
            <h2>💼 Work, Delivery & Budget Defaults</h2>
            <span class="auto-badge">⚡ Auto-syncs to Work Tracker & Budget</span>
          </div>
          <p class="card-desc">Pre-set your default numbers so you never have to re-type them when logging delivery shifts or monthly living costs.</p>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="input-rate">Default Base Hourly Rate (€)</label>
              <input type="number" step="0.1" id="input-rate" placeholder="6.50" />
            </div>

            <div class="form-group">
              <label for="input-commission">Fleet Agency Commission Split (%)</label>
              <input type="number" step="0.5" id="input-commission" placeholder="18" />
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="input-rent">Monthly Accommodation Budget (€)</label>
              <input type="number" id="input-rent" placeholder="450" />
            </div>

            <div class="form-group">
              <label for="input-grocery">Monthly Groceries Budget (€)</label>
              <input type="number" id="input-grocery" placeholder="200" />
            </div>
          </div>
        </div>

        <div class="form-actions-bar">
          <button type="submit" id="btn-save-profile" class="btn-save-primary">Save Profile & Global Sync</button>
          <span id="save-toast" class="save-toast" style="display: none;">✅ Profile & Tool Defaults Saved to Cloud!</span>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function() {
    try {
      const cachedAvatar = localStorage.getItem('csg_cached_user_avatar');
      const cachedName = localStorage.getItem('csg_cached_user_name');
      const cachedEmail = localStorage.getItem('csg_cached_user_email');

      if (cachedAvatar) {
        const img = document.getElementById('user-avatar-img');
        if (img) img.src = cachedAvatar;
      }
      if (cachedName) {
        const nameEl = document.getElementById('user-display-name');
        const inputName = document.getElementById('input-name');
        if (nameEl) nameEl.innerText = cachedName;
        if (inputName) inputName.value = cachedName;
      }
      if (cachedEmail) {
        const emailEl = document.getElementById('user-email-text');
        if (emailEl) emailEl.innerText = cachedEmail;
      }
    } catch (e) {}
  })();
</script>

<script is:inline type="module">
  import { initializeApp, getApps, getApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import { 
    getAuth, 
    signInWithPopup, 
    GoogleAuthProvider, 
    signOut, 
    onAuthStateChanged 
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js";
  import { 
    getFirestore, 
    doc, 
    getDoc, 
    setDoc 
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBnLArPDFIG6Kr9OtkoCzhdFBHMbgzK8k0",
    authDomain: "cyprusstudentguidelogin.firebaseapp.com",
    projectId: "cyprusstudentguidelogin",
    storageBucket: "cyprusstudentguidelogin.firebasestorage.app",
    messagingSenderId: "215797465320",
    appId: "1:215797465320:web:afad34a9c5aa686772c95d",
    measurementId: "G-1RWQEC5L8D"
  };

  const app = getApps().length > 0 ? getApp() : initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);
  const provider = new GoogleAuthProvider();

  const btnLoginGate = document.getElementById('btn-login-gate');
  const btnLogout = document.getElementById('btn-logout');
  const profileForm = document.getElementById('profile-form');
  const saveToast = document.getElementById('save-toast');
  const loginErrorMsg = document.getElementById('login-error-msg');
  const avatarFileInput = document.getElementById('avatar-file-input');

  const userAvatarImg = document.getElementById('user-avatar-img');
  const userDisplayName = document.getElementById('user-display-name');
  const userEmailText = document.getElementById('user-email-text');
  
  const inputName = document.getElementById('input-name');
  const selectCity = document.getElementById('select-city');
  const inputInstitution = document.getElementById('input-institution');
  const inputArrival = document.getElementById('input-arrival');
  const inputRate = document.getElementById('input-rate');
  const inputCommission = document.getElementById('input-commission');
  const inputRent = document.getElementById('input-rent');
  const inputGrocery = document.getElementById('input-grocery');

  let currentUser = null;

  onAuthStateChanged(auth, async (user) => {
    if (user) {
      currentUser = user;
      document.documentElement.classList.add('user-is-logged-in');

      const photo = localStorage.getItem('csg_cached_user_avatar') || user.photoURL || '/favicon.svg';
      const name = user.displayName || 'Student Member';
      const email = user.email || '';

      if (userAvatarImg) userAvatarImg.src = photo;
      if (userDisplayName) userDisplayName.innerText = name;
      if (userEmailText) userEmailText.innerText = email;

      try {
        const userDocRef = doc(db, 'users', user.uid);
        const snap = await getDoc(userDocRef);
        if (snap.exists()) {
          const data = snap.data();
          const p = data.profile || {};
          const pref = data.preferences || {};

          if (inputName) inputName.value = p.displayName || name;
          if (selectCity) selectCity.value = p.city || 'Limassol';
          if (inputInstitution) inputInstitution.value = p.institution || '';
          if (inputArrival) inputArrival.value = p.arrivalDate || '';

          if (inputRate) inputRate.value = pref.defaultHourlyRate || 6.5;
          if (inputCommission) inputCommission.value = pref.fleetCommission || 18;
          if (inputRent) inputRent.value = pref.monthlyRentBudget || 450;
          if (inputGrocery) inputGrocery.value = pref.monthlyGroceryBudget || 200;

          if (p.photoURL) {
            localStorage.setItem('csg_cached_user_avatar', p.photoURL);
            if (userAvatarImg) userAvatarImg.src = p.photoURL;
          }

          if (p.arrivalDate) {
            localStorage.setItem('csg_user_arrival_date', p.arrivalDate);
          }
        }
      } catch (err) {
        console.error('Firestore read error:', err);
      }
    } else {
      currentUser = null;
      document.documentElement.classList.remove('user-is-logged-in');
      localStorage.removeItem('csg_cached_user_avatar');
      localStorage.removeItem('csg_cached_user_name');
      localStorage.removeItem('csg_cached_user_email');
    }
  });

  if (avatarFileInput) {
    avatarFileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const maxDim = 200;
          canvas.width = maxDim;
          canvas.height = maxDim;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, maxDim, maxDim);
          
          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
          if (userAvatarImg) userAvatarImg.src = compressedDataUrl;
          localStorage.setItem('csg_cached_user_avatar', compressedDataUrl);

          const navAvatarImg = document.getElementById('nav-user-avatar-img');
          if (navAvatarImg) navAvatarImg.src = compressedDataUrl;

          if (currentUser) {
            const userDocRef = doc(db, 'users', currentUser.uid);
            setDoc(userDocRef, { profile: { photoURL: compressedDataUrl } }, { merge: true });
          }
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });
  }

  // Pure Popup Trigger (Mobile & Desktop Compatible)
  if (btnLoginGate) {
    btnLoginGate.addEventListener('click', async () => {
      provider.setCustomParameters({ prompt: 'select_account' });
      try {
        await signInWithPopup(auth, provider);
      } catch (err) {
        console.error('Auth Popup Error:', err);
        if (err.code !== 'auth/popup-closed-by-user') {
          if (loginErrorMsg) {
            loginErrorMsg.innerText = 'Sign-in notice: ' + (err.message || 'Please check browser popup settings.');
            loginErrorMsg.style.display = 'block';
          }
        }
      }
    });
  }

  if (btnLogout) {
    btnLogout.addEventListener('click', async () => {
      localStorage.removeItem('csg_cached_user_avatar');
      localStorage.removeItem('csg_cached_user_name');
      localStorage.removeItem('csg_cached_user_email');
      document.documentElement.classList.remove('user-is-logged-in');
      await signOut(auth);
      window.location.reload();
    });
  }

  if (profileForm) {
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentUser) return;

      const btn = document.getElementById('btn-save-profile');
      if (btn) {
        btn.disabled = true;
        btn.innerText = 'Saving...';
      }

      try {
        const updatedName = inputName.value.trim() || currentUser.displayName;
        const arrivalVal = inputArrival.value;
        const rateVal = parseFloat(inputRate.value) || 6.5;
        const commVal = parseFloat(inputCommission.value) || 18;

        const userDocRef = doc(db, 'users', currentUser.uid);
        await setDoc(userDocRef, {
          profile: {
            displayName: updatedName,
            email: currentUser.email,
            city: selectCity.value,
            institution: inputInstitution.value.trim(),
            arrivalDate: arrivalVal
          },
          preferences: {
            defaultHourlyRate: rateVal,
            fleetCommission: commVal,
            monthlyRentBudget: parseFloat(inputRent.value) || 450,
            monthlyGroceryBudget: parseFloat(inputGrocery.value) || 200
          },
          updatedAt: new Date().toISOString()
        }, { merge: true });

        localStorage.setItem('csg_cached_user_name', updatedName);
        if (arrivalVal) localStorage.setItem('csg_user_arrival_date', arrivalVal);

        if (userDisplayName) userDisplayName.innerText = updatedName;

        if (saveToast) {
          saveToast.style.display = 'inline-block';
          setTimeout(() => { saveToast.style.display = 'none'; }, 3000);
        }
      } catch (err) {
        console.error('Save error:', err);
        alert('Failed to save. Check connection.');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerText = 'Save Profile & Global Sync';
        }
      }
    });
  }
</script>

<style>
  .profile-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 1rem 0.75rem 4rem;
    box-sizing: border-box;
    width: 100%;
  }

  #auth-gate { display: block; }
  #profile-dashboard { display: none; }

  html.user-is-logged-in #auth-gate { display: none !important; }
  html.user-is-logged-in #profile-dashboard { display: block !important; }

  .privacy-trust-bar {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: var(--text-main);
    font-size: 0.82rem;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    margin-bottom: 1.5rem;
    line-height: 1.45;
  }

  .auth-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    padding: 3rem 1.5rem;
    text-align: center;
    max-width: 520px;
    margin: 2rem auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }
  .auth-icon { font-size: 3rem; margin-bottom: 0.75rem; }
  .auth-card h1 { font-size: 1.6rem; font-weight: 900; margin: 0 0 0.6rem; color: var(--text-main); }
  .auth-card p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 1.75rem; }
  
  .btn-google-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    transition: background 0.15s, transform 0.15s;
    font-family: inherit;
  }
  .btn-google-primary:hover {
    background: #f9fafb;
    transform: translateY(-2px);
  }

  .profile-header-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(56, 189, 248, 0.03) 100%);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    padding: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .profile-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .profile-avatar {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    border: 3px solid var(--primary-blue);
    object-fit: cover;
    background: var(--card-bg);
    display: block;
  }
  .avatar-edit-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: var(--card-bg);
    border: 2px solid var(--primary-blue);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.85rem;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    transition: transform 0.15s;
  }
  .avatar-edit-badge:hover {
    transform: scale(1.1);
  }

  .profile-header-info {
    flex-grow: 1;
    min-width: 200px;
  }
  .badge-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }
  .verified-pill {
    background: var(--primary-blue);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .sync-pill {
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .profile-header-info h1 {
    font-size: 1.45rem;
    font-weight: 900;
    margin: 0 0 0.2rem;
    color: var(--text-main);
  }
  .email-muted {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }
  .btn-logout {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.15s;
    font-family: inherit;
  }
  .btn-logout:hover {
    background: #ef4444;
    color: #ffffff;
  }

  .customization-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .settings-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem;
  }
  .card-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .settings-card h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-main);
  }
  .auto-badge {
    background: rgba(37, 99, 235, 0.08);
    color: var(--primary-blue);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .card-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--text-main);
  }
  .form-group input,
  .form-group select {
    background: var(--card-bg);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    box-sizing: border-box;
    width: 100%;
  }
  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--primary-blue);
  }
  .form-group small {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .form-actions-bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 0.5rem;
    flex-wrap: wrap;
  }
  .btn-save-primary {
    background: var(--primary-blue);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.95rem;
    border: none;
    border-radius: 10px;
    padding: 0.85rem 1.75rem;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.15s;
  }
  .btn-save-primary:hover {
    background: var(--primary-blue-hover);
  }
  .save-toast {
    font-size: 0.9rem;
    font-weight: 700;
    color: #16a34a;
  }

  @media (max-width: 650px) {
    .profile-header-card {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
      padding: 1.5rem 1rem;
    }
    .badge-row { justify-content: center; }
    .form-grid-2 { grid-template-columns: 1fr; gap: 0; }
    .settings-card { padding: 1.25rem 1rem; }
    .btn-save-primary { width: 100%; }
  }
</style>
