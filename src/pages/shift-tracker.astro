<!-- Firebase Browser Bundle -->
<script is:inline type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import { getFirestore, doc, onSnapshot, setDoc } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";
  import { 
    getAuth, 
    setPersistence,
    indexedDBLocalPersistence,
    browserLocalPersistence,
    signInWithPopup, 
    GoogleAuthProvider, 
    signOut, 
    onAuthStateChanged 
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBnLArPDFIG6Kr9OtkoCzhdFBHMbgzK8k0",
    authDomain: "cyprusstudentguidelogin.firebaseapp.com",
    projectId: "cyprusstudentguidelogin",
    storageBucket: "cyprusstudentguidelogin.firebasestorage.app",
    messagingSenderId: "215797465320",
    appId: "1:215797465320:web:afad34a9c5aa686772c95d",
    measurementId: "G-1RWQEC5L8D"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // Multi-Device Persistence
  setPersistence(auth, indexedDBLocalPersistence).catch(() => {
    setPersistence(auth, browserLocalPersistence).catch(console.warn);
  });

  // Storage Keys
  const STORAGE_KEY_CURRENCY = 'csg_user_currency';
  const STORAGE_KEY_LEDGER = 'csg_daily_ledger_data';
  const STORAGE_KEY_SHIFTS = 'csg_student_shifts_data';
  const STORAGE_KEY_SESSIONS = 'csg_delivery_sessions_data';
  const STORAGE_KEY_CONFIG = 'csg_delivery_config_data';
  const STORAGE_KEY_EXPENSES = 'csg_delivery_custom_expenses_data';
  const STORAGE_KEY_ACTIVE_ROOM = 'csg_active_sync_room';

  // State
  let currentCurrency = '€';
  let currentTransType = 'expense';
  let currentActiveTab = 'view-delivery-sessions';
  let ledgerRecords = [];
  let shiftRecords = [];
  let deliverySessions = [];
  let deliveryCustomExpenses = [];
  let deliveryConfig = { fleetPercent: 18.0 };

  let activeSyncRoom = null;
  let currentUser = null;
  let unsubscribeSnapshot = null;
  let isReceivingRemoteUpdate = false;

  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const currentMonth = today.substring(0, 7);

    const sDate = document.getElementById('sess-date');
    if (sDate) sDate.value = today;

    const tDate = document.getElementById('trans-date');
    if (tDate) tDate.value = today;

    const shDate = document.getElementById('shift-date');
    if (shDate) shDate.value = today;

    const mFilter = document.getElementById('ledger-month-filter');
    if (mFilter) mFilter.value = currentMonth;

    const fStart = document.getElementById('filter-start-date');
    const fEnd = document.getElementById('filter-end-date');
    if (fStart) fStart.value = `${currentMonth}-01`;
    if (fEnd) fEnd.value = today;

    loadData();
    initCurrency();
    initTabs();
    initDeliverySessionsEngine();
    initLedgerEngine();
    initShiftsEngine();
    initBackupEngine();
    initIsolatedTabClearing();
    initRealtimeSyncHub();
    renderAll();

    const urlParams = new URLSearchParams(window.location.search);
    const roomParam = urlParams.get('room');
    if (roomParam) {
      connectToRoom(roomParam.toUpperCase());
    }
  });

  function loadData() {
    try {
      const c = localStorage.getItem(STORAGE_KEY_CURRENCY);
      if (c) currentCurrency = c;

      const l = localStorage.getItem(STORAGE_KEY_LEDGER);
      if (l) ledgerRecords = JSON.parse(l);

      const s = localStorage.getItem(STORAGE_KEY_SHIFTS);
      if (s) shiftRecords = JSON.parse(s);

      const ds = localStorage.getItem(STORAGE_KEY_SESSIONS);
      if (ds) deliverySessions = JSON.parse(ds);

      const exp = localStorage.getItem(STORAGE_KEY_EXPENSES);
      if (exp) deliveryCustomExpenses = JSON.parse(exp);

      const cfg = localStorage.getItem(STORAGE_KEY_CONFIG);
      if (cfg) deliveryConfig = JSON.parse(cfg);

      const room = localStorage.getItem(STORAGE_KEY_ACTIVE_ROOM);
      if (room) activeSyncRoom = room;
    } catch (e) {
      console.warn('Storage read error:', e);
    }
  }

  function saveData(pushToCloud = true) {
    localStorage.setItem(STORAGE_KEY_CURRENCY, currentCurrency);
    localStorage.setItem(STORAGE_KEY_LEDGER, JSON.stringify(ledgerRecords));
    localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shiftRecords));
    localStorage.setItem(STORAGE_KEY_SESSIONS, JSON.stringify(deliverySessions));
    localStorage.setItem(STORAGE_KEY_EXPENSES, JSON.stringify(deliveryCustomExpenses));
    localStorage.setItem(STORAGE_KEY_CONFIG, JSON.stringify(deliveryConfig));
    
    const txt = document.getElementById('save-status-text');
    if (txt) {
      txt.innerText = 'Saved ' + new Date().toLocaleTimeString();
      setTimeout(() => txt.innerText = 'Auto-saved to browser', 2500);
    }

    if (pushToCloud && !isReceivingRemoteUpdate) {
      syncStateToCloud();
    }
  }

  // ================= REALTIME CLOUD & AUTH ENGINE =================
  function initRealtimeSyncHub() {
    const modal = document.getElementById('room-sync-modal');
    const openModalBtn = document.getElementById('btn-open-room-modal');
    const closeModalBtn = document.getElementById('btn-close-modal');
    const createRoomBtn = document.getElementById('btn-create-room');
    const joinRoomBtn = document.getElementById('btn-join-room');
    const joinRoomInput = document.getElementById('join-room-input');
    const googleAuthBtn = document.getElementById('btn-google-auth');
    const disconnectBtn = document.getElementById('btn-disconnect-sync');

    if (openModalBtn) openModalBtn.addEventListener('click', () => modal.classList.add('active'));
    if (closeModalBtn) closeModalBtn.addEventListener('click', () => modal.classList.remove('active'));

    // Create Room
    if (createRoomBtn) {
      createRoomBtn.addEventListener('click', () => {
        const randCode = 'CY-' + Math.floor(1000 + Math.random() * 9000);
        modal.classList.remove('active');
        connectToRoom(randCode);
      });
    }

    // Join Room
    if (joinRoomBtn) {
      joinRoomBtn.addEventListener('click', () => {
        const code = joinRoomInput.value.trim().toUpperCase();
        if (!code || code.length < 4) {
          alert('Please enter a valid room code (e.g. CY-8824)');
          return;
        }
        modal.classList.remove('active');
        connectToRoom(code);
      });
    }

    // Google Sign-In
    if (googleAuthBtn) {
      googleAuthBtn.addEventListener('click', async () => {
        if (currentUser) return;
        provider.setCustomParameters({ prompt: 'select_account' });

        try {
          const res = await signInWithPopup(auth, provider);
          currentUser = res.user;
          setupUserCloudSync(currentUser.uid, currentUser.displayName || currentUser.email);
        } catch (err) {
          console.error("Sign-In Error:", err);
          if (err.code !== 'auth/popup-closed-by-user') {
            alert('Sign-In Notice: ' + (err.message || 'Please try again'));
          }
        }
      });
    }

    // Disconnect
    if (disconnectBtn) {
      disconnectBtn.addEventListener('click', async () => {
        if (confirm('Disconnect live sync and return to local offline mode?')) {
          if (unsubscribeSnapshot) unsubscribeSnapshot();
          activeSyncRoom = null;
          currentUser = null;
          localStorage.removeItem(STORAGE_KEY_ACTIVE_ROOM);
          try { await signOut(auth); } catch(e){}
          updateSyncUI();
          renderAll();
        }
      });
    }

    // Auth State Listener
    onAuthStateChanged(auth, (user) => {
      currentUser = user;
      if (user) {
        setupUserCloudSync(user.uid, user.displayName || user.email);
      } else if (activeSyncRoom) {
        connectToRoom(activeSyncRoom);
      } else {
        updateSyncUI();
      }
    });
  }

  function connectToRoom(roomCode) {
    if (unsubscribeSnapshot) unsubscribeSnapshot();
    activeSyncRoom = roomCode;
    localStorage.setItem(STORAGE_KEY_ACTIVE_ROOM, roomCode);

    const docRef = doc(db, "sync_rooms", roomCode);

    // FETCH REMOTE FIRST: Do NOT push local state until we check remote
    unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const remote = docSnap.data();
        applyRemoteData(remote);
      } else {
        // Room doesn't exist yet, initialize it with current data
        syncStateToCloud();
      }
    }, (err) => console.warn("Room listener:", err));

    updateSyncUI();
  }

  function setupUserCloudSync(uid, displayName) {
    if (unsubscribeSnapshot) unsubscribeSnapshot();
    activeSyncRoom = null;
    localStorage.removeItem(STORAGE_KEY_ACTIVE_ROOM);

    const docRef = doc(db, "user_profiles", uid);

    // FETCH REMOTE FIRST: Do NOT overwrite with phone's stale local storage!
    unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const remote = docSnap.data();
        applyRemoteData(remote);
      } else {
        // First-time user cloud backup initialization
        syncStateToCloud();
      }
    }, (err) => console.warn("User listener:", err));

    updateSyncUI();
  }

  function syncStateToCloud() {
    if (!activeSyncRoom && !currentUser) return;

    const payload = {
      updatedAt: Date.now(),
      currency: currentCurrency,
      deliverySessions,
      deliveryCustomExpenses,
      deliveryConfig,
      ledgerRecords,
      shiftRecords
    };

    if (activeSyncRoom) {
      setDoc(doc(db, "sync_rooms", activeSyncRoom), payload, { merge: true }).catch(console.warn);
    } else if (currentUser) {
      setDoc(doc(db, "user_profiles", currentUser.uid), payload, { merge: true }).catch(console.warn);
    }
  }

  function applyRemoteData(remote) {
    if (!remote) return;
    isReceivingRemoteUpdate = true;

    if (remote.currency) currentCurrency = remote.currency;
    if (Array.isArray(remote.deliverySessions)) deliverySessions = remote.deliverySessions;
    if (Array.isArray(remote.deliveryCustomExpenses)) deliveryCustomExpenses = remote.deliveryCustomExpenses;
    if (remote.deliveryConfig) deliveryConfig = remote.deliveryConfig;
    if (Array.isArray(remote.ledgerRecords)) ledgerRecords = remote.ledgerRecords;
    if (Array.isArray(remote.shiftRecords)) shiftRecords = remote.shiftRecords;

    saveData(false); // Save to localStorage without pushing back
    initCurrency();
    renderAll();

    isReceivingRemoteUpdate = false;
  }

  function updateSyncUI() {
    const titleEl = document.getElementById('sync-status-title');
    const descEl = document.getElementById('sync-status-desc');
    const dotEl = document.getElementById('sync-dot');
    const googleBtn = document.getElementById('btn-google-auth');
    const googleTxt = document.getElementById('google-btn-text');
    const roomBtn = document.getElementById('btn-open-room-modal');
    const disBtn = document.getElementById('btn-disconnect-sync');

    if (activeSyncRoom) {
      dotEl.className = 'st-pulse-dot dot-live';
      titleEl.innerHTML = `🟢 Live Room Connected: <strong>${activeSyncRoom}</strong>`;
      descEl.innerHTML = `Multi-device live sync active. Share code <strong>${activeSyncRoom}</strong> or link: <a href="?room=${activeSyncRoom}" target="_blank" style="color:#2563eb; font-weight:700;">Invite Link</a>`;
      roomBtn.innerText = `Room: ${activeSyncRoom}`;
      disBtn.style.display = 'inline-flex';
      googleBtn.style.display = 'none';
    } else if (currentUser) {
      dotEl.className = 'st-pulse-dot dot-live';
      titleEl.innerHTML = `🟢 Google Cloud Synced: <strong>${currentUser.displayName || currentUser.email}</strong>`;
      descEl.innerText = `Personal cloud backup active across all your logged-in phones and laptops.`;
      googleTxt.innerText = `Account: ${currentUser.displayName ? currentUser.displayName.split(' ')[0] : 'Connected'}`;
      disBtn.style.display = 'inline-flex';
      roomBtn.style.display = 'none';
    } else {
      dotEl.className = 'st-pulse-dot dot-offline';
      titleEl.innerText = 'Mode: Local Offline Storage';
      descEl.innerText = 'Data is saved locally in this browser. Connect a room or Google account to sync live across devices.';
      googleTxt.innerText = 'Google Cloud Sync';
      roomBtn.innerText = '📡 Live Room Code';
      disBtn.style.display = 'none';
      googleBtn.style.display = 'inline-flex';
      roomBtn.style.display = 'inline-flex';
    }
  }

  // Load Demo Data
  function loadDemoData() {
    const today = new Date().toISOString().split('T')[0];
    deliverySessions = [
      { id: 'ds_1', name: 'Saidur', date: today, startTime: '11:00', endTime: '14:00', appGross: 25.0, cashTips: 2.0, status: 'pending' },
      { id: 'ds_2', name: 'Tanvir', date: today, startTime: '14:30', endTime: '17:30', appGross: 35.0, cashTips: 4.0, status: 'pending' },
      { id: 'ds_3', name: 'Saidur', date: today, startTime: '18:30', endTime: '22:00', appGross: 45.0, cashTips: 5.0, status: 'pending' }
