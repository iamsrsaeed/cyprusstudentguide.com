---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cyprus Student Daily Money Ledger, Shift Tracker & Delivery Fleet Splitter 2026";
const description = "Track daily student income and expenses, log hourly shifts, or split shared food delivery earnings (Wolt/Foody) with ID rent, vehicle rental, and fuel deductions. 100% offline auto-save with Excel export.";
const permalink = "https://cyprusstudentguide.com/shift-tracker/";

const trackerSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Daily Money & Delivery Shift Tracker",
  "url": permalink,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript and LocalStorage",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="tracker">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(trackerSchema)} />

  <section class="tracker-hero">
    <span class="tracker-badge">🔒 100% Private • Local Storage Auto-Save • Excel Backup</span>
    <h1 class="tracker-title">Student Daily Money & Delivery Shift Tracker</h1>
    <p class="tracker-desc">Log your personal income & expenses, track hourly work shifts, or split shared food delivery earnings with ID rent, vehicle hire, and fuel deductions. Everything auto-saves in your browser.</p>
  </section>

  <!-- Top Toolbar: Currency Selector & Backup Control Center -->
  <div class="top-control-bar notranslate">
    <div class="currency-picker-wrap">
      <label for="global-currency-select"><strong>💱 Currency:</strong></label>
      <select id="global-currency-select" class="currency-select">
        <option value="€" selected>Euro (€)</option>
        <option value="৳">BDT (৳)</option>
        <option value="₹">INR (₹)</option>
        <option value="$">USD ($)</option>
        <option value="£">GBP (£)</option>
        <option value="₨">PKR / NPR (₨)</option>
      </select>
    </div>

    <div class="backup-status">
      <span class="status-indicator"></span>
      <span id="save-status-text">Auto-saved to browser</span>
    </div>

    <div class="backup-buttons">
      <button type="button" id="btn-export-csv" class="tool-btn btn-excel">
        📊 Export Excel (.CSV)
      </button>
      <button type="button" id="btn-export-json" class="tool-btn btn-json">
        💾 Save Backup (.json)
      </button>
      <label class="tool-btn btn-restore">
        📂 Restore File
        <input type="file" id="file-restore-input" accept=".json,.csv" style="display: none;" />
      </label>
      <button type="button" id="btn-clear-all" class="tool-btn btn-danger" title="Clear all local data">
        🗑️ Clear Data
      </button>
    </div>
  </div>

  <!-- 3-Mode Switcher Tabs -->
  <div class="mode-tabs-container notranslate">
    <button type="button" class="tab-btn active" id="tab-delivery-split">
      🛵 Delivery Splitter (ID & Bike Rent)
    </button>
    <button type="button" class="tab-btn" id="tab-money-ledger">
      💰 Daily Income & Expense Ledger
    </button>
    <button type="button" class="tab-btn" id="tab-daily-log">
      ⏱️ Hourly Work Shifts Log
    </button>
  </div>

  <div class="tracker-body notranslate">

    <!-- ================= MODE 1: ADVANCED FOOD DELIVERY SPLITTER ================= -->
    <div id="view-delivery-split" class="tracker-view active-view">
      <div class="split-calculator-card">
        <div class="split-header">
          <h2>🛵 Real-World Food Delivery Earnings & Rent Splitter</h2>
          <p class="split-sub">Calculate exact net earnings per rider after deducting Fleet/ID rent commission, vehicle rent, and fuel costs. Split fairly by total orders delivered or hours worked.</p>
        </div>

        <!-- App Gross & Deductions Setup -->
        <div class="split-grid-top">
          
          <div class="form-field">
            <label for="split-gross-app"><strong>📱 Total Gross App Earnings (<span class="curr-sym">€</span>):</strong></label>
            <input type="number" id="split-gross-app" class="t-input calc-split-input" placeholder="e.g. 165" value="165" step="1" min="0" />
            <span class="field-help">Total amount shown on Wolt / Foody / Bolt app</span>
          </div>

          <div class="form-field">
            <label for="split-split-basis"><strong>⚖️ Split Calculation Basis:</strong></label>
            <select id="split-split-basis" class="t-select calc-split-input">
              <option value="orders" selected>By Orders Completed (Most Accurate)</option>
              <option value="hours">By Hours on Road</option>
            </select>
          </div>

          <div class="form-field">
            <label for="split-fleet-type"><strong>📑 Fleet / ID Rent Deduction:</strong></label>
            <div class="input-with-select">
              <select id="split-fleet-type" class="t-select calc-split-input" style="flex: 1.2;">
                <option value="percent" selected>Percentage (%)</option>
                <option value="fixed">Fixed Flat (<span class="curr-sym">€</span>)</option>
              </select>
              <input type="number" id="split-fleet-val" class="t-input calc-split-input" style="flex: 1;" value="18" placeholder="e.g. 18" min="0" step="0.5" />
            </div>
            <span class="field-help" id="fleet-help-txt">Fleet cut (e.g. 18% or fixed daily fee)</span>
          </div>

          <div class="form-field">
            <label for="split-vehicle-rent"><strong>🛵 Vehicle / Scooter / Car Rent (<span class="curr-sym">€</span>):</strong></label>
            <input type="number" id="split-vehicle-rent" class="t-input calc-split-input" placeholder="Daily rent (0 if owned)" value="15" step="1" min="0" />
            <span class="field-help">Daily rental fee for bike/scooter/car</span>
          </div>

          <div class="form-field">
            <label for="split-fuel-cost"><strong>⛽ Petrol / Battery Charging (<span class="curr-sym">€</span>):</strong></label>
            <input type="number" id="split-fuel-cost" class="t-input calc-split-input" placeholder="Fuel cost" value="12" step="1" min="0" />
            <span class="field-help">Total fuel/charging expense today</span>
          </div>

          <div class="form-field">
            <label for="split-expense-split-mode"><strong>⚙️ Expense Sharing Method:</strong></label>
            <select id="split-expense-split-mode" class="t-select calc-split-input">
              <option value="proportional" selected>Proportional to Work/Orders (Fair)</option>
              <option value="equal">Equal 50/50 Split</option>
            </select>
          </div>

        </div>

        <!-- Dynamic Riders Working on This Shift -->
        <div class="riders-section">
          <div class="riders-header-row">
            <h4 class="riders-heading">👥 Riders Sharing This Shift / Account</h4>
            <span class="riders-count-badge" id="split-basis-indicator">Basis: Orders Completed</span>
          </div>
          
          <div id="delivery-riders-container" class="riders-list">
            <!-- Dynamically populated rider rows -->
          </div>

          <button type="button" id="btn-add-delivery-rider" class="btn-add-sub">
            + Add Another Delivery Partner
          </button>
        </div>

        <!-- Master Split Calculation Result -->
        <div class="split-result-box">
          <div class="result-summary-grid">
            <div class="res-item">
              <span>Gross App Income:</span>
              <strong><span class="curr-sym">€</span><span id="res-d-gross">165.00</span></strong>
            </div>
            <div class="res-item">
              <span>Fleet/ID Commission:</span>
              <strong style="color: #ef4444;">-<span class="curr-sym">€</span><span id="res-d-fleet">29.70</span></strong>
            </div>
            <div class="res-item">
              <span>Vehicle + Fuel:</span>
              <strong style="color: #ef4444;">-<span class="curr-sym">€</span><span id="res-d-expenses">27.00</span></strong>
            </div>
            <div class="res-item res-net">
              <span>Total Net Payout:</span>
              <strong style="color: #10b981;"><span class="curr-sym">€</span><span id="res-d-net">108.30</span></strong>
            </div>
          </div>

          <h4 class="payout-title">💵 Final Individual Payouts:</h4>
          <div id="delivery-payouts-list" class="payout-list">
            <!-- Individual payout cards calculated here -->
          </div>
        </div>

        <!-- Copy / WhatsApp Share Button -->
        <div class="split-share-actions">
          <button type="button" id="btn-copy-delivery-summary" class="btn-primary btn-copy-summary">
            📋 Copy Complete Shift Summary for WhatsApp
          </button>
          <span id="delivery-copy-feedback" class="copy-hint" style="display: none;">✅ Copied to clipboard!</span>
        </div>
      </div>
    </div>

    <!-- ================= MODE 2: DAILY INCOME & EXPENSE LEDGER ================= -->
    <div id="view-money-ledger" class="tracker-view">
      
      <div class="month-filter-bar">
        <div class="filter-left">
          <label for="ledger-month-filter"><strong>📅 Select Month to Review:</strong></label>
          <input type="month" id="ledger-month-filter" class="month-input" />
        </div>
        <div class="filter-right">
          <span class="month-tag" id="current-month-display">Current Month Report</span>
        </div>
      </div>

      <div class="stats-grid">
        <div class="stat-card stat-green">
          <span class="stat-label">Total Monthly Income</span>
          <div class="stat-val"><span class="curr-sym">€</span><span id="stat-ledger-income">0.00</span></div>
          <span class="stat-sub">Wages, salary, support</span>
        </div>
        <div class="stat-card stat-red">
          <span class="stat-label">Total Monthly Expenses</span>
          <div class="stat-val"><span class="curr-sym">€</span><span id="stat-ledger-expense">0.00</span></div>
          <span class="stat-sub">Rent, food, bills, misc</span>
        </div>
        <div class="stat-card stat-blue">
          <span class="stat-label">Month-End Net Balance</span>
          <div class="stat-val"><span class="curr-sym">€</span><span id="stat-ledger-net">0.00</span></div>
          <span class="stat-sub" id="stat-ledger-status">Savings / Deficit</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Total Entries Logged</span>
          <div class="stat-val" id="stat-ledger-count">0</div>
          <span class="stat-sub">In selected month</span>
        </div>
      </div>

      <div class="entry-form-card">
        <h3 class="form-title">➕ Add Daily Income / Expense Entry</h3>
        
        <div class="trans-type-toggle">
          <button type="button" class="type-btn active type-expense" id="btn-type-expense">🔻 Expense (খরচ)</button>
          <button type="button" class="type-btn type-income" id="btn-type-income">💚 Income (আয়)</button>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="trans-date"><strong>📅 Date:</strong></label>
            <input type="date" id="trans-date" class="t-input" />
          </div>
          
          <div class="form-field">
            <label for="trans-category"><strong>🏷️ Category:</strong></label>
            <select id="trans-category" class="t-select">
              <optgroup label="Expenses (খরচ)">
                <option value="Groceries & Food">🛒 Groceries & Food</option>
                <option value="Rent & Housing">🏠 Rent & Housing</option>
                <option value="Electricity & Utilities">⚡ Electricity & Water</option>
                <option value="Bus & Commute">🚌 Bus / Commute</option>
                <option value="Phone & Internet">📱 Phone & Internet</option>
                <option value="Dining Out & Coffee">☕ Dining Out & Coffee</option>
                <option value="Personal & Misc">🛍️ Personal & Misc</option>
              </optgroup>
              <optgroup label="Income (আয়)">
                <option value="Work Wages / Salary">💼 Work Wages / Salary</option>
                <option value="Delivery Earnings">🛵 Delivery Earnings</option>
                <option value="Family Support">🎁 Family Support</option>
                <option value="Freelancing / Other">💻 Freelancing / Other</option>
              </optgroup>
            </select>
          </div>

          <div class="form-field">
            <label for="trans-desc"><strong>📝 Note / Description:</strong></label>
            <input type="text" id="trans-desc" class="t-input" placeholder="e.g. Lidl grocery, August room rent" />
          </div>

          <div class="form-field">
            <label for="trans-amount"><strong>💰 Amount (<span class="curr-sym">€</span>):</strong></label>
            <input type="number" id="trans-amount" class="t-input" step="0.5" min="0" placeholder="e.g. 25.50" />
          </div>
        </div>

        <div class="form-actions">
          <button type="button" id="btn-save-transaction" class="btn-primary">
            + Save Entry to Ledger
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-header-row">
          <h3 class="table-title">📑 Transaction History</h3>
          <span class="table-count" id="ledger-count-badge">0 Entries</span>
        </div>

        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="ledger-tbody"></tbody>
          </table>
        </div>
        <div id="no-ledger-msg" class="empty-state">
          <p>No transactions recorded for this month yet. Add your daily income or expense above!</p>
        </div>
      </div>

    </div>

    <!-- ================= MODE 3: HOURLY WORK & WAGE LOG ================= -->
    <div id="view-daily-log" class="tracker-view">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-label">Total Hours Recorded</span>
          <div class="stat-val"><span id="stat-total-hours">0.0</span> hrs</div>
          <span class="stat-sub">Tracked shifts</span>
        </div>
        <div class="stat-card stat-green">
          <span class="stat-label">Total Earned Wages</span>
          <div class="stat-val"><span class="curr-sym">€</span><span id="stat-total-earned">0.00</span></div>
          <span class="stat-sub">Including tips</span>
        </div>
        <div class="stat-card stat-blue">
          <span class="stat-label">Average Hourly Rate</span>
          <div class="stat-val"><span class="curr-sym">€</span><span id="stat-avg-rate">0.00</span>/hr</div>
          <span class="stat-sub">Across all entries</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">Legal 20h Weekly Status</span>
          <div class="stat-val" id="stat-legal-status">In Compliance</div>
          <span class="stat-sub">Non-EU Student Law</span>
        </div>
      </div>

      <div class="entry-form-card">
        <h3 class="form-title">➕ Add Hourly Work Shift Entry</h3>
        <div class="form-grid">
          <div class="form-field">
            <label for="shift-date"><strong>📅 Date:</strong></label>
            <input type="date" id="shift-date" class="t-input" />
          </div>
          <div class="form-field">
            <label for="shift-job"><strong>🏢 Workplace / Role:</strong></label>
            <input type="text" id="shift-job" class="t-input" placeholder="e.g. Restaurant / Hotel / Construction" />
          </div>
          <div class="form-field">
            <label for="shift-hours"><strong>⌛ Hours Worked:</strong></label>
            <input type="number" id="shift-hours" class="t-input" step="0.5" min="0" placeholder="e.g. 5.5" />
          </div>
          <div class="form-field">
            <label for="shift-rate"><strong>💶 Hourly Rate (<span class="curr-sym">€</span>/hr):</strong></label>
            <input type="number" id="shift-rate" class="t-input" step="0.5" min="0" value="6.50" placeholder="e.g. 6.50" />
          </div>
          <div class="form-field">
            <label for="shift-tips"><strong>🎁 Extra Tips (<span class="curr-sym">€</span>):</strong></label>
            <input type="number" id="shift-tips" class="t-input" step="1" min="0" value="0" placeholder="e.g. 10" />
          </div>
        </div>
        
        <div class="form-actions">
          <button type="button" id="btn-save-shift" class="btn-primary">
            + Save Shift to Log
          </button>
        </div>
      </div>

      <div class="table-card">
        <div class="table-header-row">
          <h3 class="table-title">📋 Recorded Shift History</h3>
          <span class="table-count" id="log-count-badge">0 Shifts</span>
        </div>
        
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Workplace</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Tips</th>
                <th>Total Earned</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="shifts-tbody"></tbody>
          </table>
        </div>
        <div id="no-data-msg" class="empty-state">
          <p>No work shifts recorded yet. Add your first entry above to start tracking!</p>
        </div>
      </div>
    </div>

  </div>

  <!-- Safe Remittance / Taptap Send Box -->
  <div class="taptap-banner-card notranslate">
    <div class="taptap-left">
      <span class="taptap-tag">💡 Remittance & Tuition Fee Tip</span>
      <h3 class="taptap-h">Sending Earned Wages Home or Paying Tuition?</h3>
      <p class="taptap-p">Use Taptap Send from Cyprus with <strong>0% transfer fee</strong> and receive an extra <strong>€10 bonus</strong> on your first transfer using the student code below.</p>
    </div>
    <div class="taptap-right">
      <span class="promo-box">CODE: MDSAIDUR240</span>
      <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="btn-claim-taptap">Claim €10 ➔</a>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Storage Keys
  const STORAGE_KEY_CURRENCY = 'csg_user_currency';
  const STORAGE_KEY_LEDGER = 'csg_daily_ledger_data';
  const STORAGE_KEY_SHIFTS = 'csg_student_shifts_data';
  const STORAGE_KEY_DELIVERY = 'csg_delivery_fleet_data';

  // State
  let currentCurrency = '€';
  let currentTransType = 'expense';
  let ledgerRecords = [];
  let shiftRecords = [];
  
  // Real-world Delivery Shift State
  let deliveryRiders = [
    { name: 'Rider 1 (Morning)', units: 14, cashTips: 5 },
    { name: 'Rider 2 (Evening)', units: 11, cashTips: 8 }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const currentMonth = today.substring(0, 7);

    const transDateInput = document.getElementById('trans-date');
    if (transDateInput) transDateInput.value = today;

    const shiftDateInput = document.getElementById('shift-date');
    if (shiftDateInput) shiftDateInput.value = today;

    const monthFilter = document.getElementById('ledger-month-filter');
    if (monthFilter) monthFilter.value = currentMonth;

    loadLocalData();
    initCurrencyPicker();
    initTabSwitching();
    initDeliverySplitter();
    initLedgerEvents();
    initDailyLogEvents();
    initBackupEvents();
    renderAll();
  });

  function loadLocalData() {
    try {
      const savedCurr = localStorage.getItem(STORAGE_KEY_CURRENCY);
      if (savedCurr) currentCurrency = savedCurr;

      const savedLedger = localStorage.getItem(STORAGE_KEY_LEDGER);
      if (savedLedger) ledgerRecords = JSON.parse(savedLedger);

      const savedShifts = localStorage.getItem(STORAGE_KEY_SHIFTS);
      if (savedShifts) shiftRecords = JSON.parse(savedShifts);

      const savedDelivery = localStorage.getItem(STORAGE_KEY_DELIVERY);
      if (savedDelivery) deliveryRiders = JSON.parse(savedDelivery);
    } catch (e) {
      console.warn('Error reading local data:', e);
    }
  }

  function saveLocalData() {
    localStorage.setItem(STORAGE_KEY_CURRENCY, currentCurrency);
    localStorage.setItem(STORAGE_KEY_LEDGER, JSON.stringify(ledgerRecords));
    localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shiftRecords));
    localStorage.setItem(STORAGE_KEY_DELIVERY, JSON.stringify(deliveryRiders));
    showSaveStatus();
  }

  function showSaveStatus() {
    const el = document.getElementById('save-status-text');
    if (el) {
      el.innerText = 'Auto-saved at ' + new Date().toLocaleTimeString();
      setTimeout(() => {
        el.innerText = 'Auto-saved to browser';
      }, 3000);
    }
  }

  function initCurrencyPicker() {
    const currSelect = document.getElementById('global-currency-select');
    if (currSelect) {
      currSelect.value = currentCurrency;
      currSelect.addEventListener('change', (e) => {
        currentCurrency = e.target.value;
        saveLocalData();
        updateCurrencySymbols();
        renderAll();
      });
    }
    updateCurrencySymbols();
  }

  function updateCurrencySymbols() {
    document.querySelectorAll('.curr-sym').forEach(el => {
      el.innerText = currentCurrency;
    });
  }

  function initTabSwitching() {
    const tabDelivery = document.getElementById('tab-delivery-split');
    const tabLedger = document.getElementById('tab-money-ledger');
    const tabShift = document.getElementById('tab-daily-log');

    const viewDelivery = document.getElementById('view-delivery-split');
    const viewLedger = document.getElementById('view-money-ledger');
    const viewShift = document.getElementById('view-daily-log');

    tabDelivery.addEventListener('click', () => {
      tabDelivery.classList.add('active');
      tabLedger.classList.remove('active');
      tabShift.classList.remove('active');
      viewDelivery.classList.add('active-view');
      viewLedger.classList.remove('active-view');
      viewShift.classList.remove('active-view');
      calculateDeliverySplit();
    });

    tabLedger.addEventListener('click', () => {
      tabLedger.classList.add('active');
      tabDelivery.classList.remove('active');
      tabShift.classList.remove('active');
      viewLedger.classList.add('active-view');
      viewDelivery.classList.remove('active-view');
      viewShift.classList.remove('active-view');
      renderLedgerTable();
    });

    tabShift.addEventListener('click', () => {
      tabShift.classList.add('active');
      tabDelivery.classList.remove('active');
      tabLedger.classList.remove('active');
      viewShift.classList.add('active-view');
      viewDelivery.classList.remove('active-view');
      viewLedger.classList.remove('active-view');
      renderShiftsTable();
    });
  }

  // ================= DELIVERY SPLITTER LOGIC =================
  function initDeliverySplitter() {
    const basisSelect = document.getElementById('split-split-basis');
    if (basisSelect) {
      basisSelect.addEventListener('change', (e) => {
        const indicator = document.getElementById('split-basis-indicator');
        if (e.target.value === 'orders') {
          indicator.innerText = 'Basis: Orders Completed';
        } else {
          indicator.innerText = 'Basis: Hours Worked';
        }
        renderDeliveryRidersInputs();
        calculateDeliverySplit();
      });
    }

    const addRiderBtn = document.getElementById('btn-add-delivery-rider');
    addRiderBtn.addEventListener('click', () => {
      deliveryRiders.push({
        name: `Rider ${deliveryRiders.length + 1}`,
        units: 8,
        cashTips: 0
      });
      renderDeliveryRidersInputs();
      calculateDeliverySplit();
      saveLocalData();
    });

    const splitInputs = document.querySelectorAll('.calc-split-input');
    splitInputs.forEach(i => i.addEventListener('input', calculateDeliverySplit));

    document.getElementById('btn-copy-delivery-summary').addEventListener('click', copyDeliverySummary);

    renderDeliveryRidersInputs();
    calculateDeliverySplit();
  }

  function renderDeliveryRidersInputs() {
    const container = document.getElementById('delivery-riders-container');
    const basis = document.getElementById('split-split-basis').value;
    const unitLabel = basis === 'orders' ? 'orders' : 'hrs';

    container.innerHTML = '';

    deliveryRiders.forEach((rider, idx) => {
      const row = document.createElement('div');
      row.className = 'rider-card-row';
      row.innerHTML = `
        <div class="rider-name-box">
          <label>Rider Name / Shift:</label>
          <input type="text" class="t-input d-rider-name" value="${rider.name}" placeholder="e.g. Rider ${idx + 1}" />
        </div>
        <div class="rider-units-box">
          <label>${basis === 'orders' ? 'Orders Done:' : 'Hours on Road:'}</label>
          <div class="input-with-label">
            <input type="number" class="t-input d-rider-units" value="${rider.units}" min="0" step="${basis === 'orders' ? '1' : '0.5'}" />
            <span class="unit-tag">${unitLabel}</span>
          </div>
        </div>
        <div class="rider-tips-box">
          <label>Cash Tips Kept (<span class="curr-sym">${currentCurrency}</span>):</label>
          <input type="number" class="t-input d-rider-tips" value="${rider.cashTips || 0}" min="0" step="1" placeholder="0" />
        </div>
        ${deliveryRiders.length > 1 ? `<button type="button" class="btn-del-rider" title="Remove rider">✕</button>` : ''}
      `;

      row.querySelector('.d-rider-name').addEventListener('input', (e) => {
        deliveryRiders[idx].name = e.target.value;
        calculateDeliverySplit();
        saveLocalData();
      });

      row.querySelector('.d-rider-units').addEventListener('input', (e) => {
        deliveryRiders[idx].units = parseFloat(e.target.value) || 0;
        calculateDeliverySplit();
        saveLocalData();
      });

      row.querySelector('.d-rider-tips').addEventListener('input', (e) => {
        deliveryRiders[idx].cashTips = parseFloat(e.target.value) || 0;
        calculateDeliverySplit();
        saveLocalData();
      });

      const delBtn = row.querySelector('.btn-del-rider');
      if (delBtn) {
        delBtn.addEventListener('click', () => {
          deliveryRiders.splice(idx, 1);
          renderDeliveryRidersInputs();
          calculateDeliverySplit();
          saveLocalData();
        });
      }

      container.appendChild(row);
    });
  }

  function calculateDeliverySplit() {
    const grossApp = parseFloat(document.getElementById('split-gross-app').value) || 0;
    const fleetType = document.getElementById('split-fleet-type').value;
    const fleetVal = parseFloat(document.getElementById('split-fleet-val').value) || 0;
    const vehicleRent = parseFloat(document.getElementById('split-vehicle-rent').value) || 0;
    const fuelCost = parseFloat(document.getElementById('split-fuel-cost').value) || 0;
    const expenseMode = document.getElementById('split-expense-split-mode').value;
    const basis = document.getElementById('split-split-basis').value;

    // 1. Calculate Fleet / ID cut
    let fleetCut = 0;
    if (fleetType === 'percent') {
      fleetCut = (grossApp * fleetVal) / 100;
    } else {
      fleetCut = fleetVal;
    }

    // 2. Fixed & Variable Operating Expenses
    const operationalExpenses = vehicleRent + fuelCost;
    const netDistributable = Math.max(0, grossApp - fleetCut - operationalExpenses);

    // Update Top Summary Stats
    document.getElementById('res-d-gross').innerText = grossApp.toFixed(2);
    document.getElementById('res-d-fleet').innerText = fleetCut.toFixed(2);
    document.getElementById('res-d-expenses').innerText = operationalExpenses.toFixed(2);
    document.getElementById('res-d-net').innerText = netDistributable.toFixed(2);

    let totalUnits = 0;
    deliveryRiders.forEach(r => totalUnits += (r.units || 0));

    const payoutList = document.getElementById('delivery-payouts-list');
    payoutList.innerHTML = '';

    deliveryRiders.forEach(rider => {
      const ratio = totalUnits > 0 ? ((rider.units || 0) / totalUnits) : (1 / deliveryRiders.length);
      
      let riderGrossShare = grossApp * ratio;
      let riderFleetShare = fleetCut * ratio;
      let riderExpenseShare = 0;

      if (expenseMode === 'proportional') {
        riderExpenseShare = operationalExpenses * ratio;
      } else {
        riderExpenseShare = operationalExpenses / deliveryRiders.length;
      }

      const riderNetAppPayout = Math.max(0, riderGrossShare - riderFleetShare - riderExpenseShare);
      const totalPocketEarned = riderNetAppPayout + (rider.cashTips || 0);

      const card = document.createElement('div');
      card.className = 'rider-payout-card';
      card.innerHTML = `
        <div class="rpc-header">
          <div>
            <h5 class="rpc-name">👤 ${rider.name || 'Rider'}</h5>
            <span class="rpc-meta">${rider.units || 0} ${basis === 'orders' ? 'orders' : 'hrs'} (${(ratio * 100).toFixed(1)}% of shift)</span>
          </div>
          <div class="rpc-final-val">
            <span class="curr-sym">${currentCurrency}</span>${totalPocketEarned.toFixed(2)}
            <span class="rpc-final-sub">Total Take-Home</span>
          </div>
        </div>
        <div class="rpc-breakdown">
          <span>App Share: <strong>${currentCurrency}${riderGrossShare.toFixed(2)}</strong></span>
          <span>Fleet Cut: <strong class="red-txt">-${currentCurrency}${riderFleetShare.toFixed(2)}</strong></span>
          <span>Rent+Fuel: <strong class="red-txt">-${currentCurrency}${riderExpenseShare.toFixed(2)}</strong></span>
          <span>Cash Tips: <strong class="green-txt">+${currentCurrency}${(rider.cashTips || 0).toFixed(2)}</strong></span>
        </div>
      `;
      payoutList.appendChild(card);
    });
  }

  function copyDeliverySummary() {
    const grossApp = parseFloat(document.getElementById('split-gross-app').value) || 0;
    const fleetType = document.getElementById('split-fleet-type').value;
    const fleetVal = parseFloat(document.getElementById('split-fleet-val').value) || 0;
    const vehicleRent = parseFloat(document.getElementById('split-vehicle-rent').value) || 0;
    const fuelCost = parseFloat(document.getElementById('split-fuel-cost').value) || 0;
    const basis = document.getElementById('split-split-basis').value;
    const expenseMode = document.getElementById('split-expense-split-mode').value;

    let fleetCut = fleetType === 'percent' ? ((grossApp * fleetVal) / 100) : fleetVal;
    const operationalExpenses = vehicleRent + fuelCost;
    const netDistributable = Math.max(0, grossApp - fleetCut - operationalExpenses);

    let totalUnits = 0;
    deliveryRiders.forEach(r => totalUnits += (r.units || 0));

    let text = `🛵 *Cyprus Food Delivery Shift Split Summary*\n`;
    text += `📅 Date: ${new Date().toLocaleDateString()}\n`;
    text += `📱 App Gross Total: ${currentCurrency}${grossApp.toFixed(2)}\n`;
    text += `📑 Fleet/ID Commission: -${currentCurrency}${fleetCut.toFixed(2)} (${fleetType === 'percent' ? fleetVal + '%' : 'Fixed'})\n`;
    text += `🛵 Vehicle Rent: -${currentCurrency}${vehicleRent.toFixed(2)}\n`;
    text += `⛽ Fuel/Charging: -${currentCurrency}${fuelCost.toFixed(2)}\n`;
    text += `💵 Net Distributable Pool: ${currentCurrency}${netDistributable.toFixed(2)}\n`;
    text += `------------------------------------\n`;

    deliveryRiders.forEach(rider => {
      const ratio = totalUnits > 0 ? ((rider.units || 0) / totalUnits) : (1 / deliveryRiders.length);
      let riderGrossShare = grossApp * ratio;
      let riderFleetShare = fleetCut * ratio;
      let riderExpenseShare = expenseMode === 'proportional' ? (operationalExpenses * ratio) : (operationalExpenses / deliveryRiders.length);
      const riderNetAppPayout = Math.max(0, riderGrossShare - riderFleetShare - riderExpenseShare);
      const totalPocket = riderNetAppPayout + (rider.cashTips || 0);

      text += `👤 *${rider.name}*:\n`;
      text += `   • Shift Done: ${rider.units} ${basis === 'orders' ? 'orders' : 'hours'} (${(ratio * 100).toFixed(0)}%)\n`;
      text += `   • Net App Payout: ${currentCurrency}${riderNetAppPayout.toFixed(2)}\n`;
      if (rider.cashTips > 0) text += `   • Cash Tips Kept: +${currentCurrency}${rider.cashTips.toFixed(2)}\n`;
      text += `   👉 *Total Net: ${currentCurrency}${totalPocket.toFixed(2)}*\n\n`;
    });

    text += `Calculated accurately on CyprusStudentGuide.com`;

    navigator.clipboard.writeText(text).then(() => {
      const hint = document.getElementById('delivery-copy-feedback');
      hint.style.display = 'inline';
      setTimeout(() => hint.style.display = 'none', 3000);
    });
  }

  // ================= LEDGER & WORK LOG LOGIC =================
  function initLedgerEvents() {
    const btnExp = document.getElementById('btn-type-expense');
    const btnInc = document.getElementById('btn-type-income');
    const catSelect = document.getElementById('trans-category');

    btnExp.addEventListener('click', () => {
      currentTransType = 'expense';
      btnExp.classList.add('active');
      btnInc.classList.remove('active');
      catSelect.value = 'Groceries & Food';
    });

    btnInc.addEventListener('click', () => {
      currentTransType = 'income';
      btnInc.classList.add('active');
      btnExp.classList.remove('active');
      catSelect.value = 'Work Wages / Salary';
    });

    const monthFilter = document.getElementById('ledger-month-filter');
    if (monthFilter) {
      monthFilter.addEventListener('change', renderLedgerTable);
    }

    const btnSave = document.getElementById('btn-save-transaction');
    btnSave.addEventListener('click', () => {
      const date = document.getElementById('trans-date').value;
      const category = document.getElementById('trans-category').value;
      const desc = document.getElementById('trans-desc').value.trim() || category;
      const amount = parseFloat(document.getElementById('trans-amount').value) || 0;

      if (amount <= 0) {
        alert('Please enter a valid amount.');
        return;
      }

      const item = {
        id: 'tx_' + Date.now(),
        date,
        type: currentTransType,
        category,
        desc,
        amount,
        currency: currentCurrency
      };

      ledgerRecords.unshift(item);
      saveLocalData();
      renderLedgerTable();

      document.getElementById('trans-desc').value = '';
      document.getElementById('trans-amount').value = '';
    });
  }

  function renderLedgerTable() {
    const tbody = document.getElementById('ledger-tbody');
    const emptyMsg = document.getElementById('no-ledger-msg');
    const countBadge = document.getElementById('ledger-count-badge');
    const selectedMonth = document.getElementById('ledger-month-filter').value;
    const monthDisplay = document.getElementById('current-month-display');

    if (monthDisplay && selectedMonth) {
      const [year, month] = selectedMonth.split('-');
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      monthDisplay.innerText = `${monthNames[parseInt(month)-1]} ${year} Report`;
    }

    tbody.innerHTML = '';
    const filtered = ledgerRecords.filter(item => item.date.startsWith(selectedMonth));
    countBadge.innerText = `${filtered.length} Entries`;

    let totalIncome = 0;
    let totalExpense = 0;

    if (filtered.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      filtered.forEach((item) => {
        if (item.type === 'income') totalIncome += item.amount;
        else totalExpense += item.amount;

        const tr = document.createElement('tr');
        const isInc = item.type === 'income';
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td><span class="badge-${item.type}">${isInc ? '💚 Income' : '🔻 Expense'}</span></td>
          <td>${item.category}</td>
          <td>${item.desc}</td>
          <td class="${isInc ? 'amount-income' : 'amount-expense'}">
            ${isInc ? '+' : '-'}${currentCurrency}${item.amount.toFixed(2)}
          </td>
          <td>
            <button type="button" class="btn-delete" title="Delete entry">✕</button>
          </td>
        `;

        tr.querySelector('.btn-delete').addEventListener('click', () => {
          if (confirm('Delete this transaction?')) {
            const index = ledgerRecords.findIndex(r => r.id === item.id);
            if (index !== -1) {
              ledgerRecords.splice(index, 1);
              saveLocalData();
              renderLedgerTable();
            }
          }
        });

        tbody.appendChild(tr);
      });
    }

    const netBalance = totalIncome - totalExpense;
    document.getElementById('stat-ledger-income').innerText = totalIncome.toFixed(2);
    document.getElementById('stat-ledger-expense').innerText = totalExpense.toFixed(2);
    
    const netEl = document.getElementById('stat-ledger-net');
    const netStatus = document.getElementById('stat-ledger-status');
    netEl.innerText = (netBalance >= 0 ? '+' : '') + netBalance.toFixed(2);

    if (netBalance >= 0) {
      netEl.style.color = '#10b981';
      netStatus.innerText = '✅ Net Savings Surplus';
    } else {
      netEl.style.color = '#ef4444';
      netStatus.innerText = '⚠️ Net Monthly Deficit';
    }

    document.getElementById('stat-ledger-count').innerText = filtered.length;
  }

  function initDailyLogEvents() {
    const btnSave = document.getElementById('btn-save-shift');
    btnSave.addEventListener('click', () => {
      const date = document.getElementById('shift-date').value;
      const job = document.getElementById('shift-job').value.trim() || 'General Shift';
      const hours = parseFloat(document.getElementById('shift-hours').value) || 0;
      const rate = parseFloat(document.getElementById('shift-rate').value) || 0;
      const tips = parseFloat(document.getElementById('shift-tips').value) || 0;

      if (hours <= 0) {
        alert('Please enter valid working hours.');
        return;
      }

      const totalEarned = (hours * rate) + tips;
      const entry = {
        id: 'shift_' + Date.now(),
        date,
        job,
        hours,
        rate,
        tips,
        totalEarned
      };

      shiftRecords.unshift(entry);
      saveLocalData();
      renderShiftsTable();

      document.getElementById('shift-hours').value = '';
      document.getElementById('shift-tips').value = '0';
    });
  }

  function renderShiftsTable() {
    const tbody = document.getElementById('shifts-tbody');
    const emptyMsg = document.getElementById('no-data-msg');
    const countBadge = document.getElementById('log-count-badge');

    tbody.innerHTML = '';
    countBadge.innerText = `${shiftRecords.length} Shifts`;

    if (shiftRecords.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      shiftRecords.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td>${item.job}</td>
          <td>${item.hours} hrs</td>
          <td>${currentCurrency}${item.rate.toFixed(2)}/hr</td>
          <td>${currentCurrency}${item.tips.toFixed(2)}</td>
          <td class="earned-col">${currentCurrency}${item.totalEarned.toFixed(2)}</td>
          <td>
            <button type="button" class="btn-delete" title="Delete shift">✕</button>
          </td>
        `;

        tr.querySelector('.btn-delete').addEventListener('click', () => {
          if (confirm('Delete this shift entry?')) {
            shiftRecords.splice(index, 1);
            saveLocalData();
            renderShiftsTable();
          }
        });

        tbody.appendChild(tr);
      });
    }

    updateShiftStats();
  }

  function updateShiftStats() {
    let totalHours = 0;
    let totalEarned = 0;

    shiftRecords.forEach(s => {
      totalHours += s.hours;
      totalEarned += s.totalEarned;
    });

    const avgRate = totalHours > 0 ? (totalEarned / totalHours) : 0;

    document.getElementById('stat-total-hours').innerText = totalHours.toFixed(1);
    document.getElementById('stat-total-earned').innerText = totalEarned.toFixed(2);
    document.getElementById('stat-avg-rate').innerText = avgRate.toFixed(2);

    const legalStatus = document.getElementById('stat-legal-status');
    if (totalHours > 20) {
      legalStatus.innerText = 'Verify Multi-Week Avg';
      legalStatus.style.color = '#f59e0b';
    } else {
      legalStatus.innerText = 'Legal Limit OK (≤20h)';
      legalStatus.style.color = '#10b981';
    }
  }

  function initBackupEvents() {
    document.getElementById('btn-export-csv').addEventListener('click', exportToCSV);
    document.getElementById('btn-export-json').addEventListener('click', exportToJSON);

    const fileInput = document.getElementById('file-restore-input');
    fileInput.addEventListener('change', handleFileRestore);

    document.getElementById('btn-clear-all').addEventListener('click', () => {
      if (confirm('Are you sure you want to clear all data? Make sure you have exported an Excel or JSON backup first!')) {
        ledgerRecords = [];
        shiftRecords = [];
        deliveryRiders = [
          { name: 'Rider 1 (Morning)', units: 14, cashTips: 5 },
          { name: 'Rider 2 (Evening)', units: 11, cashTips: 8 }
        ];
        saveLocalData();
        renderAll();
      }
    });
  }

  function exportToCSV() {
    if (ledgerRecords.length === 0 && shiftRecords.length === 0) {
      alert('No records to export yet. Please add entries first!');
      return;
    }

    let csv = "=== DAILY INCOME & EXPENSE LEDGER ===\n";
    csv += "Date,Type,Category,Description,Amount,Currency\n";
    ledgerRecords.forEach(item => {
      csv += `"${item.date}","${item.type}","${item.category}","${item.desc.replace(/"/g, '""')}",${item.amount},"${currentCurrency}"\n`;
    });

    csv += "\n=== WORK SHIFTS LOG ===\n";
    csv += "Date,Workplace,Hours,Hourly Rate,Tips,Total Earned,Currency\n";
    shiftRecords.forEach(s => {
      csv += `"${s.date}","${s.job.replace(/"/g, '""')}",${s.hours},${s.rate},${s.tips},${s.totalEarned},"${currentCurrency}"\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Cyprus_Student_Financial_Log_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function exportToJSON() {
    const backupData = {
      version: "3.0",
      exportDate: new Date().toISOString(),
      currency: currentCurrency,
      ledger: ledgerRecords,
      shifts: shiftRecords,
      delivery: deliveryRiders
    };

    const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Cyprus_Student_Backup_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function handleFileRestore(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
      try {
        const content = evt.target.result;
        if (file.name.endsWith('.json')) {
          const parsed = JSON.parse(content);
          if (parsed.currency) currentCurrency = parsed.currency;
          if (parsed.ledger) ledgerRecords = parsed.ledger;
          if (parsed.shifts) shiftRecords = parsed.shifts;
          if (parsed.delivery) deliveryRiders = parsed.delivery;
          
          saveLocalData();
          initCurrencyPicker();
          renderAll();
          alert('✅ Backup restored successfully!');
        } else {
          alert('Please upload a valid .json backup file for complete restoration.');
        }
      } catch (err) {
        alert('Could not parse file: ' + err.message);
      }
    };
    reader.readAsText(file);
  }

  function renderAll() {
    renderDeliveryRidersInputs();
    calculateDeliverySplit();
    renderLedgerTable();
    renderShiftsTable();
  }
</script>

