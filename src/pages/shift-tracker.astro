---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cyprus Student Food Delivery Payout & Shift Settlement Tracker 2026";
const description = "Track individual food delivery shifts (Wolt, Foody), filter by weekly/bi-weekly withdrawal dates, calculate fleet commissions & vehicle rent, and distribute net payouts seamlessly.";
const permalink = "https://cyprusstudentguide.com/shift-tracker/";

const trackerSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Delivery Shift Settlement Tracker",
  "url": permalink,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript and LocalStorage",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="tracker">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(trackerSchema)} />

  <div class="st-wrapper notranslate">
    <!-- Header Hero -->
    <div class="st-hero">
      <span class="st-badge">🛵 Delivery Settlement & Multi-Rider Wallet Tool</span>
      <h1 class="st-title">Delivery Shift & Payout Settlement Tracker</h1>
      <p class="st-desc">Log individual delivery time slots, group them by weekly or monthly withdrawal pay cycles, deduct fleet cuts & vehicle rental, and generate instant payout settlements per rider.</p>
    </div>

    <!-- Top Toolbar -->
    <div class="st-toolbar">
      <div class="st-tool-group">
        <label for="global-currency-select" class="st-tool-label">Currency:</label>
        <select id="global-currency-select" class="st-select-mini">
          <option value="€" selected>EUR (€)</option>
          <option value="৳">BDT (৳)</option>
          <option value="₹">INR (₹)</option>
          <option value="$">USD ($)</option>
          <option value="£">GBP (£)</option>
          <option value="₨">PKR / NPR (₨)</option>
        </select>
      </div>

      <div class="st-save-status">
        <span class="st-dot"></span>
        <span id="save-status-text">Auto-saved to browser</span>
      </div>

      <div class="st-actions-group">
        <button type="button" id="btn-export-csv" class="st-btn st-btn-green">📊 Excel (.CSV)</button>
        <button type="button" id="btn-export-json" class="st-btn st-btn-gray">💾 Save Backup</button>
        <label class="st-btn st-btn-gray st-btn-file">
          📂 Restore
          <input type="file" id="file-restore-input" accept=".json,.csv" style="display: none;" />
        </label>
        <button type="button" id="btn-clear-all" class="st-btn st-btn-red" title="Clear all local data">🗑️ Reset</button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="st-tabs">
      <button type="button" class="st-tab-btn active" data-target="view-delivery-sessions">
        🛵 Delivery Shift Sessions & Withdrawal Settlement
      </button>
      <button type="button" class="st-tab-btn" data-target="view-money-ledger">
        💰 Daily Income & Expenses
      </button>
      <button type="button" class="st-tab-btn" data-target="view-daily-log">
        ⏱️ Hourly Work Shifts Log
      </button>
    </div>

    <!-- ================= TAB 1: DELIVERY SESSIONS & PAYOUT SETTLEMENT ================= -->
    <div id="view-delivery-sessions" class="st-tab-content active">
      
      <!-- Top Shift Settings -->
      <div class="st-card">
        <div class="st-card-head">
          <h2 class="st-card-title">⚙️ Fleet Commission & Shared Vehicle Deductions</h2>
          <p class="st-card-sub">Configure fleet account commission and shared vehicle/fuel expenses. Deductions are calculated proportionally based on each rider's gross earnings.</p>
        </div>

        <div class="st-grid-3">
          <div class="st-field">
            <label>Fleet / ID Commission (%):</label>
            <div class="st-input-unit-left">
              <input type="number" id="cfg-fleet-percent" class="st-input cfg-input" value="18" min="0" max="100" step="0.5" />
              <span class="st-unit-tag-right">%</span>
            </div>
            <span class="st-hint">Standard fleet fee (usually 15% - 20%)</span>
          </div>

          <div class="st-field">
            <label>Total Shared Vehicle Rent (<span class="curr-sym">€</span>):</label>
            <input type="number" id="cfg-scooter-rent" class="st-input cfg-input" value="15" min="0" step="1" />
            <span class="st-hint">Total rental cost during this cycle</span>
          </div>

          <div class="st-field">
            <label>Total Shared Fuel / Charging (<span class="curr-sym">€</span>):</label>
            <input type="number" id="cfg-fuel-cost" class="st-input cfg-input" value="10" min="0" step="1" />
            <span class="st-hint">Total petrol/power cost during this cycle</span>
          </div>
        </div>
      </div>

      <!-- Add Shift Session Form -->
      <div class="st-card">
        <h3 class="st-box-title">➕ Add Shift Session</h3>
        <p class="st-card-sub" style="margin-top: -0.5rem; margin-bottom: 1.25rem;">Log individual time slots and exact money earned on the Wolt / Foody delivery app.</p>

        <div class="st-grid-session-form">
          <div class="st-field">
            <label>Rider Name:</label>
            <input type="text" id="sess-rider-name" class="st-input" placeholder="e.g. Saidur, Tanvir, Rider 1" />
          </div>

          <div class="st-field">
            <label>Date:</label>
            <input type="date" id="sess-date" class="st-input" />
          </div>

          <div class="st-field">
            <label>Shift Time (From – To):</label>
            <div class="st-time-combo">
              <input type="time" id="sess-start-time" class="st-input" value="11:00" />
              <span class="st-time-sep">to</span>
              <input type="time" id="sess-end-time" class="st-input" value="14:00" />
            </div>
          </div>

          <div class="st-field">
            <label>App Gross Earned (<span class="curr-sym">€</span>):</label>
            <input type="number" id="sess-app-gross" class="st-input" placeholder="e.g. 20.00" step="0.5" min="0" />
          </div>

          <div class="st-field">
            <label>Cash Tips Kept (<span class="curr-sym">€</span>):</label>
            <input type="number" id="sess-cash-tips" class="st-input" value="0" step="0.5" min="0" placeholder="0.00" />
          </div>
        </div>

        <button type="button" id="btn-add-session" class="st-btn st-btn-primary" style="margin-top: 1.25rem;">
          + Log Shift Session
        </button>
      </div>

      <!-- Payout Settlement Period Filter & Summary Card -->
      <div class="st-card" style="border: 2px solid var(--primary-glow);">
        <div class="st-card-head">
          <div class="st-filter-row" style="margin: 0;">
            <div>
              <h2 class="st-card-title" style="color: var(--primary-blue);">🏦 Withdrawal Cycle Settlement (Pay Day Summary)</h2>
              <p class="st-card-sub">Filter sessions up to withdrawal date to determine how much money each rider withdraws from bank payout.</p>
            </div>
            <div class="st-cycle-filter">
              <label>Filter Date Range:</label>
              <div class="st-time-combo">
                <input type="date" id="filter-start-date" class="st-input-mini" />
                <span class="st-time-sep">to</span>
                <input type="date" id="filter-end-date" class="st-input-mini" />
              </div>
            </div>
          </div>
        </div>

        <!-- Macro Stats for Current Settlement Window -->
        <div class="st-stats-grid">
          <div class="st-stat-card">
            <span class="st-stat-lbl">Cycle App Gross</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-cycle-gross">0.00</span></div>
            <span class="st-stat-sub">Total earned on app</span>
          </div>
          <div class="st-stat-card st-red">
            <span class="st-stat-lbl">Fleet Cut Deducted</span>
            <div class="st-stat-num">-<span class="curr-sym">€</span><span id="stat-cycle-fleet">0.00</span></div>
            <span class="st-stat-sub" id="stat-cycle-fleet-pct">18% rate</span>
          </div>
          <div class="st-stat-card st-red">
            <span class="st-stat-lbl">Rent + Fuel Share</span>
            <div class="st-stat-num">-<span class="curr-sym">€</span><span id="stat-cycle-expenses">0.00</span></div>
            <span class="st-stat-sub">Vehicle & fuel costs</span>
          </div>
          <div class="st-stat-card st-green">
            <span class="st-stat-lbl">Total Net Bank Payout</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-cycle-net">0.00</span></div>
            <span class="st-stat-sub">Distributable to riders</span>
          </div>
        </div>

        <!-- Rider-wise Breakdown Cards (Who gets how much) -->
        <h4 class="st-payout-heading">💵 Rider Settlement Distribution (Final Bank / Cash Payout):</h4>
        <div id="cycle-rider-settlement-list" class="st-rider-settlement-cards">
          <!-- Dynamically populated rider settlement summary cards -->
        </div>

        <div class="st-foot-actions" style="margin-top: 1.5rem;">
          <button type="button" id="btn-copy-delivery-summary" class="st-btn st-btn-primary">
            📋 Copy WhatsApp Settlement Statement
          </button>
          <span id="delivery-copy-feedback" class="st-feedback-msg" style="display: none;">✅ Copied to clipboard!</span>
        </div>
      </div>

      <!-- Individual Shift Sessions History Table -->
      <div class="st-card">
        <div class="st-filter-row">
          <h3 class="st-box-title" style="margin: 0;">📋 Individual Logged Sessions</h3>
          <span class="st-tag-blue" id="session-count-badge">0 Sessions</span>
        </div>

        <div class="st-table-wrapper">
          <table class="st-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Rider</th>
                <th>Shift Time Slot</th>
                <th>App Gross</th>
                <th>Fleet Cut</th>
                <th>Rent/Fuel</th>
                <th>Cash Tips</th>
                <th>Net Share</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="delivery-sessions-tbody"></tbody>
          </table>
          <div id="no-sessions-msg" class="st-empty-msg">No delivery sessions logged in this range. Add your shifts above!</div>
        </div>
      </div>

    </div>

    <!-- ================= TAB 2: DAILY INCOME & EXPENSE LEDGER ================= -->
    <div id="view-money-ledger" class="st-tab-content">
      <div class="st-card">
        <div class="st-filter-row">
          <div class="st-filter-item">
            <label for="ledger-month-filter"><strong>Select Month:</strong></label>
            <input type="month" id="ledger-month-filter" class="st-input-mini" />
          </div>
          <span class="st-tag-blue" id="current-month-display">Monthly Report</span>
        </div>

        <div class="st-stats-grid">
          <div class="st-stat-card st-green">
            <span class="st-stat-lbl">Monthly Income</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-income">0.00</span></div>
            <span class="st-stat-sub">Wages & Support</span>
          </div>
          <div class="st-stat-card st-red">
            <span class="st-stat-lbl">Monthly Expenses</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-expense">0.00</span></div>
            <span class="st-stat-sub">Rent, Food & Bills</span>
          </div>
          <div class="st-stat-card st-blue">
            <span class="st-stat-lbl">Net Balance</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-net">0.00</span></div>
            <span class="st-stat-sub" id="stat-ledger-status">Net Savings</span>
          </div>
          <div class="st-stat-card">
            <span class="st-stat-lbl">Total Entries</span>
            <div class="st-stat-num" id="stat-ledger-count">0</div>
            <span class="st-stat-sub">This Month</span>
          </div>
        </div>

        <div class="st-entry-box">
          <h3 class="st-box-title">➕ Add Daily Entry</h3>
          
          <div class="st-toggle-row">
            <button type="button" class="st-toggle-btn active-exp" id="btn-type-expense">🔻 Expense Entry</button>
            <button type="button" class="st-toggle-btn" id="btn-type-income">💚 Income Entry</button>
          </div>

          <div class="st-grid-4">
            <div class="st-field">
              <label>Date:</label>
              <input type="date" id="trans-date" class="st-input" />
            </div>
            
            <div class="st-field">
              <label>Category:</label>
              <select id="trans-category" class="st-select">
                <optgroup label="Expenses">
                  <option value="Groceries & Food">🛒 Groceries & Food</option>
                  <option value="Rent & Housing">🏠 Rent & Housing</option>
                  <option value="Electricity & Utilities">⚡ Electricity & Water</option>
                  <option value="Bus & Commute">🚌 Bus / Commute</option>
                  <option value="Phone & Internet">📱 Phone & Internet</option>
                  <option value="Dining Out & Coffee">☕ Dining Out & Coffee</option>
                  <option value="Personal & Misc">🛍️ Personal & Misc</option>
                </optgroup>
                <optgroup label="Income">
                  <option value="Work Wages / Salary">💼 Work Wages / Salary</option>
                  <option value="Delivery Earnings">🛵 Delivery Earnings</option>
                  <option value="Family Support">🎁 Family Support</option>
                  <option value="Freelancing / Other">💻 Freelancing / Other</option>
                </optgroup>
              </select>
            </div>

            <div class="st-field">
              <label>Description / Custom Item:</label>
              <input type="text" id="trans-desc" class="st-input" placeholder="e.g. Sklavenitis grocery, room rent" />
            </div>

            <div class="st-field">
              <label>Amount (<span class="curr-sym">€</span>):</label>
              <input type="number" id="trans-amount" class="st-input" step="0.5" min="0" placeholder="0.00" />
            </div>
          </div>

          <button type="button" id="btn-save-transaction" class="st-btn st-btn-primary" style="margin-top: 1rem;">
            + Save Entry to Ledger
          </button>
        </div>

        <div class="st-table-wrapper">
          <table class="st-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="ledger-tbody"></tbody>
          </table>
          <div id="no-ledger-msg" class="st-empty-msg">No transactions recorded for this month yet.</div>
        </div>
      </div>
    </div>

    <!-- ================= TAB 3: HOURLY WORK SHIFTS ================= -->
    <div id="view-daily-log" class="st-tab-content">
      <div class="st-card">
        <div class="st-stats-grid">
          <div class="st-stat-card">
            <span class="st-stat-lbl">Hours Tracked</span>
            <div class="st-stat-num"><span id="stat-total-hours">0.0</span> hrs</div>
            <span class="st-stat-sub">Total recorded</span>
          </div>
          <div class="st-stat-card st-green">
            <span class="st-stat-lbl">Earned Wages</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-total-earned">0.00</span></div>
            <span class="st-stat-sub">Including tips</span>
          </div>
          <div class="st-stat-card st-blue">
            <span class="st-stat-lbl">Avg Rate</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-avg-rate">0.00</span>/hr</div>
            <span class="st-stat-sub">Average per hour</span>
          </div>
          <div class="st-stat-card">
            <span class="st-stat-lbl">Weekly Status</span>
            <div class="st-stat-num" id="stat-legal-status" style="font-size: 1.15rem;">Limit OK (≤20h)</div>
            <span class="st-stat-sub">Student Legal Limit</span>
          </div>
        </div>

        <div class="st-entry-box">
          <h3 class="st-box-title">➕ Add Hourly Work Shift</h3>
          <div class="st-grid-5">
            <div class="st-field">
              <label>Date:</label>
              <input type="date" id="shift-date" class="st-input" />
            </div>
            <div class="st-field">
              <label>Workplace / Role:</label>
              <input type="text" id="shift-job" class="st-input" placeholder="e.g. Hotel, Restaurant, Construction" />
            </div>
            <div class="st-field">
              <label>Hours Worked:</label>
              <input type="number" id="shift-hours" class="st-input" step="0.5" min="0" placeholder="e.g. 5.5" />
            </div>
            <div class="st-field">
              <label>Hourly Rate (<span class="curr-sym">€</span>/hr):</label>
              <input type="number" id="shift-rate" class="st-input" step="0.5" min="0" value="6.50" />
            </div>
            <div class="st-field">
              <label>Tips (<span class="curr-sym">€</span>):</label>
              <input type="number" id="shift-tips" class="st-input" step="1" min="0" value="0" />
            </div>
          </div>
          
          <button type="button" id="btn-save-shift" class="st-btn st-btn-primary" style="margin-top: 1rem;">
            + Save Shift
          </button>
        </div>

        <div class="st-table-wrapper">
          <table class="st-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Workplace</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Tips</th>
                <th>Total Earned</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="shifts-tbody"></tbody>
          </table>
          <div id="no-data-msg" class="st-empty-msg">No work shifts recorded yet. Add your first shift above!</div>
        </div>
      </div>
    </div>

    <!-- Monetization Banner -->
    <div class="st-taptap-card">
      <div class="st-taptap-left">
        <span class="st-taptap-badge">💡 Smart Money Transfer Tip</span>
        <h3>Sending Wages to Home Country or Receiving Funds?</h3>
        <p>Use Taptap Send with <strong>0% fee</strong> and receive an extra <strong>€10 bonus</strong> on your first transfer using the student code below.</p>
      </div>
      <div class="st-taptap-right">
        <span class="st-taptap-code">CODE: MDSAIDUR240</span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="st-btn st-btn-primary">Claim €10 ➔</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Storage Keys
  const STORAGE_KEY_CURRENCY = 'csg_user_currency';
  const STORAGE_KEY_LEDGER = 'csg_daily_ledger_data';
  const STORAGE_KEY_SHIFTS = 'csg_student_shifts_data';
  const STORAGE_KEY_SESSIONS = 'csg_delivery_sessions_data';
  const STORAGE_KEY_CONFIG = 'csg_delivery_config_data';

  // State
  let currentCurrency = '€';
  let currentTransType = 'expense';
  let ledgerRecords = [];
  let shiftRecords = [];

  // Delivery Sessions & Config State
  let deliverySessions = [
    { id: 'ds_1', name: 'Saidur', date: '2026-08-25', startTime: '11:00', endTime: '14:00', appGross: 20.0, cashTips: 2.0 },
    { id: 'ds_2', name: 'Tanvir', date: '2026-08-25', startTime: '15:00', endTime: '17:00', appGross: 35.0, cashTips: 5.0 },
    { id: 'ds_3', name: 'Rahim', date: '2026-08-26', startTime: '10:00', endTime: '12:00', appGross: 25.0, cashTips: 1.0 },
    { id: 'ds_4', name: 'Tanvir', date: '2026-08-26', startTime: '13:00', endTime: '15:00', appGross: 30.0, cashTips: 3.0 },
    { id: 'ds_5', name: 'Saidur', date: '2026-08-26', startTime: '21:00', endTime: '00:00', appGross: 45.0, cashTips: 4.0 }
  ];

  let deliveryConfig = {
    fleetPercent: 18.0,
    scooterRent: 15.0,
    fuelCost: 10.0
  };

  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const currentMonth = today.substring(0, 7);

    // Default dates
    const sDate = document.getElementById('sess-date');
    if (sDate) sDate.value = today;

    const tDate = document.getElementById('trans-date');
    if (tDate) tDate.value = today;

    const shDate = document.getElementById('shift-date');
    if (shDate) shDate.value = today;

    const mFilter = document.getElementById('ledger-month-filter');
    if (mFilter) mFilter.value = currentMonth;

    // Default Filter Range: Start of current month to today
    const fStart = document.getElementById('filter-start-date');
    const fEnd = document.getElementById('filter-end-date');
    if (fStart) fStart.value = `${currentMonth}-01`;
    if (fEnd) fEnd.value = today;

    loadData();
    initCurrency();
    initTabs();
    initDeliverySessionsEngine();
    initLedgerEngine();
    initShiftsEngine();
    initBackupEngine();
    renderAll();
  });

  function loadData() {
    try {
      const c = localStorage.getItem(STORAGE_KEY_CURRENCY);
      if (c) currentCurrency = c;

      const l = localStorage.getItem(STORAGE_KEY_LEDGER);
      if (l) ledgerRecords = JSON.parse(l);

      const s = localStorage.getItem(STORAGE_KEY_SHIFTS);
      if (s) shiftRecords = JSON.parse(s);

      const ds = localStorage.getItem(STORAGE_KEY_SESSIONS);
      if (ds) deliverySessions = JSON.parse(ds);

      const cfg = localStorage.getItem(STORAGE_KEY_CONFIG);
      if (cfg) deliveryConfig = JSON.parse(cfg);
    } catch (e) {
      console.warn('Storage read error:', e);
    }
  }

  function saveData() {
    localStorage.setItem(STORAGE_KEY_CURRENCY, currentCurrency);
    localStorage.setItem(STORAGE_KEY_LEDGER, JSON.stringify(ledgerRecords));
    localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shiftRecords));
    localStorage.setItem(STORAGE_KEY_SESSIONS, JSON.stringify(deliverySessions));
    localStorage.setItem(STORAGE_KEY_CONFIG, JSON.stringify(deliveryConfig));
    
    const txt = document.getElementById('save-status-text');
    if (txt) {
      txt.innerText = 'Saved ' + new Date().toLocaleTimeString();
      setTimeout(() => txt.innerText = 'Auto-saved to browser', 2500);
    }
  }

  // Currency
  function initCurrency() {
    const sel = document.getElementById('global-currency-select');
    if (sel) {
      sel.value = currentCurrency;
      sel.addEventListener('change', (e) => {
        currentCurrency = e.target.value;
        saveData();
        updateSymbols();
        renderAll();
      });
    }
    updateSymbols();
  }

  function updateSymbols() {
    document.querySelectorAll('.curr-sym').forEach(el => el.innerText = currentCurrency);
  }

  // Tabs Switcher
  function initTabs() {
    const tabBtns = document.querySelectorAll('.st-tab-btn');
    const contents = document.querySelectorAll('.st-tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        
        tabBtns.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        btn.classList.add('active');
        const targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.classList.add('active');

        if (targetId === 'view-delivery-sessions') renderDeliverySessions();
        if (targetId === 'view-money-ledger') renderLedger();
        if (targetId === 'view-daily-log') renderShifts();
      });
    });
  }

  // ================= DELIVERY SESSIONS & PAYOUT SETTLEMENT =================
  function initDeliverySessionsEngine() {
    const fleetInp = document.getElementById('cfg-fleet-percent');
    const rentInp = document.getElementById('cfg-scooter-rent');
    const fuelInp = document.getElementById('cfg-fuel-cost');

    if (fleetInp) fleetInp.value = deliveryConfig.fleetPercent;
    if (rentInp) rentInp.value = deliveryConfig.scooterRent;
    if (fuelInp) fuelInp.value = deliveryConfig.fuelCost;

    const cfgInputs = document.querySelectorAll('.cfg-input');
    cfgInputs.forEach(inp => {
      inp.addEventListener('input', () => {
        deliveryConfig.fleetPercent = parseFloat(fleetInp.value) || 0;
        deliveryConfig.scooterRent = parseFloat(rentInp.value) || 0;
        deliveryConfig.fuelCost = parseFloat(fuelInp.value) || 0;
        saveData();
        renderDeliverySessions();
      });
    });

    const fStart = document.getElementById('filter-start-date');
    const fEnd = document.getElementById('filter-end-date');
    if (fStart && fEnd) {
      fStart.addEventListener('change', renderDeliverySessions);
      fEnd.addEventListener('change', renderDeliverySessions);
    }

    const addSessBtn = document.getElementById('btn-add-session');
    if (addSessBtn) {
      addSessBtn.addEventListener('click', () => {
        const name = document.getElementById('sess-rider-name').value.trim() || 'Rider';
        const date = document.getElementById('sess-date').value;
        const startTime = document.getElementById('sess-start-time').value;
        const endTime = document.getElementById('sess-end-time').value;
        const appGross = parseFloat(document.getElementById('sess-app-gross').value) || 0;
        const cashTips = parseFloat(document.getElementById('sess-cash-tips').value) || 0;

        if (appGross <= 0) {
          alert('Please enter a valid App Gross amount.');
          return;
        }

        deliverySessions.unshift({
          id: 'ds_' + Date.now(),
          name,
          date,
          startTime,
          endTime,
          appGross,
          cashTips
        });

        saveData();
        renderDeliverySessions();

        document.getElementById('sess-app-gross').value = '';
        document.getElementById('sess-cash-tips').value = '0';
      });
    }

    const copyBtn = document.getElementById('btn-copy-delivery-summary');
    if (copyBtn) copyBtn.addEventListener('click', copyDeliverySummaryText);
  }

  function getFilteredSessions() {
    const fStart = document.getElementById('filter-start-date').value;
    const fEnd = document.getElementById('filter-end-date').value;

    return deliverySessions.filter(s => {
      if (fStart && s.date < fStart) return false;
      if (fEnd && s.date > fEnd) return false;
      return true;
    });
  }

  function renderDeliverySessions() {
    const tbody = document.getElementById('delivery-sessions-tbody');
    const emptyMsg = document.getElementById('no-sessions-msg');
    const countBadge = document.getElementById('session-count-badge');
    const settlementList = document.getElementById('cycle-rider-settlement-list');

    const filtered = getFilteredSessions();
    if (countBadge) countBadge.innerText = `${filtered.length} Sessions (In Cycle)`;

    let totalAppGross = 0;
    filtered.forEach(s => totalAppGross += s.appGross);

    const totalFleetCut = (totalAppGross * deliveryConfig.fleetPercent) / 100;
    const totalSharedExpenses = deliveryConfig.scooterRent + deliveryConfig.fuelCost;
    const totalNetDistributed = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    // Update Overview Stats
    document.getElementById('stat-cycle-gross').innerText = totalAppGross.toFixed(2);
    document.getElementById('stat-cycle-fleet').innerText = totalFleetCut.toFixed(2);
    document.getElementById('stat-cycle-fleet-pct').innerText = `${deliveryConfig.fleetPercent}% fleet cut`;
    document.getElementById('stat-cycle-expenses').innerText = totalSharedExpenses.toFixed(2);
    document.getElementById('stat-cycle-net').innerText = totalNetDistributed.toFixed(2);

    // 1. Group by Rider for Pay Day Settlement
    const riderMap = {};
    filtered.forEach(s => {
      if (!riderMap[s.name]) {
        riderMap[s.name] = {
          name: s.name,
          sessionCount: 0,
          gross: 0,
          tips: 0
        };
      }
      riderMap[s.name].sessionCount += 1;
      riderMap[s.name].gross += s.appGross;
      riderMap[s.name].tips += (s.cashTips || 0);
    });

    if (settlementList) {
      settlementList.innerHTML = '';
      const riderNames = Object.keys(riderMap);

      if (riderNames.length === 0) {
        settlementList.innerHTML = `<div class="st-empty-msg">No shift sessions logged in this withdrawal window.</div>`;
      } else {
        riderNames.forEach(rName => {
          const r = riderMap[rName];
          const ratio = totalAppGross > 0 ? (r.gross / totalAppGross) : (1 / riderNames.length);
          const rFleetShare = (r.gross * deliveryConfig.fleetPercent) / 100;
          const rExpenseShare = totalSharedExpenses * ratio;
          const rNetBankPayout = Math.max(0, r.gross - rFleetShare - rExpenseShare);
          const rTotalMoney = rNetBankPayout + r.tips;

          const card = document.createElement('div');
          card.className = 'st-rider-settlement-card';
          card.innerHTML = `
            <div class="sr-head">
              <div>
                <h4 class="sr-name">👤 ${r.name}</h4>
                <span class="sr-badge">${r.sessionCount} Sessions Completed (${(ratio * 100).toFixed(1)}% share)</span>
              </div>
              <div class="sr-payout-box">
                <span class="sr-payout-val">${currentCurrency}${rNetBankPayout.toFixed(2)}</span>
                <span class="sr-payout-lbl">Net Bank / Cash Payout</span>
              </div>
            </div>

            <div class="sr-grid-breakdown">
              <div class="sr-col">
                <small>App Gross:</small>
                <strong>${currentCurrency}${r.gross.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-red-txt">
                <small>Fleet Cut (${deliveryConfig.fleetPercent}%):</small>
                <strong>-${currentCurrency}${rFleetShare.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-red-txt">
                <small>Rent & Fuel Share:</small>
                <strong>-${currentCurrency}${rExpenseShare.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-green-txt">
                <small>Cash Tips (Kept in Pocket):</small>
                <strong>+${currentCurrency}${r.tips.toFixed(2)}</strong>
              </div>
              <div class="sr-col sr-total-col">
                <small>Total Take-Home (App + Tips):</small>
                <strong>${currentCurrency}${rTotalMoney.toFixed(2)}</strong>
              </div>
            </div>
          `;
          settlementList.appendChild(card);
        });
      }
    }

    // 2. Render Individual Sessions Table
    if (tbody) {
      tbody.innerHTML = '';
      if (filtered.length === 0) {
        if (emptyMsg) emptyMsg.style.display = 'block';
      } else {
        if (emptyMsg) emptyMsg.style.display = 'none';

        filtered.forEach((sess) => {
          const ratio = totalAppGross > 0 ? (sess.appGross / totalAppGross) : 0;
          const riderFleetCut = (sess.appGross * deliveryConfig.fleetPercent) / 100;
          const riderExpenseShare = totalSharedExpenses * ratio;
          const riderNetApp = Math.max(0, sess.appGross - riderFleetCut - riderExpenseShare);

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong>${sess.date}</strong></td>
            <td><strong>${sess.name}</strong></td>
            <td><span class="st-tag-time">⏰ ${sess.startTime} - ${sess.endTime}</span></td>
            <td>${currentCurrency}${sess.appGross.toFixed(2)}</td>
            <td class="st-red-txt">-${currentCurrency}${riderFleetCut.toFixed(2)}</td>
            <td class="st-red-txt">-${currentCurrency}${riderExpenseShare.toFixed(2)}</td>
            <td class="st-green-txt">+${currentCurrency}${(sess.cashTips || 0).toFixed(2)}</td>
            <td class="st-amount-inc"><strong>${currentCurrency}${riderNetApp.toFixed(2)}</strong></td>
            <td><button type="button" class="st-btn-del" title="Delete Session">✕</button></td>
          `;

          tr.querySelector('.st-btn-del').addEventListener('click', () => {
            if (confirm(`Delete shift session for ${sess.name} on ${sess.date}?`)) {
              const origIdx = deliverySessions.findIndex(x => x.id === sess.id);
              if (origIdx !== -1) {
                deliverySessions.splice(origIdx, 1);
                saveData();
                renderDeliverySessions();
              }
            }
          });

          tbody.appendChild(tr);
        });
      }
    }
  }

  function copyDeliverySummaryText() {
    const fStart = document.getElementById('filter-start-date').value;
    const fEnd = document.getElementById('filter-end-date').value;
    const filtered = getFilteredSessions();

    let totalAppGross = 0;
    filtered.forEach(s => totalAppGross += s.appGross);

    const totalFleetCut = (totalAppGross * deliveryConfig.fleetPercent) / 100;
    const totalSharedExpenses = deliveryConfig.scooterRent + deliveryConfig.fuelCost;
    const totalNetDistributed = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    const riderMap = {};
    filtered.forEach(s => {
      if (!riderMap[s.name]) {
        riderMap[s.name] = { name: s.name, count: 0, gross: 0, tips: 0 };
      }
      riderMap[s.name].count += 1;
      riderMap[s.name].gross += s.appGross;
      riderMap[s.name].tips += (s.cashTips || 0);
    });

    let text = `🏦 *Cyprus Food Delivery Payout Settlement Statement*\n`;
    text += `📅 Pay Cycle: ${fStart} to ${fEnd}\n`;
    text += `📱 App Gross Total: ${currentCurrency}${totalAppGross.toFixed(2)}\n`;
    text += `📑 Fleet Commission (${deliveryConfig.fleetPercent}%): -${currentCurrency}${totalFleetCut.toFixed(2)}\n`;
    text += `⛽ Vehicle Rent & Fuel: -${currentCurrency}${totalSharedExpenses.toFixed(2)}\n`;
    text += `💵 Distributable Bank Pool: ${currentCurrency}${totalNetDistributed.toFixed(2)}\n`;
    text += `------------------------------------\n`;
    text += `*FINAL RIDER PAYOUTS (TO RECEIVE):*\n\n`;

    Object.keys(riderMap).forEach(rName => {
      const r = riderMap[rName];
      const ratio = totalAppGross > 0 ? (r.gross / totalAppGross) : 0;
      const rFleet = (r.gross * deliveryConfig.fleetPercent) / 100;
      const rExp = totalSharedExpenses * ratio;
      const rNet = Math.max(0, r.gross - rFleet - rExp);

      text += `👤 *${r.name}* (${r.count} sessions):\n`;
      text += `   • App Gross: ${currentCurrency}${r.gross.toFixed(2)}\n`;
      text += `   • Deductions (Fleet+Rent+Fuel): -${currentCurrency}${(rFleet + rExp).toFixed(2)}\n`;
      text += `   👉 *NET BANK PAYOUT: ${currentCurrency}${rNet.toFixed(2)}*\n`;
      if (r.tips > 0) text += `   (Plus cash tips kept in hand: +${currentCurrency}${r.tips.toFixed(2)})\n\n`;
    });

    text += `------------------------------------\nCalculated accurately via CyprusStudentGuide.com`;

    navigator.clipboard.writeText(text).then(() => {
      const fb = document.getElementById('delivery-copy-feedback');
      if (fb) {
        fb.style.display = 'inline';
        setTimeout(() => fb.style.display = 'none', 3000);
      }
    });
  }

  // ================= LEDGER & HOURLY SHIFTS =================
  function initLedgerEngine() {
    const btnExp = document.getElementById('btn-type-expense');
    const btnInc = document.getElementById('btn-type-income');
    const catSelect = document.getElementById('trans-category');

    if (btnExp && btnInc) {
      btnExp.addEventListener('click', () => {
        currentTransType = 'expense';
        btnExp.classList.add('active-exp');
        btnInc.classList.remove('active-inc');
        catSelect.value = 'Groceries & Food';
      });

      btnInc.addEventListener('click', () => {
        currentTransType = 'income';
        btnInc.classList.add('active-inc');
        btnExp.classList.remove('active-exp');
        catSelect.value = 'Work Wages / Salary';
      });
    }

    const monthFilter = document.getElementById('ledger-month-filter');
    if (monthFilter) monthFilter.addEventListener('change', renderLedger);

    const btnSave = document.getElementById('btn-save-transaction');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('trans-date').value;
        const category = document.getElementById('trans-category').value;
        const desc = document.getElementById('trans-desc').value.trim() || category;
        const amount = parseFloat(document.getElementById('trans-amount').value) || 0;

        if (amount <= 0) {
          alert('Please enter a valid amount.');
          return;
        }

        ledgerRecords.unshift({
          id: 'tx_' + Date.now(),
          date,
          type: currentTransType,
          category,
          desc,
          amount,
          currency: currentCurrency
        });

        saveData();
        renderLedger();

        document.getElementById('trans-desc').value = '';
        document.getElementById('trans-amount').value = '';
      });
    }
  }

  function renderLedger() {
    const tbody = document.getElementById('ledger-tbody');
    const emptyMsg = document.getElementById('no-ledger-msg');
    const selectedMonth = document.getElementById('ledger-month-filter').value;
    const monthDisplay = document.getElementById('current-month-display');

    if (monthDisplay && selectedMonth) {
      const [year, month] = selectedMonth.split('-');
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      monthDisplay.innerText = `${monthNames[parseInt(month)-1]} ${year} Report`;
    }

    if (!tbody) return;
    tbody.innerHTML = '';
    const filtered = ledgerRecords.filter(item => item.date.startsWith(selectedMonth));

    let totalIncome = 0;
    let totalExpense = 0;

    if (filtered.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      filtered.forEach((item) => {
        if (item.type === 'income') totalIncome += item.amount;
        else totalExpense += item.amount;

        const isInc = item.type === 'income';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td><span class="st-badge-${item.type}">${isInc ? '💚 Income' : '🔻 Expense'}</span></td>
          <td>${item.category}</td>
          <td>${item.desc}</td>
          <td class="${isInc ? 'st-amount-inc' : 'st-amount-exp'}">
            ${isInc ? '+' : '-'}${currentCurrency}${item.amount.toFixed(2)}
          </td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this entry?')) {
            const idx = ledgerRecords.findIndex(r => r.id === item.id);
            if (idx !== -1) {
              ledgerRecords.splice(idx, 1);
              saveData();
              renderLedger();
            }
          }
        });

        tbody.appendChild(tr);
      });
    }

    const netBalance = totalIncome - totalExpense;
    document.getElementById('stat-ledger-income').innerText = totalIncome.toFixed(2);
    document.getElementById('stat-ledger-expense').innerText = totalExpense.toFixed(2);
    
    const netEl = document.getElementById('stat-ledger-net');
    const netStatus = document.getElementById('stat-ledger-status');
    netEl.innerText = (netBalance >= 0 ? '+' : '') + netBalance.toFixed(2);

    if (netBalance >= 0) {
      netEl.style.color = '#10b981';
      netStatus.innerText = '✅ Monthly Surplus';
    } else {
      netEl.style.color = '#ef4444';
      netStatus.innerText = '⚠️ Monthly Deficit';
    }

    document.getElementById('stat-ledger-count').innerText = filtered.length;
  }

  function initShiftsEngine() {
    const btnSave = document.getElementById('btn-save-shift');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('shift-date').value;
        const job = document.getElementById('shift-job').value.trim() || 'General Shift';
        const hours = parseFloat(document.getElementById('shift-hours').value) || 0;
        const rate = parseFloat(document.getElementById('shift-rate').value) || 0;
        const tips = parseFloat(document.getElementById('shift-tips').value) || 0;

        if (hours <= 0) {
          alert('Please enter valid working hours.');
          return;
        }

        shiftRecords.unshift({
          id: 'shift_' + Date.now(),
          date,
          job,
          hours,
          rate,
          tips,
          totalEarned: (hours * rate) + tips
        });

        saveData();
        renderShifts();

        document.getElementById('shift-hours').value = '';
        document.getElementById('shift-tips').value = '0';
      });
    }
  }

  function renderShifts() {
    const tbody = document.getElementById('shifts-tbody');
    const emptyMsg = document.getElementById('no-data-msg');
    if (!tbody) return;

    tbody.innerHTML = '';
    if (shiftRecords.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      shiftRecords.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td>${item.job}</td>
          <td>${item.hours} hrs</td>
          <td>${currentCurrency}${item.rate.toFixed(2)}/hr</td>
          <td>${currentCurrency}${item.tips.toFixed(2)}</td>
          <td class="st-amount-inc">${currentCurrency}${item.totalEarned.toFixed(2)}</td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this shift?')) {
            shiftRecords.splice(index, 1);
            saveData();
            renderShifts();
          }
        });

        tbody.appendChild(tr);
      });
    }

    let totalHours = 0;
    let totalEarned = 0;
    shiftRecords.forEach(s => {
      totalHours += s.hours;
      totalEarned += s.totalEarned;
    });

    document.getElementById('stat-total-hours').innerText = totalHours.toFixed(1);
    document.getElementById('stat-total-earned').innerText = totalEarned.toFixed(2);
    document.getElementById('stat-avg-rate').innerText = totalHours > 0 ? (totalEarned / totalHours).toFixed(2) : '0.00';
  }

  // Backup
  function initBackupEngine() {
    document.getElementById('btn-export-csv').addEventListener('click', () => {
      let csv = "=== FOOD DELIVERY SHIFT SESSIONS ===\nDate,Rider,StartTime,EndTime,AppGross,CashTips,Currency\n";
      deliverySessions.forEach(d => {
        csv += `"${d.date}","${d.name}","${d.startTime}","${d.endTime}",${d.appGross},${d.cashTips},"${currentCurrency}"\n`;
      });

      csv += "\n=== DAILY INCOME & EXPENSE LEDGER ===\nDate,Type,Category,Description,Amount,Currency\n";
      ledgerRecords.forEach(i => {
        csv += `"${i.date}","${i.type}","${i.category}","${i.desc.replace(/"/g, '""')}",${i.amount},"${currentCurrency}"\n`;
      });

      csv += "\n=== WORK SHIFTS ===\nDate,Workplace,Hours,Rate,Tips,Total,Currency\n";
      shiftRecords.forEach(s => {
        csv += `"${s.date}","${s.job.replace(/"/g, '""')}",${s.hours},${s.rate},${s.tips},${s.totalEarned},"${currentCurrency}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Student_Delivery_And_Money_Log_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('btn-export-json').addEventListener('click', () => {
      const backup = {
        version: "5.0",
        currency: currentCurrency,
        ledger: ledgerRecords,
        shifts: shiftRecords,
        deliverySessions: deliverySessions,
        deliveryConfig: deliveryConfig
      };

      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Student_Shift_Backup_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('file-restore-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.ledger || parsed.shifts || parsed.deliverySessions) {
            if (parsed.currency) currentCurrency = parsed.currency;
            if (parsed.ledger) ledgerRecords = parsed.ledger;
            if (parsed.shifts) shiftRecords = parsed.shifts;
            if (parsed.deliverySessions) deliverySessions = parsed.deliverySessions;
            if (parsed.deliveryConfig) deliveryConfig = parsed.deliveryConfig;

            saveData();
            initCurrency();
            renderAll();
            alert('✅ Complete backup restored successfully!');
          }
        } catch (err) {
          alert('Invalid backup file format.');
        }
      };
      reader.readAsText(file);
    });

    document.getElementById('btn-clear-all').addEventListener('click', () => {
      if (confirm('Are you sure you want to reset all data? Download an Excel or JSON backup first!')) {
        ledgerRecords = [];
        shiftRecords = [];
        deliverySessions = [];
        saveData();
        renderAll();
      }
    });
  }

  function renderAll() {
    renderDeliverySessions();
    renderLedger();
    renderShifts();
  }
</script>

