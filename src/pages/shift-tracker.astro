<!-- Firebase Browser Bundle -->
<script is:inline type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
  import { getFirestore, doc, onSnapshot, setDoc } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-firestore.js";
  import { 
    getAuth, 
    setPersistence,
    indexedDBLocalPersistence,
    browserLocalPersistence,
    signInWithPopup, 
    GoogleAuthProvider, 
    signOut, 
    onAuthStateChanged 
  } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBnLArPDFIG6Kr9OtkoCzhdFBHMbgzK8k0",
    authDomain: "cyprusstudentguidelogin.firebaseapp.com",
    projectId: "cyprusstudentguidelogin",
    storageBucket: "cyprusstudentguidelogin.firebasestorage.app",
    messagingSenderId: "215797465320",
    appId: "1:215797465320:web:afad34a9c5aa686772c95d",
    measurementId: "G-1RWQEC5L8D"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);
  const auth = getAuth(app);
  const provider = new GoogleAuthProvider();

  // Mobile IndexedDB Persistence
  setPersistence(auth, indexedDBLocalPersistence).catch(() => {
    setPersistence(auth, browserLocalPersistence).catch(console.warn);
  });

  // Storage Keys
  const STORAGE_KEY_CURRENCY = 'csg_user_currency';
  const STORAGE_KEY_LEDGER = 'csg_daily_ledger_data';
  const STORAGE_KEY_SHIFTS = 'csg_student_shifts_data';
  const STORAGE_KEY_SESSIONS = 'csg_delivery_sessions_data';
  const STORAGE_KEY_CONFIG = 'csg_delivery_config_data';
  const STORAGE_KEY_EXPENSES = 'csg_delivery_custom_expenses_data';
  const STORAGE_KEY_ACTIVE_ROOM = 'csg_active_sync_room';

  // State
  let currentCurrency = '€';
  let currentTransType = 'expense';
  let currentActiveTab = 'view-delivery-sessions';
  let ledgerRecords = [];
  let shiftRecords = [];
  let deliverySessions = [];
  let deliveryCustomExpenses = [];
  let deliveryConfig = { fleetPercent: 18.0 };

  let activeSyncRoom = null;
  let currentUser = null;
  let unsubscribeSnapshot = null;
  let isReceivingRemoteUpdate = false;

  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const currentMonth = today.substring(0, 7);

    const sDate = document.getElementById('sess-date');
    if (sDate) sDate.value = today;

    const tDate = document.getElementById('trans-date');
    if (tDate) tDate.value = today;

    const shDate = document.getElementById('shift-date');
    if (shDate) shDate.value = today;

    const mFilter = document.getElementById('ledger-month-filter');
    if (mFilter) mFilter.value = currentMonth;

    const fStart = document.getElementById('filter-start-date');
    const fEnd = document.getElementById('filter-end-date');
    if (fStart) fStart.value = `${currentMonth}-01`;
    if (fEnd) fEnd.value = today;

    loadData();
    initCurrency();
    initTabs();
    initDeliverySessionsEngine();
    initLedgerEngine();
    initShiftsEngine();
    initBackupEngine();
    initIsolatedTabClearing();
    initRealtimeSyncHub();
    renderAll();

    const urlParams = new URLSearchParams(window.location.search);
    const roomParam = urlParams.get('room');
    if (roomParam) {
      connectToRoom(roomParam.toUpperCase());
    }
  });

  function loadData() {
    try {
      const c = localStorage.getItem(STORAGE_KEY_CURRENCY);
      if (c) currentCurrency = c;

      const l = localStorage.getItem(STORAGE_KEY_LEDGER);
      if (l) ledgerRecords = JSON.parse(l);

      const s = localStorage.getItem(STORAGE_KEY_SHIFTS);
      if (s) shiftRecords = JSON.parse(s);

      const ds = localStorage.getItem(STORAGE_KEY_SESSIONS);
      if (ds) deliverySessions = JSON.parse(ds);

      const exp = localStorage.getItem(STORAGE_KEY_EXPENSES);
      if (exp) deliveryCustomExpenses = JSON.parse(exp);

      const cfg = localStorage.getItem(STORAGE_KEY_CONFIG);
      if (cfg) deliveryConfig = JSON.parse(cfg);

      const room = localStorage.getItem(STORAGE_KEY_ACTIVE_ROOM);
      if (room) activeSyncRoom = room;
    } catch (e) {
      console.warn('Storage read error:', e);
    }
  }

  function saveData(pushToCloud = true) {
    localStorage.setItem(STORAGE_KEY_CURRENCY, currentCurrency);
    localStorage.setItem(STORAGE_KEY_LEDGER, JSON.stringify(ledgerRecords));
    localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shiftRecords));
    localStorage.setItem(STORAGE_KEY_SESSIONS, JSON.stringify(deliverySessions));
    localStorage.setItem(STORAGE_KEY_EXPENSES, JSON.stringify(deliveryCustomExpenses));
    localStorage.setItem(STORAGE_KEY_CONFIG, JSON.stringify(deliveryConfig));
    
    const txt = document.getElementById('save-status-text');
    if (txt) {
      txt.innerText = 'Saved ' + new Date().toLocaleTimeString();
      setTimeout(() => txt.innerText = 'Auto-saved to browser', 2500);
    }

    if (pushToCloud && !isReceivingRemoteUpdate) {
      syncStateToCloud();
    }
  }

  // ================= REALTIME CLOUD & AUTH =================
  function initRealtimeSyncHub() {
    const modal = document.getElementById('room-sync-modal');
    const openModalBtn = document.getElementById('btn-open-room-modal');
    const closeModalBtn = document.getElementById('btn-close-modal');
    const createRoomBtn = document.getElementById('btn-create-room');
    const joinRoomBtn = document.getElementById('btn-join-room');
    const joinRoomInput = document.getElementById('join-room-input');
    const googleAuthBtn = document.getElementById('btn-google-auth');
    const disconnectBtn = document.getElementById('btn-disconnect-sync');

    if (openModalBtn) openModalBtn.addEventListener('click', () => modal.classList.add('active'));
    if (closeModalBtn) closeModalBtn.addEventListener('click', () => modal.classList.remove('active'));

    // Create Room
    if (createRoomBtn) {
      createRoomBtn.addEventListener('click', () => {
        const randCode = 'CY-' + Math.floor(1000 + Math.random() * 9000);
        modal.classList.remove('active');
        connectToRoom(randCode);
      });
    }

    // Join Room
    if (joinRoomBtn) {
      joinRoomBtn.addEventListener('click', () => {
        const code = joinRoomInput.value.trim().toUpperCase();
        if (!code || code.length < 4) {
          alert('Please enter a valid room code (e.g. CY-8824)');
          return;
        }
        modal.classList.remove('active');
        connectToRoom(code);
      });
    }

    // Direct Universal Popup Sign-In
    if (googleAuthBtn) {
      googleAuthBtn.addEventListener('click', async () => {
        if (currentUser) return;
        provider.setCustomParameters({ prompt: 'select_account' });

        try {
          const res = await signInWithPopup(auth, provider);
          currentUser = res.user;
          setupUserCloudSync(currentUser.uid, currentUser.displayName || currentUser.email);
        } catch (err) {
          console.error("Sign-In Error:", err);
          if (err.code !== 'auth/popup-closed-by-user') {
            alert('Sign-In: ' + (err.message || 'Please try again'));
          }
        }
      });
    }

    // Disconnect Sync
    if (disconnectBtn) {
      disconnectBtn.addEventListener('click', async () => {
        if (confirm('Disconnect live sync and return to local offline mode?')) {
          if (unsubscribeSnapshot) unsubscribeSnapshot();
          activeSyncRoom = null;
          currentUser = null;
          localStorage.removeItem(STORAGE_KEY_ACTIVE_ROOM);
          try { await signOut(auth); } catch(e){}
          updateSyncUI();
          renderAll();
        }
      });
    }

    // Auth State Listener
    onAuthStateChanged(auth, (user) => {
      currentUser = user;
      if (user) {
        setupUserCloudSync(user.uid, user.displayName || user.email);
      } else if (activeSyncRoom) {
        connectToRoom(activeSyncRoom);
      } else {
        updateSyncUI();
      }
    });
  }

  function connectToRoom(roomCode) {
    if (unsubscribeSnapshot) unsubscribeSnapshot();
    activeSyncRoom = roomCode;
    localStorage.setItem(STORAGE_KEY_ACTIVE_ROOM, roomCode);

    const docRef = doc(db, "sync_rooms", roomCode);
    syncStateToCloud();

    unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const remote = docSnap.data();
        applyRemoteData(remote);
      }
    }, (err) => console.warn("Room listener:", err));

    updateSyncUI();
  }

  function setupUserCloudSync(uid, displayName) {
    if (unsubscribeSnapshot) unsubscribeSnapshot();
    activeSyncRoom = null;
    localStorage.removeItem(STORAGE_KEY_ACTIVE_ROOM);

    const docRef = doc(db, "user_profiles", uid);
    syncStateToCloud();

    unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
      if (docSnap.exists()) {
        const remote = docSnap.data();
        applyRemoteData(remote);
      }
    }, (err) => console.warn("User listener:", err));

    updateSyncUI();
  }

  function syncStateToCloud() {
    if (!activeSyncRoom && !currentUser) return;

    const payload = {
      updatedAt: Date.now(),
      currency: currentCurrency,
      deliverySessions,
      deliveryCustomExpenses,
      deliveryConfig,
      ledgerRecords,
      shiftRecords
    };

    if (activeSyncRoom) {
      setDoc(doc(db, "sync_rooms", activeSyncRoom), payload, { merge: true }).catch(console.warn);
    } else if (currentUser) {
      setDoc(doc(db, "user_profiles", currentUser.uid), payload, { merge: true }).catch(console.warn);
    }
  }

  function applyRemoteData(remote) {
    if (!remote) return;
    isReceivingRemoteUpdate = true;

    if (remote.currency) currentCurrency = remote.currency;
    if (remote.deliverySessions) deliverySessions = remote.deliverySessions;
    if (remote.deliveryCustomExpenses) deliveryCustomExpenses = remote.deliveryCustomExpenses;
    if (remote.deliveryConfig) deliveryConfig = remote.deliveryConfig;
    if (remote.ledgerRecords) ledgerRecords = remote.ledgerRecords;
    if (remote.shiftRecords) shiftRecords = remote.shiftRecords;

    saveData(false);
    initCurrency();
    renderAll();

    isReceivingRemoteUpdate = false;
  }

  function updateSyncUI() {
    const titleEl = document.getElementById('sync-status-title');
    const descEl = document.getElementById('sync-status-desc');
    const dotEl = document.getElementById('sync-dot');
    const googleBtn = document.getElementById('btn-google-auth');
    const googleTxt = document.getElementById('google-btn-text');
    const roomBtn = document.getElementById('btn-open-room-modal');
    const disBtn = document.getElementById('btn-disconnect-sync');

    if (activeSyncRoom) {
      dotEl.className = 'st-pulse-dot dot-live';
      titleEl.innerHTML = `🟢 Live Room Connected: <strong>${activeSyncRoom}</strong>`;
      descEl.innerHTML = `Multi-device live sync active. Share code <strong>${activeSyncRoom}</strong> or link: <a href="?room=${activeSyncRoom}" target="_blank" style="color:var(--primary-blue); font-weight:700;">Invite Link</a>`;
      roomBtn.innerText = `Room: ${activeSyncRoom}`;
      disBtn.style.display = 'inline-flex';
      googleBtn.style.display = 'none';
    } else if (currentUser) {
      dotEl.className = 'st-pulse-dot dot-live';
      titleEl.innerHTML = `🟢 Google Cloud Synced: <strong>${currentUser.displayName || currentUser.email}</strong>`;
      descEl.innerText = `Personal cloud backup active across all your logged-in phones and laptops.`;
      googleTxt.innerText = `Account: ${currentUser.displayName ? currentUser.displayName.split(' ')[0] : 'Connected'}`;
      disBtn.style.display = 'inline-flex';
      roomBtn.style.display = 'none';
    } else {
      dotEl.className = 'st-pulse-dot dot-offline';
      titleEl.innerText = 'Mode: Local Offline Storage';
      descEl.innerText = 'Data is saved locally in this browser. Connect a room or Google account to sync live across devices.';
      googleTxt.innerText = 'Google Cloud Sync';
      roomBtn.innerText = '📡 Live Room Code';
      disBtn.style.display = 'none';
      googleBtn.style.display = 'inline-flex';
      roomBtn.style.display = 'inline-flex';
    }
  }

  // Load Demo Data
  function loadDemoData() {
    const today = new Date().toISOString().split('T')[0];
    deliverySessions = [
      { id: 'ds_1', name: 'Saidur', date: today, startTime: '11:00', endTime: '14:00', appGross: 25.0, cashTips: 2.0, status: 'pending' },
      { id: 'ds_2', name: 'Tanvir', date: today, startTime: '14:30', endTime: '17:30', appGross: 35.0, cashTips: 4.0, status: 'pending' },
      { id: 'ds_3', name: 'Saidur', date: today, startTime: '18:30', endTime: '22:00', appGross: 45.0, cashTips: 5.0, status: 'pending' }
    ];
    deliveryCustomExpenses = [
      { id: 'exp_1', name: 'Scooter / Bike Rent', amount: 15.0 },
      { id: 'exp_2', name: 'Petrol / Fuel', amount: 10.0 }
    ];
    saveData();
    renderAll();
  }

  // 1. Currency Picker
  function initCurrency() {
    const sel = document.getElementById('global-currency-select');
    if (sel) {
      sel.value = currentCurrency;
      sel.addEventListener('change', (e) => {
        currentCurrency = e.target.value;
        saveData();
        updateSymbols();
        renderAll();
      });
    }
    updateSymbols();
  }

  function updateSymbols() {
    document.querySelectorAll('.curr-sym').forEach(el => el.innerText = currentCurrency);
  }

  // 2. Tabs Switcher
  function initTabs() {
    const tabBtns = document.querySelectorAll('.st-tab-btn');
    const contents = document.querySelectorAll('.st-tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        currentActiveTab = targetId;
        
        tabBtns.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        btn.classList.add('active');
        const targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.classList.add('active');

        if (targetId === 'view-delivery-sessions') renderDeliverySessions();
        if (targetId === 'view-money-ledger') renderLedger();
        if (targetId === 'view-daily-log') renderShifts();
      });
    });
  }

  // ================= 3. ISOLATED TAB RESET ENGINE =================
  function initIsolatedTabClearing() {
    const clearDelBtn = document.getElementById('btn-clear-delivery-tab');
    if (clearDelBtn) {
      clearDelBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear all Food Delivery Shifts and Expenses only? (Your Daily Ledger and Work Shifts will stay safe)')) {
          deliverySessions = [];
          deliveryCustomExpenses = [];
          saveData();
          updateRiderSuggestions();
          renderDeliverySessions();
          alert('✅ Food Delivery data cleared successfully.');
        }
      });
    }

    const clearLedgerBtn = document.getElementById('btn-clear-ledger-tab');
    if (clearLedgerBtn) {
      clearLedgerBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear all Daily Income & Expenses records only? (Delivery and Work Shifts will stay safe)')) {
          ledgerRecords = [];
          saveData();
          renderLedger();
          alert('✅ Daily Income & Expenses data cleared successfully.');
        }
      });
    }

    const clearShiftsBtn = document.getElementById('btn-clear-shifts-tab');
    if (clearShiftsBtn) {
      clearShiftsBtn.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear all Hourly Work Shifts records only?')) {
          shiftRecords = [];
          saveData();
          renderShifts();
          alert('✅ Hourly Work Shifts data cleared successfully.');
        }
      });
    }
  }

  // ================= 4. DELIVERY SESSIONS & EXPENSES ENGINE =================
  function initDeliverySessionsEngine() {
    const fleetInp = document.getElementById('cfg-fleet-percent');
    if (fleetInp) {
      fleetInp.value = deliveryConfig.fleetPercent;
      fleetInp.addEventListener('input', () => {
        deliveryConfig.fleetPercent = parseFloat(fleetInp.value) || 0;
        saveData();
        renderDeliverySessions();
      });
    }

    const demoBtnTop = document.getElementById('btn-load-demo-top');
    const demoBtnInline = document.getElementById('btn-load-demo-inline');
    if (demoBtnTop) demoBtnTop.addEventListener('click', loadDemoData);
    if (demoBtnInline) demoBtnInline.addEventListener('click', loadDemoData);

    const addExpBtn = document.getElementById('btn-add-expense-row');
    if (addExpBtn) {
      addExpBtn.addEventListener('click', () => {
        deliveryCustomExpenses.push({
          id: 'exp_' + Date.now(),
          name: '',
          amount: 0
        });
        saveData();
        renderCustomExpenses();
        renderDeliverySessions();
      });
    }

    const statusFilter = document.getElementById('filter-status-select');
    const fStart = document.getElementById('filter-start-date');
    const fEnd = document.getElementById('filter-end-date');
    if (statusFilter) statusFilter.addEventListener('change', renderDeliverySessions);
    if (fStart) fStart.addEventListener('change', renderDeliverySessions);
    if (fEnd) fEnd.addEventListener('change', renderDeliverySessions);

    const addSessBtn = document.getElementById('btn-add-session');
    if (addSessBtn) {
      addSessBtn.addEventListener('click', () => {
        const nameInput = document.getElementById('sess-rider-name');
        const name = nameInput.value.trim() || 'Rider';
        const date = document.getElementById('sess-date').value;
        const startTime = document.getElementById('sess-start-time').value;
        const endTime = document.getElementById('sess-end-time').value;
        const appGross = parseFloat(document.getElementById('sess-app-gross').value) || 0;
        const cashTips = parseFloat(document.getElementById('sess-cash-tips').value) || 0;

        if (appGross <= 0) {
          alert('Please enter a valid App Gross amount.');
          return;
        }

        deliverySessions.unshift({
          id: 'ds_' + Date.now(),
          name,
          date,
          startTime,
          endTime,
          appGross,
          cashTips,
          status: 'pending'
        });

        saveData();
        updateRiderSuggestions();
        renderDeliverySessions();

        document.getElementById('sess-app-gross').value = '';
        document.getElementById('sess-cash-tips').value = '0';
      });
    }

    const settleAllBtn = document.getElementById('btn-settle-all-pending');
    if (settleAllBtn) {
      settleAllBtn.addEventListener('click', () => {
        const filtered = getFilteredSessions();
        const pendingInView = filtered.filter(s => s.status !== 'paid');

        if (pendingInView.length === 0) {
          alert('No pending shift sessions in this view to settle.');
          return;
        }

        if (confirm(`Mark ${pendingInView.length} pending sessions as Paid & Settled?`)) {
          pendingInView.forEach(s => {
            s.status = 'paid';
          });
          saveData();
          renderDeliverySessions();
        }
      });
    }

    const copyBtn = document.getElementById('btn-copy-delivery-summary');
    if (copyBtn) copyBtn.addEventListener('click', copyDeliverySummaryText);
  }

  function renderCustomExpenses() {
    const container = document.getElementById('delivery-expenses-container');
    const totalExpLbl = document.getElementById('label-total-expenses');
    if (!container) return;

    container.innerHTML = '';
    let totalExp = 0;

    deliveryCustomExpenses.forEach((exp, idx) => {
      totalExp += (exp.amount || 0);
      const row = document.createElement('div');
      row.className = 'st-expense-row';
      row.innerHTML = `
        <div class="st-exp-name">
          <input type="text" class="st-input exp-name-input" value="${exp.name}" placeholder="Expense name (e.g. Scooter Rent, SIM, Petrol, Oil)" />
        </div>
        <div class="st-exp-amt">
          <span class="st-curr-tag">${currentCurrency}</span>
          <input type="number" class="st-input exp-amt-input" value="${exp.amount}" min="0" step="1" placeholder="0.00" />
        </div>
        <button type="button" class="st-btn-del" title="Remove this expense">✕</button>
      `;

      row.querySelector('.exp-name-input').addEventListener('input', (e) => {
        deliveryCustomExpenses[idx].name = e.target.value;
        saveData();
      });

      row.querySelector('.exp-amt-input').addEventListener('input', (e) => {
        deliveryCustomExpenses[idx].amount = parseFloat(e.target.value) || 0;
        saveData();
        renderDeliverySessions();
        updateExpenseTotalLabel();
      });

      row.querySelector('.st-btn-del').addEventListener('click', () => {
        deliveryCustomExpenses.splice(idx, 1);
        saveData();
        renderCustomExpenses();
        renderDeliverySessions();
      });

      container.appendChild(row);
    });

    if (totalExpLbl) totalExpLbl.innerText = totalExp.toFixed(2);
  }

  function updateExpenseTotalLabel() {
    let totalExp = 0;
    deliveryCustomExpenses.forEach(e => totalExp += (e.amount || 0));
    const totalExpLbl = document.getElementById('label-total-expenses');
    if (totalExpLbl) totalExpLbl.innerText = totalExp.toFixed(2);
  }

  function updateRiderSuggestions() {
    const chipsContainer = document.getElementById('rider-chips-container');
    const datalist = document.getElementById('rider-datalist');
    const nameInput = document.getElementById('sess-rider-name');

    const uniqueNames = [...new Set(deliverySessions.map(s => s.name).filter(Boolean))];

    if (datalist) {
      datalist.innerHTML = uniqueNames.map(n => `<option value="${n}"></option>`).join('');
    }

    if (chipsContainer) {
      chipsContainer.innerHTML = '';
      if (uniqueNames.length === 0) {
        chipsContainer.innerHTML = `<span class="st-hint">No recent riders yet. Enter name below.</span>`;
      } else {
        uniqueNames.forEach(name => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'st-chip-btn';
          btn.innerText = `👤 ${name}`;
          btn.addEventListener('click', () => {
            if (nameInput) {
              nameInput.value = name;
              nameInput.focus();
            }
          });
          chipsContainer.appendChild(btn);
        });
      }
    }
  }

  function getFilteredSessions() {
    const fStart = document.getElementById('filter-start-date').value;
    const fEnd = document.getElementById('filter-end-date').value;
    const statusVal = document.getElementById('filter-status-select').value;

    return deliverySessions.filter(s => {
      if (fStart && s.date < fStart) return false;
      if (fEnd && s.date > fEnd) return false;
      if (statusVal === 'pending' && s.status === 'paid') return false;
      if (statusVal === 'paid' && s.status !== 'paid') return false;
      return true;
    });
  }

  function renderDeliverySessions() {
    const tbody = document.getElementById('delivery-sessions-tbody');
    const emptyMsg = document.getElementById('no-sessions-msg');
    const countBadge = document.getElementById('session-count-badge');
    const settlementList = document.getElementById('cycle-rider-settlement-list');

    const filtered = getFilteredSessions();
    if (countBadge) countBadge.innerText = `${filtered.length} Sessions In View`;

    let totalAppGross = 0;
    filtered.forEach(s => totalAppGross += s.appGross);

    let totalSharedExpenses = 0;
    deliveryCustomExpenses.forEach(e => totalSharedExpenses += (e.amount || 0));

    const totalFleetCut = (totalAppGross * deliveryConfig.fleetPercent) / 100;
    const totalNetDistributed = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    document.getElementById('stat-cycle-gross').innerText = totalAppGross.toFixed(2);
    document.getElementById('stat-cycle-fleet').innerText = totalFleetCut.toFixed(2);
    document.getElementById('stat-cycle-fleet-pct').innerText = `${deliveryConfig.fleetPercent}% fleet cut`;
    document.getElementById('stat-cycle-expenses').innerText = totalSharedExpenses.toFixed(2);
    document.getElementById('stat-cycle-net').innerText = totalNetDistributed.toFixed(2);

    updateExpenseTotalLabel();

    const riderMap = {};
    filtered.forEach(s => {
      if (!riderMap[s.name]) {
        riderMap[s.name] = {
          name: s.name,
          sessionCount: 0,
          pendingCount: 0,
          paidCount: 0,
          gross: 0,
          tips: 0
        };
      }
      riderMap[s.name].sessionCount += 1;
      if (s.status === 'paid') riderMap[s.name].paidCount += 1;
      else riderMap[s.name].pendingCount += 1;

      riderMap[s.name].gross += s.appGross;
      riderMap[s.name].tips += (s.cashTips || 0);
    });

    if (settlementList) {
      settlementList.innerHTML = '';
      const riderNames = Object.keys(riderMap);

      if (riderNames.length === 0) {
        settlementList.innerHTML = `<div class="st-empty-msg">No shift sessions found in this filter range.</div>`;
      } else {
        riderNames.forEach(rName => {
          const r = riderMap[rName];
          const ratio = totalAppGross > 0 ? (r.gross / totalAppGross) : (1 / riderNames.length);
          const rFleetShare = (r.gross * deliveryConfig.fleetPercent) / 100;
          const rExpenseShare = totalSharedExpenses * ratio;
          const rNetBankPayout = Math.max(0, r.gross - rFleetShare - rExpenseShare);
          const rTotalMoney = rNetBankPayout + r.tips;
          const isAllPaid = r.pendingCount === 0;

          const card = document.createElement('div');
          card.className = `st-rider-settlement-card ${isAllPaid ? 'card-paid' : 'card-pending'}`;
          card.innerHTML = `
            <div class="sr-head">
              <div>
                <h4 class="sr-name">👤 ${r.name}</h4>
                <span class="sr-badge">${r.sessionCount} Shifts (${r.pendingCount} Pending, ${r.paidCount} Paid)</span>
              </div>
              <div class="sr-payout-box">
                <span class="sr-payout-val ${isAllPaid ? 'txt-paid' : 'txt-pending'}">${currentCurrency}${rNetBankPayout.toFixed(2)}</span>
                <span class="sr-payout-lbl">${isAllPaid ? '🟢 Fully Settled / Paid' : '🟡 Net Payout Due'}</span>
              </div>
            </div>

            <div class="sr-grid-breakdown">
              <div class="sr-col">
                <small>App Gross:</small>
                <strong>${currentCurrency}${r.gross.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-red-txt">
                <small>Fleet Cut (${deliveryConfig.fleetPercent}%):</small>
                <strong>-${currentCurrency}${rFleetShare.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-red-txt">
                <small>Shared Expenses Share:</small>
                <strong>-${currentCurrency}${rExpenseShare.toFixed(2)}</strong>
              </div>
              <div class="sr-col st-green-txt">
                <small>Cash Tips (Kept in Hand):</small>
                <strong>+${currentCurrency}${r.tips.toFixed(2)}</strong>
              </div>
              <div class="sr-col sr-total-col">
                <small>Total Take-Home (App + Tips):</small>
                <strong>${currentCurrency}${rTotalMoney.toFixed(2)}</strong>
              </div>
            </div>
          `;
          settlementList.appendChild(card);
        });
      }
    }

    if (tbody) {
      tbody.innerHTML = '';
      if (filtered.length === 0) {
        if (emptyMsg) emptyMsg.style.display = 'block';
      } else {
        if (emptyMsg) emptyMsg.style.display = 'none';

        filtered.forEach((sess) => {
          const ratio = totalAppGross > 0 ? (sess.appGross / totalAppGross) : 0;
          const riderFleetCut = (sess.appGross * deliveryConfig.fleetPercent) / 100;
          const riderExpenseShare = totalSharedExpenses * ratio;
          const riderNetApp = Math.max(0, sess.appGross - riderFleetCut - riderExpenseShare);
          const isPaid = sess.status === 'paid';

          const tr = document.createElement('tr');
          tr.className = isPaid ? 'tr-paid' : 'tr-pending';
          tr.innerHTML = `
            <td>
              <button type="button" class="st-status-btn ${isPaid ? 'status-paid' : 'status-pending'}" title="Click to toggle Paid/Pending">
                ${isPaid ? '🟢 Paid' : '🟡 Pending'}
              </button>
            </td>
            <td><strong>${sess.date}</strong></td>
            <td><strong>${sess.name}</strong></td>
            <td><span class="st-tag-time">⏰ ${sess.startTime} - ${sess.endTime}</span></td>
            <td>${currentCurrency}${sess.appGross.toFixed(2)}</td>
            <td class="st-red-txt">-${currentCurrency}${riderFleetCut.toFixed(2)}</td>
            <td class="st-red-txt">-${currentCurrency}${riderExpenseShare.toFixed(2)}</td>
            <td class="st-green-txt">+${currentCurrency}${(sess.cashTips || 0).toFixed(2)}</td>
            <td class="st-amount-inc"><strong>${currentCurrency}${riderNetApp.toFixed(2)}</strong></td>
            <td><button type="button" class="st-btn-del" title="Delete Session">✕</button></td>
          `;

          tr.querySelector('.st-status-btn').addEventListener('click', () => {
            sess.status = sess.status === 'paid' ? 'pending' : 'paid';
            saveData();
            renderDeliverySessions();
          });

          tr.querySelector('.st-btn-del').addEventListener('click', () => {
            if (confirm(`Delete shift session for ${sess.name} on ${sess.date}?`)) {
              const origIdx = deliverySessions.findIndex(x => x.id === sess.id);
              if (origIdx !== -1) {
                deliverySessions.splice(origIdx, 1);
                saveData();
                updateRiderSuggestions();
                renderDeliverySessions();
              }
            }
          });

          tbody.appendChild(tr);
        });
      }
    }
  }

  function copyDeliverySummaryText() {
    const fStart = document.getElementById('filter-start-date').value;
    const fEnd = document.getElementById('filter-end-date').value;
    const filtered = getFilteredSessions();

    let totalAppGross = 0;
    filtered.forEach(s => totalAppGross += s.appGross);

    let totalSharedExpenses = 0;
    let expDetails = [];
    deliveryCustomExpenses.forEach(e => {
      if (e.amount > 0) {
        totalSharedExpenses += e.amount;
        expDetails.push(`${e.name}: ${currentCurrency}${e.amount.toFixed(2)}`);
      }
    });

    const totalFleetCut = (totalAppGross * deliveryConfig.fleetPercent) / 100;
    const totalNetDistributed = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    const riderMap = {};
    filtered.forEach(s => {
      if (!riderMap[s.name]) {
        riderMap[s.name] = { name: s.name, count: 0, pending: 0, paid: 0, gross: 0, tips: 0 };
      }
      riderMap[s.name].count += 1;
      if (s.status === 'paid') riderMap[s.name].paid += 1;
      else riderMap[s.name].pending += 1;

      riderMap[s.name].gross += s.appGross;
      riderMap[s.name].tips += (s.cashTips || 0);
    });

    let text = `🏦 *Cyprus Food Delivery Payout Progress Statement*\n`;
    text += `📅 Settlement Window: ${fStart} to ${fEnd}\n`;
    text += `📱 App Gross Total: ${currentCurrency}${totalAppGross.toFixed(2)}\n`;
    text += `📑 Fleet Commission (${deliveryConfig.fleetPercent}%): -${currentCurrency}${totalFleetCut.toFixed(2)}\n`;
    if (expDetails.length > 0) {
      text += `⛽ Shared Expenses: -${currentCurrency}${totalSharedExpenses.toFixed(2)} (${expDetails.join(', ')})\n`;
    }
    text += `💵 Net Distributable Bank Pool: ${currentCurrency}${totalNetDistributed.toFixed(2)}\n`;
    text += `------------------------------------\n`;
    text += `*RIDER SETTLEMENT BALANCES:*\n\n`;

    Object.keys(riderMap).forEach(rName => {
      const r = riderMap[rName];
      const ratio = totalAppGross > 0 ? (r.gross / totalAppGross) : 0;
      const rFleet = (r.gross * deliveryConfig.fleetPercent) / 100;
      const rExp = totalSharedExpenses * ratio;
      const rNet = Math.max(0, r.gross - rFleet - rExp);
      const statusTxt = r.pending === 0 ? '🟢 Settled / Paid' : `🟡 Pending (${r.pending} shifts due)`;

      text += `👤 *${r.name}* [${statusTxt}]:\n`;
      text += `   • App Gross: ${currentCurrency}${r.gross.toFixed(2)} (${r.count} sessions)\n`;
      text += `   • Deductions: -${currentCurrency}${(rFleet + rExp).toFixed(2)}\n`;
      text += `   👉 *NET PAYOUT: ${currentCurrency}${rNet.toFixed(2)}*\n`;
      if (r.tips > 0) text += `   (Plus cash tips kept in hand: +${currentCurrency}${r.tips.toFixed(2)})\n\n`;
    });

    text += `------------------------------------\nCalculated & Tracked via CyprusStudentGuide.com`;

    navigator.clipboard.writeText(text).then(() => {
      const fb = document.getElementById('delivery-copy-feedback');
      if (fb) {
        fb.style.display = 'inline';
        setTimeout(() => fb.style.display = 'none', 3000);
      }
    });
  }

  // ================= 5. LEDGER & HOURLY SHIFTS =================
  function initLedgerEngine() {
    const btnExp = document.getElementById('btn-type-expense');
    const btnInc = document.getElementById('btn-type-income');
    const catSelect = document.getElementById('trans-category');

    if (btnExp && btnInc) {
      btnExp.addEventListener('click', () => {
        currentTransType = 'expense';
        btnExp.classList.add('active-exp');
        btnInc.classList.remove('active-inc');
        catSelect.value = 'Groceries & Food';
      });

      btnInc.addEventListener('click', () => {
        currentTransType = 'income';
        btnInc.classList.add('active-inc');
        btnExp.classList.remove('active-exp');
        catSelect.value = 'Work Wages / Salary';
      });
    }

    const monthFilter = document.getElementById('ledger-month-filter');
    if (monthFilter) monthFilter.addEventListener('change', renderLedger);

    const btnSave = document.getElementById('btn-save-transaction');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('trans-date').value;
        const category = document.getElementById('trans-category').value;
        const desc = document.getElementById('trans-desc').value.trim() || category;
        const amount = parseFloat(document.getElementById('trans-amount').value) || 0;

        if (amount <= 0) {
          alert('Please enter a valid amount.');
          return;
        }

        ledgerRecords.unshift({
          id: 'tx_' + Date.now(),
          date,
          type: currentTransType,
          category,
          desc,
          amount,
          currency: currentCurrency
        });

        saveData();
        renderLedger();

        document.getElementById('trans-desc').value = '';
        document.getElementById('trans-amount').value = '';
      });
    }
  }

  function renderLedger() {
    const tbody = document.getElementById('ledger-tbody');
    const emptyMsg = document.getElementById('no-ledger-msg');
    const selectedMonth = document.getElementById('ledger-month-filter').value;
    const monthDisplay = document.getElementById('current-month-display');

    if (monthDisplay && selectedMonth) {
      const [year, month] = selectedMonth.split('-');
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      monthDisplay.innerText = `${monthNames[parseInt(month)-1]} ${year} Report`;
    }

    if (!tbody) return;
    tbody.innerHTML = '';
    const filtered = ledgerRecords.filter(item => item.date.startsWith(selectedMonth));

    let totalIncome = 0;
    let totalExpense = 0;

    if (filtered.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      filtered.forEach((item) => {
        if (item.type === 'income') totalIncome += item.amount;
        else totalExpense += item.amount;

        const isInc = item.type === 'income';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td><span class="st-badge-${item.type}">${isInc ? '💚 Income' : '🔻 Expense'}</span></td>
          <td>${item.category}</td>
          <td>${item.desc}</td>
          <td class="${isInc ? 'st-amount-inc' : 'st-amount-exp'}">
            ${isInc ? '+' : '-'}${currentCurrency}${item.amount.toFixed(2)}
          </td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this entry?')) {
            const idx = ledgerRecords.findIndex(r => r.id === item.id);
            if (idx !== -1) {
              ledgerRecords.splice(idx, 1);
              saveData();
              renderLedger();
            }
          }
        });

        tbody.appendChild(tr);
      });
    }

    const netBalance = totalIncome - totalExpense;
    document.getElementById('stat-ledger-income').innerText = totalIncome.toFixed(2);
    document.getElementById('stat-ledger-expense').innerText = totalExpense.toFixed(2);
    
    const netEl = document.getElementById('stat-ledger-net');
    const netStatus = document.getElementById('stat-ledger-status');
    netEl.innerText = (netBalance >= 0 ? '+' : '') + netBalance.toFixed(2);

    if (netBalance >= 0) {
      netEl.style.color = '#10b981';
      netStatus.innerText = '✅ Monthly Surplus';
    } else {
      netEl.style.color = '#ef4444';
      netStatus.innerText = '⚠️ Monthly Deficit';
    }

    document.getElementById('stat-ledger-count').innerText = filtered.length;
  }

  function initShiftsEngine() {
    const btnSave = document.getElementById('btn-save-shift');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('shift-date').value;
        const job = document.getElementById('shift-job').value.trim() || 'General Shift';
        const hours = parseFloat(document.getElementById('shift-hours').value) || 0;
        const rate = parseFloat(document.getElementById('shift-rate').value) || 0;
        const tips = parseFloat(document.getElementById('shift-tips').value) || 0;

        if (hours <= 0) {
          alert('Please enter valid working hours.');
          return;
        }

        shiftRecords.unshift({
          id: 'shift_' + Date.now(),
          date,
          job,
          hours,
          rate,
          tips,
          totalEarned: (hours * rate) + tips
        });

        saveData();
        renderShifts();

        document.getElementById('shift-hours').value = '';
        document.getElementById('shift-tips').value = '0';
      });
    }
  }

  function renderShifts() {
    const tbody = document.getElementById('shifts-tbody');
    const emptyMsg = document.getElementById('no-data-msg');
    if (!tbody) return;

    tbody.innerHTML = '';
    if (shiftRecords.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      shiftRecords.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td>${item.job}</td>
          <td>${item.hours} hrs</td>
          <td>${currentCurrency}${item.rate.toFixed(2)}/hr</td>
          <td>${currentCurrency}${item.tips.toFixed(2)}</td>
          <td class="st-amount-inc">${currentCurrency}${item.totalEarned.toFixed(2)}</td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this shift?')) {
            shiftRecords.splice(index, 1);
            saveData();
            renderShifts();
          }
        });

        tbody.appendChild(tr);
      });
    }

    let totalHours = 0;
    let totalEarned = 0;
    shiftRecords.forEach(s => {
      totalHours += s.hours;
      totalEarned += s.totalEarned;
    });

    document.getElementById('stat-total-hours').innerText = totalHours.toFixed(1);
    document.getElementById('stat-total-earned').innerText = totalEarned.toFixed(2);
    document.getElementById('stat-avg-rate').innerText = totalHours > 0 ? (totalEarned / totalHours).toFixed(2) : '0.00';
  }

  // ================= 6. COMPLETE MULTI-SECTION AUDIT EXCEL EXPORT =================
  function initBackupEngine() {
    document.getElementById('btn-export-csv').addEventListener('click', () => {
      const todayStr = new Date().toISOString().split('T')[0];
      const fStart = document.getElementById('filter-start-date') ? document.getElementById('filter-start-date').value : todayStr;
      const fEnd = document.getElementById('filter-end-date') ? document.getElementById('filter-end-date').value : todayStr;

      let csv = "";
      let filename = "Cyprus_Student_Delivery_Settlement";

      if (currentActiveTab === 'view-delivery-sessions') {
        const filtered = getFilteredSessions();

        let totalAppGross = 0;
        filtered.forEach(s => totalAppGross += s.appGross);

        let totalSharedExpenses = 0;
        deliveryCustomExpenses.forEach(e => totalSharedExpenses += (e.amount || 0));

        const totalFleetCut = (totalAppGross * deliveryConfig.fleetPercent) / 100;
        const totalNetDistributed = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

        csv += `=== CYPRUS STUDENT GUIDE - FOOD DELIVERY PAYOUT SETTLEMENT REPORT ===\n`;
        csv += `Report Generated From:,"Cyprus Student Guide (https://cyprusstudentguide.com/shift-tracker/)"\n`;
        csv += `Export Date:,${todayStr}\n`;
        csv += `Pay Cycle Filter Range:,${fStart} to ${fEnd}\n`;
        csv += `Currency Base:,${currentCurrency}\n`;
        csv += `Fleet Commission Rate:,${deliveryConfig.fleetPercent}%\n\n`;

        csv += `--- SECTION 1: RIDER PAYOUT SETTLEMENT SUMMARY ---\n`;
        csv += `Rider Name,Total Shifts,App Gross (${currentCurrency}),Fleet Cut (${currentCurrency}),Shared Expense Share (${currentCurrency}),Cash Tips Kept (${currentCurrency}),Net Bank Payout (${currentCurrency}),Total Take-Home (${currentCurrency}),Settlement Status\n`;

        const riderMap = {};
        filtered.forEach(s => {
          if (!riderMap[s.name]) {
            riderMap[s.name] = { name: s.name, count: 0, pending: 0, paid: 0, gross: 0, tips: 0 };
          }
          riderMap[s.name].count += 1;
          if (s.status === 'paid') riderMap[s.name].paid += 1;
          else riderMap[s.name].pending += 1;

          riderMap[s.name].gross += s.appGross;
          riderMap[s.name].tips += (s.cashTips || 0);
        });

        Object.keys(riderMap).forEach(rName => {
          const r = riderMap[rName];
          const ratio = totalAppGross > 0 ? (r.gross / totalAppGross) : 0;
          const rFleet = (r.gross * deliveryConfig.fleetPercent) / 100;
          const rExp = totalSharedExpenses * ratio;
          const rNet = Math.max(0, r.gross - rFleet - rExp);
          const rTakeHome = rNet + r.tips;
          const statusTxt = r.pending === 0 ? "PAID / SETTLED" : `PENDING (${r.pending} shifts due)`;

          csv += `"${r.name.replace(/"/g, '""')}",${r.count},${r.gross.toFixed(2)},${rFleet.toFixed(2)},${rExp.toFixed(2)},${r.tips.toFixed(2)},${rNet.toFixed(2)},${rTakeHome.toFixed(2)},"${statusTxt}"\n`;
        });

        csv += `TOTALS:,${filtered.length},${totalAppGross.toFixed(2)},${totalFleetCut.toFixed(2)},${totalSharedExpenses.toFixed(2)},--,${totalNetDistributed.toFixed(2)},--,--\n\n`;

        csv += `--- SECTION 2: SHARED OPERATING EXPENSES ---\n`;
        csv += `Expense Item,Amount (${currentCurrency})\n`;
        deliveryCustomExpenses.forEach(e => {
          csv += `"${e.name.replace(/"/g, '""')}",${(e.amount || 0).toFixed(2)}\n`;
        });
        csv += `TOTAL SHARED EXPENSES:,${totalSharedExpenses.toFixed(2)}\n\n`;

        csv += `--- SECTION 3: DETAILED SHIFT SESSIONS LOG ---\n`;
        csv += `Status,Date,Rider Name,Start Time,End Time,App Gross (${currentCurrency}),Fleet Cut (${currentCurrency}),Expense Share (${currentCurrency}),Cash Tips (${currentCurrency}),Net Payout (${currentCurrency})\n`;

        filtered.forEach(sess => {
          const ratio = totalAppGross > 0 ? (sess.appGross / totalAppGross) : 0;
          const rFleet = (sess.appGross * deliveryConfig.fleetPercent) / 100;
          const rExp = totalSharedExpenses * ratio;
          const rNet = Math.max(0, sess.appGross - rFleet - rExp);

          csv += `"${(sess.status || 'pending').toUpperCase()}","${sess.date}","${sess.name.replace(/"/g, '""')}","${sess.startTime}","${sess.endTime}",${sess.appGross.toFixed(2)},${rFleet.toFixed(2)},${rExp.toFixed(2)},${(sess.cashTips || 0).toFixed(2)},${rNet.toFixed(2)}\n`;
        });

      } else if (currentActiveTab === 'view-money-ledger') {
        filename = "Daily_Money_Ledger_Report";
        csv += `=== CYPRUS STUDENT GUIDE - DAILY INCOME & EXPENSE LEDGER ===\n`;
        csv += `Website:,"https://cyprusstudentguide.com/shift-tracker/"\n`;
        csv += `Export Date:,${todayStr}\n`;
        csv += `Currency:,${currentCurrency}\n\n`;
        csv += `Date,Type,Category,Description,Amount (${currentCurrency})\n`;
        
        ledgerRecords.forEach(i => {
          csv += `"${i.date}","${i.type}","${i.category}","${i.desc.replace(/"/g, '""')}",${i.amount.toFixed(2)}\n`;
        });
      } else {
        filename = "Hourly_Work_Shifts_Report";
        csv += `=== CYPRUS STUDENT GUIDE - HOURLY WORK SHIFTS LOG ===\n`;
        csv += `Website:,"https://cyprusstudentguide.com/shift-tracker/"\n`;
        csv += `Export Date:,${todayStr}\n`;
        csv += `Currency:,${currentCurrency}\n\n`;
        csv += `Date,Workplace,Hours Worked,Hourly Rate (${currentCurrency}),Tips (${currentCurrency}),Total Earned (${currentCurrency})\n`;

        shiftRecords.forEach(s => {
          csv += `"${s.date}","${s.job.replace(/"/g, '""')}",${s.hours},${s.rate.toFixed(2)},${s.tips.toFixed(2)},${s.totalEarned.toFixed(2)}\n`;
        });
      }

      const blob = new Blob(["\uFEFF" + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${filename}_${todayStr}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('btn-export-json').addEventListener('click', () => {
      const backup = {
        version: "10.0",
        currency: currentCurrency,
        ledger: ledgerRecords,
        shifts: shiftRecords,
        deliverySessions: deliverySessions,
        deliveryCustomExpenses: deliveryCustomExpenses,
        deliveryConfig: deliveryConfig
      };

      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Student_Shift_Backup_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('file-restore-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.ledger || parsed.shifts || parsed.deliverySessions) {
            if (parsed.currency) currentCurrency = parsed.currency;
            if (parsed.ledger) ledgerRecords = parsed.ledger;
            if (parsed.shifts) shiftRecords = parsed.shifts;
            if (parsed.deliverySessions) deliverySessions = parsed.deliverySessions;
            if (parsed.deliveryCustomExpenses) deliveryCustomExpenses = parsed.deliveryCustomExpenses;
            if (parsed.deliveryConfig) deliveryConfig = parsed.deliveryConfig;

            saveData();
            initCurrency();
            renderAll();
            alert('✅ Complete settlement backup restored successfully!');
          }
        } catch (err) {
          alert('Invalid backup file format.');
        }
      };
      reader.readAsText(file);
    });
  }

  function renderAll() {
    renderCustomExpenses();
    updateRiderSuggestions();
    renderDeliverySessions();
    renderLedger();
    renderShifts();
  }
</script>
