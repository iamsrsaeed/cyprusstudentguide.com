---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cyprus Student Work Shift, Daily Ledger & Delivery Split Tracker 2026";
const description = "Track daily income & expenses, hourly jobs, and shared food delivery shifts (Wolt, Foody) with exact time slots, ID commission, vehicle rent, and fuel deductions. 100% offline auto-save with Excel export.";
const permalink = "https://cyprusstudentguide.com/shift-tracker/";

const trackerSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Daily Money & Delivery Shift Tracker",
  "url": permalink,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript and LocalStorage",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="tracker">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(trackerSchema)} />

  <div class="st-wrapper notranslate">
    <!-- Header Hero -->
    <div class="st-hero">
      <span class="st-badge">🔒 100% Private • Local Browser Storage • Excel Export</span>
      <h1 class="st-title">Student Daily Money & Delivery Shift Tracker</h1>
      <p class="st-desc">Log your personal daily finances, record hourly work shifts, or split shared food delivery earnings with exact shift time slots, ID commissions, and custom expenses.</p>
    </div>

    <!-- Control Center: Currency, Auto-save status, and Export Tools -->
    <div class="st-toolbar">
      <div class="st-tool-group">
        <label for="global-currency-select" class="st-tool-label">Currency:</label>
        <select id="global-currency-select" class="st-select-mini">
          <option value="€" selected>EUR (€)</option>
          <option value="৳">BDT (৳)</option>
          <option value="₹">INR (₹)</option>
          <option value="$">USD ($)</option>
          <option value="£">GBP (£)</option>
          <option value="₨">PKR / NPR (₨)</option>
        </select>
      </div>

      <div class="st-save-status">
        <span class="st-dot"></span>
        <span id="save-status-text">Auto-saved to browser</span>
      </div>

      <div class="st-actions-group">
        <button type="button" id="btn-export-csv" class="st-btn st-btn-green">📊 Excel (.CSV)</button>
        <button type="button" id="btn-export-json" class="st-btn st-btn-gray">💾 Save Backup</button>
        <label class="st-btn st-btn-gray st-btn-file">
          📂 Restore
          <input type="file" id="file-restore-input" accept=".json,.csv" style="display: none;" />
        </label>
        <button type="button" id="btn-clear-all" class="st-btn st-btn-red" title="Clear all local data">🗑️ Reset</button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="st-tabs">
      <button type="button" class="st-tab-btn active" data-target="view-delivery-split">
        🛵 Food Delivery Shift Splitter
      </button>
      <button type="button" class="st-tab-btn" data-target="view-money-ledger">
        💰 Daily Income & Expenses
      </button>
      <button type="button" class="st-tab-btn" data-target="view-daily-log">
        ⏱️ Hourly Work Shifts Log
      </button>
    </div>

    <!-- ================= TAB 1: REAL-WORLD DELIVERY SPLITTER ================= -->
    <div id="view-delivery-split" class="st-tab-content active">
      <div class="st-card">
        <div class="st-card-head">
          <h2 class="st-card-title">🛵 Shared Delivery Account & Shift Splitter</h2>
          <p class="st-card-sub">Record exact shift working times, specific app earnings per rider, Fleet/ID commission cuts, and custom shared expenses (Scooter rent, fuel, data, maintenance).</p>
        </div>

        <!-- Global Deductions Configuration -->
        <div class="st-grid-3">
          <div class="st-field">
            <label>Fleet / ID Account Cut:</label>
            <div class="st-input-combo">
              <select id="split-fleet-type" class="st-select calc-split-input" style="max-width: 110px;">
                <option value="percent" selected>% Cut</option>
                <option value="fixed">Fixed</option>
              </select>
              <input type="number" id="split-fleet-val" class="st-input calc-split-input" value="18" step="0.5" min="0" placeholder="18" />
            </div>
            <span class="st-hint">e.g. 18% or fixed daily rental fee</span>
          </div>

          <div class="st-field">
            <label>Shared Expense Split Mode:</label>
            <select id="split-expense-split-mode" class="st-select calc-split-input">
              <option value="proportional" selected>Proportional (Based on Earnings)</option>
              <option value="equal">Equal 50/50 Split</option>
            </select>
            <span class="st-hint">How shared rent/petrol is divided</span>
          </div>

          <div class="st-field">
            <label>Shift Date:</label>
            <input type="date" id="split-shift-date" class="st-input" />
            <span class="st-hint">Date of this delivery shift</span>
          </div>
        </div>

        <!-- Section: Dynamic Riders List with Start/End Time & Earnings -->
        <div class="st-sub-box">
          <div class="st-sub-head">
            <h3>👥 Riders on Shift (Time Slots & App Gross)</h3>
            <span class="st-tag">Multi-Rider Shift Log</span>
          </div>
          
          <div id="delivery-riders-container" class="st-riders-list">
            <!-- Dynamically populated rider cards -->
          </div>

          <button type="button" id="btn-add-delivery-rider" class="st-btn-outline">
            + Add Another Rider / Time Slot
          </button>
        </div>

        <!-- Section: Dynamic Custom Shared Expenses (Rent, Fuel, Data, Repairs) -->
        <div class="st-sub-box">
          <div class="st-sub-head">
            <h3>⛽ Shared Shift Expenses (Vehicle Rent, Fuel, Misc)</h3>
            <span class="st-tag">Custom Deductions</span>
          </div>
          
          <div id="delivery-expenses-container" class="st-expenses-list">
            <!-- Dynamically populated custom expense rows -->
          </div>

          <button type="button" id="btn-add-delivery-expense" class="st-btn-outline">
            + Add Another Custom Shared Expense
          </button>
        </div>

        <!-- Summary & Payout Distribution Output -->
        <div class="st-result-box">
          <div class="st-result-grid">
            <div class="st-res-col">
              <span>Total App Gross</span>
              <strong><span class="curr-sym">€</span><span id="res-d-gross">0.00</span></strong>
            </div>
            <div class="st-res-col st-red">
              <span>Total Fleet Cut</span>
              <strong>-<span class="curr-sym">€</span><span id="res-d-fleet">0.00</span></strong>
            </div>
            <div class="st-res-col st-red">
              <span>Shared Expenses</span>
              <strong>-<span class="curr-sym">€</span><span id="res-d-expenses">0.00</span></strong>
            </div>
            <div class="st-res-col st-green">
              <span>Net Distributable</span>
              <strong><span class="curr-sym">€</span><span id="res-d-net">0.00</span></strong>
            </div>
          </div>

          <h4 class="st-payout-heading">💵 Final Individual Payout Distribution:</h4>
          <div id="delivery-payouts-list" class="st-payout-cards">
            <!-- Calculated individual payouts -->
          </div>
        </div>

        <div class="st-foot-actions">
          <button type="button" id="btn-copy-delivery-summary" class="st-btn st-btn-primary">
            📋 Copy Shift Breakdown for WhatsApp
          </button>
          <span id="delivery-copy-feedback" class="st-feedback-msg" style="display: none;">✅ Copied to clipboard!</span>
        </div>
      </div>
    </div>

    <!-- ================= TAB 2: DAILY INCOME & EXPENSE LEDGER ================= -->
    <div id="view-money-ledger" class="st-tab-content">
      <div class="st-card">
        <div class="st-filter-row">
          <div class="st-filter-item">
            <label for="ledger-month-filter"><strong>Select Month:</strong></label>
            <input type="month" id="ledger-month-filter" class="st-input-mini" />
          </div>
          <span class="st-tag-blue" id="current-month-display">Monthly Report</span>
        </div>

        <div class="st-stats-grid">
          <div class="st-stat-card st-green">
            <span class="st-stat-lbl">Monthly Income</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-income">0.00</span></div>
            <span class="st-stat-sub">Wages & Support</span>
          </div>
          <div class="st-stat-card st-red">
            <span class="st-stat-lbl">Monthly Expenses</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-expense">0.00</span></div>
            <span class="st-stat-sub">Rent, Food & Bills</span>
          </div>
          <div class="st-stat-card st-blue">
            <span class="st-stat-lbl">Net Balance</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-ledger-net">0.00</span></div>
            <span class="st-stat-sub" id="stat-ledger-status">Net Savings</span>
          </div>
          <div class="st-stat-card">
            <span class="st-stat-lbl">Total Entries</span>
            <div class="st-stat-num" id="stat-ledger-count">0</div>
            <span class="st-stat-sub">This Month</span>
          </div>
        </div>

        <div class="st-entry-box">
          <h3 class="st-box-title">➕ Add Daily Entry</h3>
          
          <div class="st-toggle-row">
            <button type="button" class="st-toggle-btn active-exp" id="btn-type-expense">🔻 Expense Entry</button>
            <button type="button" class="st-toggle-btn" id="btn-type-income">💚 Income Entry</button>
          </div>

          <div class="st-grid-4">
            <div class="st-field">
              <label>Date:</label>
              <input type="date" id="trans-date" class="st-input" />
            </div>
            
            <div class="st-field">
              <label>Category:</label>
              <select id="trans-category" class="st-select">
                <optgroup label="Expenses">
                  <option value="Groceries & Food">🛒 Groceries & Food</option>
                  <option value="Rent & Housing">🏠 Rent & Housing</option>
                  <option value="Electricity & Utilities">⚡ Electricity & Water</option>
                  <option value="Bus & Commute">🚌 Bus / Commute</option>
                  <option value="Phone & Internet">📱 Phone & Internet</option>
                  <option value="Dining Out & Coffee">☕ Dining Out & Coffee</option>
                  <option value="Personal & Misc">🛍️ Personal & Misc</option>
                </optgroup>
                <optgroup label="Income">
                  <option value="Work Wages / Salary">💼 Work Wages / Salary</option>
                  <option value="Delivery Earnings">🛵 Delivery Earnings</option>
                  <option value="Family Support">🎁 Family Support</option>
                  <option value="Freelancing / Other">💻 Freelancing / Other</option>
                </optgroup>
              </select>
            </div>

            <div class="st-field">
              <label>Description / Custom Item:</label>
              <input type="text" id="trans-desc" class="st-input" placeholder="e.g. Sklavenitis groceries, studio rent" />
            </div>

            <div class="st-field">
              <label>Amount (<span class="curr-sym">€</span>):</label>
              <input type="number" id="trans-amount" class="st-input" step="0.5" min="0" placeholder="0.00" />
            </div>
          </div>

          <button type="button" id="btn-save-transaction" class="st-btn st-btn-primary" style="margin-top: 1rem;">
            + Save Entry to Ledger
          </button>
        </div>

        <div class="st-table-wrapper">
          <table class="st-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="ledger-tbody"></tbody>
          </table>
          <div id="no-ledger-msg" class="st-empty-msg">No transactions recorded for this month yet.</div>
        </div>
      </div>
    </div>

    <!-- ================= TAB 3: HOURLY WORK SHIFTS ================= -->
    <div id="view-daily-log" class="st-tab-content">
      <div class="st-card">
        <div class="st-stats-grid">
          <div class="st-stat-card">
            <span class="st-stat-lbl">Hours Tracked</span>
            <div class="st-stat-num"><span id="stat-total-hours">0.0</span> hrs</div>
            <span class="st-stat-sub">Total recorded</span>
          </div>
          <div class="st-stat-card st-green">
            <span class="st-stat-lbl">Earned Wages</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-total-earned">0.00</span></div>
            <span class="st-stat-sub">Including tips</span>
          </div>
          <div class="st-stat-card st-blue">
            <span class="st-stat-lbl">Avg Rate</span>
            <div class="st-stat-num"><span class="curr-sym">€</span><span id="stat-avg-rate">0.00</span>/hr</div>
            <span class="st-stat-sub">Average per hour</span>
          </div>
          <div class="st-stat-card">
            <span class="st-stat-lbl">Weekly Status</span>
            <div class="st-stat-num" id="stat-legal-status" style="font-size: 1.15rem;">Limit OK (≤20h)</div>
            <span class="st-stat-sub">Student Legal Limit</span>
          </div>
        </div>

        <div class="st-entry-box">
          <h3 class="st-box-title">➕ Add Hourly Work Shift</h3>
          <div class="st-grid-5">
            <div class="st-field">
              <label>Date:</label>
              <input type="date" id="shift-date" class="st-input" />
            </div>
            <div class="st-field">
              <label>Workplace / Role:</label>
              <input type="text" id="shift-job" class="st-input" placeholder="e.g. Hotel, Restaurant, Warehouse" />
            </div>
            <div class="st-field">
              <label>Hours Worked:</label>
              <input type="number" id="shift-hours" class="st-input" step="0.5" min="0" placeholder="e.g. 5.5" />
            </div>
            <div class="st-field">
              <label>Hourly Rate (<span class="curr-sym">€</span>/hr):</label>
              <input type="number" id="shift-rate" class="st-input" step="0.5" min="0" value="6.50" />
            </div>
            <div class="st-field">
              <label>Tips (<span class="curr-sym">€</span>):</label>
              <input type="number" id="shift-tips" class="st-input" step="1" min="0" value="0" />
            </div>
          </div>
          
          <button type="button" id="btn-save-shift" class="st-btn st-btn-primary" style="margin-top: 1rem;">
            + Save Shift
          </button>
        </div>

        <div class="st-table-wrapper">
          <table class="st-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Workplace</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Tips</th>
                <th>Total Earned</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="shifts-tbody"></tbody>
          </table>
          <div id="no-data-msg" class="st-empty-msg">No work shifts recorded yet. Add your first shift above!</div>
        </div>
      </div>
    </div>

    <!-- Monetization Banner -->
    <div class="st-taptap-card">
      <div class="st-taptap-left">
        <span class="st-taptap-badge">💡 Smart Money Transfer Tip</span>
        <h3>Sending Wages to Home Country or Receiving Study Funds?</h3>
        <p>Use Taptap Send with <strong>0% fee</strong> and receive an extra <strong>€10 bonus</strong> on your first transfer using the verified promo code.</p>
      </div>
      <div class="st-taptap-right">
        <span class="st-taptap-code">CODE: MDSAIDUR240</span>
        <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="st-btn st-btn-primary">Claim €10 ➔</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Storage Keys
  const STORAGE_KEY_CURRENCY = 'csg_user_currency';
  const STORAGE_KEY_LEDGER = 'csg_daily_ledger_data';
  const STORAGE_KEY_SHIFTS = 'csg_student_shifts_data';
  const STORAGE_KEY_DELIVERY_RIDERS = 'csg_delivery_riders_data';
  const STORAGE_KEY_DELIVERY_EXPENSES = 'csg_delivery_expenses_data';

  // App State
  let currentCurrency = '€';
  let currentTransType = 'expense';
  let ledgerRecords = [];
  let shiftRecords = [];
  
  // Dynamic Delivery State
  let deliveryRiders = [
    { name: 'Rider 1 (Morning)', startTime: '11:00', endTime: '16:30', appGross: 75, cashTips: 6 },
    { name: 'Rider 2 (Evening)', startTime: '17:00', endTime: '23:30', appGross: 95, cashTips: 10 }
  ];

  let deliveryExpenses = [
    { name: 'Scooter / Bike Rent', amount: 15 },
    { name: 'Petrol / Fuel', amount: 10 }
  ];

  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    const currentMonth = today.substring(0, 7);

    const tDate = document.getElementById('trans-date');
    if (tDate) tDate.value = today;

    const sDate = document.getElementById('shift-date');
    if (sDate) sDate.value = today;

    const splitDate = document.getElementById('split-shift-date');
    if (splitDate) splitDate.value = today;

    const mFilter = document.getElementById('ledger-month-filter');
    if (mFilter) mFilter.value = currentMonth;

    loadData();
    initCurrency();
    initTabs();
    initDeliveryEngine();
    initLedgerEngine();
    initShiftsEngine();
    initBackupEngine();
    renderAll();
  });

  function loadData() {
    try {
      const c = localStorage.getItem(STORAGE_KEY_CURRENCY);
      if (c) currentCurrency = c;

      const l = localStorage.getItem(STORAGE_KEY_LEDGER);
      if (l) ledgerRecords = JSON.parse(l);

      const s = localStorage.getItem(STORAGE_KEY_SHIFTS);
      if (s) shiftRecords = JSON.parse(s);

      const dr = localStorage.getItem(STORAGE_KEY_DELIVERY_RIDERS);
      if (dr) deliveryRiders = JSON.parse(dr);

      const de = localStorage.getItem(STORAGE_KEY_DELIVERY_EXPENSES);
      if (de) deliveryExpenses = JSON.parse(de);
    } catch (e) {
      console.warn('Storage read error:', e);
    }
  }

  function saveData() {
    localStorage.setItem(STORAGE_KEY_CURRENCY, currentCurrency);
    localStorage.setItem(STORAGE_KEY_LEDGER, JSON.stringify(ledgerRecords));
    localStorage.setItem(STORAGE_KEY_SHIFTS, JSON.stringify(shiftRecords));
    localStorage.setItem(STORAGE_KEY_DELIVERY_RIDERS, JSON.stringify(deliveryRiders));
    localStorage.setItem(STORAGE_KEY_DELIVERY_EXPENSES, JSON.stringify(deliveryExpenses));
    
    const txt = document.getElementById('save-status-text');
    if (txt) {
      txt.innerText = 'Saved ' + new Date().toLocaleTimeString();
      setTimeout(() => txt.innerText = 'Auto-saved to browser', 2500);
    }
  }

  // 1. Currency Picker
  function initCurrency() {
    const sel = document.getElementById('global-currency-select');
    if (sel) {
      sel.value = currentCurrency;
      sel.addEventListener('change', (e) => {
        currentCurrency = e.target.value;
        saveData();
        updateSymbols();
        renderAll();
      });
    }
    updateSymbols();
  }

  function updateSymbols() {
    document.querySelectorAll('.curr-sym').forEach(el => el.innerText = currentCurrency);
  }

  // 2. Tabs Switcher
  function initTabs() {
    const tabBtns = document.querySelectorAll('.st-tab-btn');
    const contents = document.querySelectorAll('.st-tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        
        tabBtns.forEach(b => b.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        btn.classList.add('active');
        const targetEl = document.getElementById(targetId);
        if (targetEl) targetEl.classList.add('active');

        if (targetId === 'view-delivery-split') calculateDelivery();
        if (targetId === 'view-money-ledger') renderLedger();
        if (targetId === 'view-daily-log') renderShifts();
      });
    });
  }

  // 3. Delivery Splitter Engine
  function initDeliveryEngine() {
    const addRiderBtn = document.getElementById('btn-add-delivery-rider');
    if (addRiderBtn) {
      addRiderBtn.addEventListener('click', () => {
        deliveryRiders.push({
          name: `Rider ${deliveryRiders.length + 1}`,
          startTime: '12:00',
          endTime: '18:00',
          appGross: 50,
          cashTips: 0
        });
        renderDeliveryRiders();
        calculateDelivery();
        saveData();
      });
    }

    const addExpBtn = document.getElementById('btn-add-delivery-expense');
    if (addExpBtn) {
      addExpBtn.addEventListener('click', () => {
        deliveryExpenses.push({ name: 'Custom Expense', amount: 5 });
        renderDeliveryExpenses();
        calculateDelivery();
        saveData();
      });
    }

    document.querySelectorAll('.calc-split-input').forEach(i => {
      i.addEventListener('input', calculateDelivery);
    });

    const copyBtn = document.getElementById('btn-copy-delivery-summary');
    if (copyBtn) {
      copyBtn.addEventListener('click', copyDeliveryText);
    }
  }

  function renderDeliveryRiders() {
    const container = document.getElementById('delivery-riders-container');
    if (!container) return;
    container.innerHTML = '';

    deliveryRiders.forEach((rider, idx) => {
      const row = document.createElement('div');
      row.className = 'st-rider-card';
      row.innerHTML = `
        <div class="st-grid-rider">
          <div class="st-field">
            <label>Rider Name:</label>
            <input type="text" class="st-input d-r-name" value="${rider.name}" placeholder="e.g. Rider ${idx + 1}" />
          </div>
          <div class="st-field">
            <label>Shift Time (From - To):</label>
            <div class="st-time-combo">
              <input type="time" class="st-input d-r-start" value="${rider.startTime || '11:00'}" />
              <span class="st-time-sep">to</span>
              <input type="time" class="st-input d-r-end" value="${rider.endTime || '17:00'}" />
            </div>
          </div>
          <div class="st-field">
            <label>App Earnings (${currentCurrency}):</label>
            <input type="number" class="st-input d-r-gross" value="${rider.appGross}" min="0" step="1" placeholder="0.00" />
          </div>
          <div class="st-field">
            <label>Cash Tips (${currentCurrency}):</label>
            <input type="number" class="st-input d-r-tips" value="${rider.cashTips || 0}" min="0" step="1" placeholder="0.00" />
          </div>
          ${deliveryRiders.length > 1 ? `<div class="st-del-col"><button type="button" class="st-btn-del" title="Remove Rider">✕</button></div>` : ''}
        </div>
      `;

      row.querySelector('.d-r-name').addEventListener('input', (e) => {
        deliveryRiders[idx].name = e.target.value;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.d-r-start').addEventListener('input', (e) => {
        deliveryRiders[idx].startTime = e.target.value;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.d-r-end').addEventListener('input', (e) => {
        deliveryRiders[idx].endTime = e.target.value;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.d-r-gross').addEventListener('input', (e) => {
        deliveryRiders[idx].appGross = parseFloat(e.target.value) || 0;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.d-r-tips').addEventListener('input', (e) => {
        deliveryRiders[idx].cashTips = parseFloat(e.target.value) || 0;
        calculateDelivery();
        saveData();
      });

      const delBtn = row.querySelector('.st-btn-del');
      if (delBtn) {
        delBtn.addEventListener('click', () => {
          deliveryRiders.splice(idx, 1);
          renderDeliveryRiders();
          calculateDelivery();
          saveData();
        });
      }

      container.appendChild(row);
    });
  }

  function renderDeliveryExpenses() {
    const container = document.getElementById('delivery-expenses-container');
    if (!container) return;
    container.innerHTML = '';

    deliveryExpenses.forEach((exp, idx) => {
      const row = document.createElement('div');
      row.className = 'st-expense-row';
      row.innerHTML = `
        <div class="st-exp-name">
          <input type="text" class="st-input d-e-name" value="${exp.name}" placeholder="Expense name (e.g. Scooter Rent, Petrol)" />
        </div>
        <div class="st-exp-amt">
          <span class="st-curr-tag">${currentCurrency}</span>
          <input type="number" class="st-input d-e-amt" value="${exp.amount}" min="0" step="1" placeholder="0.00" />
        </div>
        <button type="button" class="st-btn-del" title="Remove Expense">✕</button>
      `;

      row.querySelector('.d-e-name').addEventListener('input', (e) => {
        deliveryExpenses[idx].name = e.target.value;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.d-e-amt').addEventListener('input', (e) => {
        deliveryExpenses[idx].amount = parseFloat(e.target.value) || 0;
        calculateDelivery();
        saveData();
      });

      row.querySelector('.st-btn-del').addEventListener('click', () => {
        deliveryExpenses.splice(idx, 1);
        renderDeliveryExpenses();
        calculateDelivery();
        saveData();
      });

      container.appendChild(row);
    });
  }

  function calculateDelivery() {
    const fleetType = document.getElementById('split-fleet-type').value;
    const fleetVal = parseFloat(document.getElementById('split-fleet-val').value) || 0;
    const expenseMode = document.getElementById('split-expense-split-mode').value;

    // Total App Gross is sum of individual rider earnings
    let totalAppGross = 0;
    deliveryRiders.forEach(r => totalAppGross += (r.appGross || 0));

    // Fleet deduction
    let totalFleetCut = fleetType === 'percent' ? ((totalAppGross * fleetVal) / 100) : fleetVal;

    // Total Custom Shared Expenses
    let totalSharedExpenses = 0;
    deliveryExpenses.forEach(e => totalSharedExpenses += (e.amount || 0));

    const netDistributable = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    // Update Header Indicators
    document.getElementById('res-d-gross').innerText = totalAppGross.toFixed(2);
    document.getElementById('res-d-fleet').innerText = totalFleetCut.toFixed(2);
    document.getElementById('res-d-expenses').innerText = totalSharedExpenses.toFixed(2);
    document.getElementById('res-d-net').innerText = netDistributable.toFixed(2);

    const payoutList = document.getElementById('delivery-payouts-list');
    if (!payoutList) return;
    payoutList.innerHTML = '';

    deliveryRiders.forEach(rider => {
      const ratio = totalAppGross > 0 ? ((rider.appGross || 0) / totalAppGross) : (1 / deliveryRiders.length);
      
      let riderFleetShare = fleetType === 'percent' ? (((rider.appGross || 0) * fleetVal) / 100) : (totalFleetCut * ratio);
      let riderExpenseShare = expenseMode === 'proportional' ? (totalSharedExpenses * ratio) : (totalSharedExpenses / deliveryRiders.length);

      const riderNetApp = Math.max(0, (rider.appGross || 0) - riderFleetShare - riderExpenseShare);
      const totalTakeHome = riderNetApp + (rider.cashTips || 0);

      const card = document.createElement('div');
      card.className = 'st-payout-item';
      card.innerHTML = `
        <div class="st-p-top">
          <div>
            <h5 class="st-p-name">👤 ${rider.name || 'Rider'}</h5>
            <span class="st-p-meta">⏰ ${rider.startTime || '--:--'} - ${rider.endTime || '--:--'} • App: ${currentCurrency}${(rider.appGross || 0).toFixed(2)} (${(ratio * 100).toFixed(0)}%)</span>
          </div>
          <div class="st-p-val">
            ${currentCurrency}${totalTakeHome.toFixed(2)}
            <small>Total Take-Home</small>
          </div>
        </div>
        <div class="st-p-breakdown">
          <span>Gross: <strong>${currentCurrency}${(rider.appGross || 0).toFixed(2)}</strong></span>
          <span>Fleet Cut: <strong class="st-red-txt">-${currentCurrency}${riderFleetShare.toFixed(2)}</strong></span>
          <span>Shared Expenses: <strong class="st-red-txt">-${currentCurrency}${riderExpenseShare.toFixed(2)}</strong></span>
          <span>Cash Tips: <strong class="st-green-txt">+${currentCurrency}${(rider.cashTips || 0).toFixed(2)}</strong></span>
        </div>
      `;
      payoutList.appendChild(card);
    });
  }

  function copyDeliveryText() {
    const fleetType = document.getElementById('split-fleet-type').value;
    const fleetVal = parseFloat(document.getElementById('split-fleet-val').value) || 0;
    const expenseMode = document.getElementById('split-expense-split-mode').value;
    const shiftDate = document.getElementById('split-shift-date').value || new Date().toISOString().split('T')[0];

    let totalAppGross = 0;
    deliveryRiders.forEach(r => totalAppGross += (r.appGross || 0));

    let totalFleetCut = fleetType === 'percent' ? ((totalAppGross * fleetVal) / 100) : fleetVal;

    let totalSharedExpenses = 0;
    let expDetails = [];
    deliveryExpenses.forEach(e => {
      if (e.amount > 0) {
        totalSharedExpenses += e.amount;
        expDetails.push(`${e.name}: ${currentCurrency}${e.amount.toFixed(2)}`);
      }
    });

    const netDistributable = Math.max(0, totalAppGross - totalFleetCut - totalSharedExpenses);

    let text = `🛵 *Cyprus Food Delivery Shift Split Summary*\n`;
    text += `📅 Date: ${shiftDate}\n`;
    text += `📱 App Total Gross: ${currentCurrency}${totalAppGross.toFixed(2)}\n`;
    text += `📑 Fleet Cut: -${currentCurrency}${totalFleetCut.toFixed(2)} (${fleetType === 'percent' ? fleetVal + '%' : 'Fixed'})\n`;
    if (expDetails.length > 0) {
      text += `⛽ Expenses Deducted: -${currentCurrency}${totalSharedExpenses.toFixed(2)} (${expDetails.join(', ')})\n`;
    }
    text += `💵 Net Distributable Pool: ${currentCurrency}${netDistributable.toFixed(2)}\n`;
    text += `------------------------------------\n`;

    deliveryRiders.forEach(rider => {
      const ratio = totalAppGross > 0 ? ((rider.appGross || 0) / totalAppGross) : (1 / deliveryRiders.length);
      let riderFleetShare = fleetType === 'percent' ? (((rider.appGross || 0) * fleetVal) / 100) : (totalFleetCut * ratio);
      let riderExpenseShare = expenseMode === 'proportional' ? (totalSharedExpenses * ratio) : (totalSharedExpenses / deliveryRiders.length);
      const riderNetApp = Math.max(0, (rider.appGross || 0) - riderFleetShare - riderExpenseShare);
      const totalTakeHome = riderNetApp + (rider.cashTips || 0);

      text += `👤 *${rider.name}*:\n`;
      text += `   • Time: ${rider.startTime || '--'} - ${rider.endTime || '--'}\n`;
      text += `   • App Gross: ${currentCurrency}${(rider.appGross || 0).toFixed(2)}\n`;
      text += `   • Net App Payout: ${currentCurrency}${riderNetApp.toFixed(2)}\n`;
      if (rider.cashTips > 0) text += `   • Cash Tips Kept: +${currentCurrency}${rider.cashTips.toFixed(2)}\n`;
      text += `   👉 *Total Take-Home: ${currentCurrency}${totalTakeHome.toFixed(2)}*\n\n`;
    });

    text += `------------------------------------\nCalculated via CyprusStudentGuide.com`;

    navigator.clipboard.writeText(text).then(() => {
      const fb = document.getElementById('delivery-copy-feedback');
      if (fb) {
        fb.style.display = 'inline';
        setTimeout(() => fb.style.display = 'none', 3000);
      }
    });
  }

  // 4. Ledger Engine
  function initLedgerEngine() {
    const btnExp = document.getElementById('btn-type-expense');
    const btnInc = document.getElementById('btn-type-income');
    const catSelect = document.getElementById('trans-category');

    if (btnExp && btnInc) {
      btnExp.addEventListener('click', () => {
        currentTransType = 'expense';
        btnExp.classList.add('active-exp');
        btnInc.classList.remove('active-inc');
        catSelect.value = 'Groceries & Food';
      });

      btnInc.addEventListener('click', () => {
        currentTransType = 'income';
        btnInc.classList.add('active-inc');
        btnExp.classList.remove('active-exp');
        catSelect.value = 'Work Wages / Salary';
      });
    }

    const monthFilter = document.getElementById('ledger-month-filter');
    if (monthFilter) monthFilter.addEventListener('change', renderLedger);

    const btnSave = document.getElementById('btn-save-transaction');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('trans-date').value;
        const category = document.getElementById('trans-category').value;
        const desc = document.getElementById('trans-desc').value.trim() || category;
        const amount = parseFloat(document.getElementById('trans-amount').value) || 0;

        if (amount <= 0) {
          alert('Please enter a valid amount.');
          return;
        }

        ledgerRecords.unshift({
          id: 'tx_' + Date.now(),
          date,
          type: currentTransType,
          category,
          desc,
          amount,
          currency: currentCurrency
        });

        saveData();
        renderLedger();

        document.getElementById('trans-desc').value = '';
        document.getElementById('trans-amount').value = '';
      });
    }
  }

  function renderLedger() {
    const tbody = document.getElementById('ledger-tbody');
    const emptyMsg = document.getElementById('no-ledger-msg');
    const selectedMonth = document.getElementById('ledger-month-filter').value;
    const monthDisplay = document.getElementById('current-month-display');

    if (monthDisplay && selectedMonth) {
      const [year, month] = selectedMonth.split('-');
      const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      monthDisplay.innerText = `${monthNames[parseInt(month)-1]} ${year} Report`;
    }

    if (!tbody) return;
    tbody.innerHTML = '';
    const filtered = ledgerRecords.filter(item => item.date.startsWith(selectedMonth));

    let totalIncome = 0;
    let totalExpense = 0;

    if (filtered.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      filtered.forEach((item) => {
        if (item.type === 'income') totalIncome += item.amount;
        else totalExpense += item.amount;

        const isInc = item.type === 'income';
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td><span class="st-badge-${item.type}">${isInc ? '💚 Income' : '🔻 Expense'}</span></td>
          <td>${item.category}</td>
          <td>${item.desc}</td>
          <td class="${isInc ? 'st-amount-inc' : 'st-amount-exp'}">
            ${isInc ? '+' : '-'}${currentCurrency}${item.amount.toFixed(2)}
          </td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this entry?')) {
            const idx = ledgerRecords.findIndex(r => r.id === item.id);
            if (idx !== -1) {
              ledgerRecords.splice(idx, 1);
              saveData();
              renderLedger();
            }
          }
        });

        tbody.appendChild(tr);
      });
    }

    const netBalance = totalIncome - totalExpense;
    document.getElementById('stat-ledger-income').innerText = totalIncome.toFixed(2);
    document.getElementById('stat-ledger-expense').innerText = totalExpense.toFixed(2);
    
    const netEl = document.getElementById('stat-ledger-net');
    const netStatus = document.getElementById('stat-ledger-status');
    netEl.innerText = (netBalance >= 0 ? '+' : '') + netBalance.toFixed(2);

    if (netBalance >= 0) {
      netEl.style.color = '#10b981';
      netStatus.innerText = '✅ Monthly Surplus';
    } else {
      netEl.style.color = '#ef4444';
      netStatus.innerText = '⚠️ Monthly Deficit';
    }

    document.getElementById('stat-ledger-count').innerText = filtered.length;
  }

  // 5. Work Shifts Engine
  function initShiftsEngine() {
    const btnSave = document.getElementById('btn-save-shift');
    if (btnSave) {
      btnSave.addEventListener('click', () => {
        const date = document.getElementById('shift-date').value;
        const job = document.getElementById('shift-job').value.trim() || 'General Shift';
        const hours = parseFloat(document.getElementById('shift-hours').value) || 0;
        const rate = parseFloat(document.getElementById('shift-rate').value) || 0;
        const tips = parseFloat(document.getElementById('shift-tips').value) || 0;

        if (hours <= 0) {
          alert('Please enter valid working hours.');
          return;
        }

        shiftRecords.unshift({
          id: 'shift_' + Date.now(),
          date,
          job,
          hours,
          rate,
          tips,
          totalEarned: (hours * rate) + tips
        });

        saveData();
        renderShifts();

        document.getElementById('shift-hours').value = '';
        document.getElementById('shift-tips').value = '0';
      });
    }
  }

  function renderShifts() {
    const tbody = document.getElementById('shifts-tbody');
    const emptyMsg = document.getElementById('no-data-msg');
    if (!tbody) return;

    tbody.innerHTML = '';
    if (shiftRecords.length === 0) {
      emptyMsg.style.display = 'block';
    } else {
      emptyMsg.style.display = 'none';
      shiftRecords.forEach((item, index) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${item.date}</strong></td>
          <td>${item.job}</td>
          <td>${item.hours} hrs</td>
          <td>${currentCurrency}${item.rate.toFixed(2)}/hr</td>
          <td>${currentCurrency}${item.tips.toFixed(2)}</td>
          <td class="st-amount-inc">${currentCurrency}${item.totalEarned.toFixed(2)}</td>
          <td><button type="button" class="st-btn-del" title="Delete">✕</button></td>
        `;

        tr.querySelector('.st-btn-del').addEventListener('click', () => {
          if (confirm('Delete this shift?')) {
            shiftRecords.splice(index, 1);
            saveData();
            renderShifts();
          }
        });

        tbody.appendChild(tr);
      });
    }

    let totalHours = 0;
    let totalEarned = 0;
    shiftRecords.forEach(s => {
      totalHours += s.hours;
      totalEarned += s.totalEarned;
    });

    document.getElementById('stat-total-hours').innerText = totalHours.toFixed(1);
    document.getElementById('stat-total-earned').innerText = totalEarned.toFixed(2);
    document.getElementById('stat-avg-rate').innerText = totalHours > 0 ? (totalEarned / totalHours).toFixed(2) : '0.00';
  }

  // 6. Backup & Restore
  function initBackupEngine() {
    document.getElementById('btn-export-csv').addEventListener('click', () => {
      if (ledgerRecords.length === 0 && shiftRecords.length === 0) {
        alert('No data to export yet.');
        return;
      }

      let csv = "=== DAILY INCOME & EXPENSE LEDGER ===\nDate,Type,Category,Description,Amount,Currency\n";
      ledgerRecords.forEach(i => {
        csv += `"${i.date}","${i.type}","${i.category}","${i.desc.replace(/"/g, '""')}",${i.amount},"${currentCurrency}"\n`;
      });

      csv += "\n=== WORK SHIFTS ===\nDate,Workplace,Hours,Rate,Tips,Total,Currency\n";
      shiftRecords.forEach(s => {
        csv += `"${s.date}","${s.job.replace(/"/g, '""')}",${s.hours},${s.rate},${s.tips},${s.totalEarned},"${currentCurrency}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Student_Financial_Log_${new Date().toISOString().split('T')[0]}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('btn-export-json').addEventListener('click', () => {
      const backup = {
        version: "3.5",
        currency: currentCurrency,
        ledger: ledgerRecords,
        shifts: shiftRecords,
        deliveryRiders: deliveryRiders,
        deliveryExpenses: deliveryExpenses
      };

      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Student_Backup_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('file-restore-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.ledger || parsed.shifts || parsed.deliveryRiders) {
            if (parsed.currency) currentCurrency = parsed.currency;
            if (parsed.ledger) ledgerRecords = parsed.ledger;
            if (parsed.shifts) shiftRecords = parsed.shifts;
            if (parsed.deliveryRiders) deliveryRiders = parsed.deliveryRiders;
            if (parsed.deliveryExpenses) deliveryExpenses = parsed.deliveryExpenses;

            saveData();
            initCurrency();
            renderAll();
            alert('✅ Backup restored successfully!');
          }
        } catch (err) {
          alert('Invalid backup file.');
        }
      };
      reader.readAsText(file);
    });

    document.getElementById('btn-clear-all').addEventListener('click', () => {
      if (confirm('Are you sure you want to reset all data? Download an Excel or JSON backup first!')) {
        ledgerRecords = [];
        shiftRecords = [];
        deliveryRiders = [
          { name: 'Rider 1 (Morning)', startTime: '11:00', endTime: '16:30', appGross: 75, cashTips: 6 },
          { name: 'Rider 2 (Evening)', startTime: '17:00', endTime: '23:30', appGross: 95, cashTips: 10 }
        ];
        deliveryExpenses = [
          { name: 'Scooter / Bike Rent', amount: 15 },
          { name: 'Petrol / Fuel', amount: 10 }
        ];
        saveData();
        renderAll();
      }
    });
  }

  function renderAll() {
    renderDeliveryRiders();
    renderDeliveryExpenses();
    calculateDelivery();
    renderLedger();
    renderShifts();
  }
</script>

