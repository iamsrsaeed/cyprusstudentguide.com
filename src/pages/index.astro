---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Cyprus Student Guide - Practical Guide for International Students';
const description = 'Hype-free, factual, and practical survival guides for international students in Cyprus. Part-time work rules, banking, bus passes, and grocery budgeting.';
const permalink = 'https://cyprusstudentguide.com/';

// Fetch all blog markdown files
const postFiles = import.meta.glob('../data/blog-posts/*.md', { eager: true });

const posts = Object.entries(postFiles).map(([filePath, post]: [string, any]) => {
  const frontmatter = post.frontmatter || {};
  const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
  const slug = frontmatter.slug || fileSlug;
  
  return {
    slug,
    title: frontmatter.title || 'Untitled Guide',
    description: frontmatter.description || '',
    publishDate: frontmatter.publishDate || '2026-08-16',
    author: frontmatter.author || 'Saidur Rahman',
    category: frontmatter.category || 'General',
  };
}).sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

const featuredPosts = posts.slice(0, 6);
---

<BaseLayout title={title} description={description} permalink={permalink} current="home">
  <section class="hero-section">
    <div class="hero-content">
      <span class="hero-badge">THE AUTHENTIC STUDENT RESOURCE</span>
      <h1>Master Student Life in Cyprus With Real-World Insights</h1>
      <p>Independent, hype-free guides covering immigration, part-time jobs, student banking, transport discounts, and smart living across Limassol, Nicosia, Larnaca, and Paphos.</p>
      <div class="hero-actions">
        <a href="/blog/" class="btn-primary">Browse All Guides →</a>
        <a href="/about/" class="btn-secondary">About The Guide</a>
      </div>
    </div>
  </section>

  <section class="recent-posts-section">
    <div class="section-header">
      <h2>Latest Practical Guides</h2>
      <a href="/blog/" class="view-all-link">View all {posts.length} articles →</a>
    </div>

    <div class="posts-grid">
      {featuredPosts.map((post) => {
        const formattedDate = new Date(post.publishDate).toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        });

        return (
          <article class="post-card">
            <div class="post-meta">
              <span class="post-category">{post.category}</span>
              <time datetime={post.publishDate}>{formattedDate}</time>
            </div>
            <h3>
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h3>
            <p>{post.description}</p>
            <div class="post-footer">
              <span class="author">By {post.author}</span>
              <a href={`/blog/${post.slug}/`} class="read-more">Read Guide →</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    text-align: center;
    padding: 4rem 1rem 3rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    background: rgba(37, 99, 235, 0.15);
    color: #3b82f6;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .hero-section h1 {
    font-size: 2.75rem;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    font-weight: 800;
    color: var(--heading-color, inherit);
  }

  .hero-section p {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  :global(html:not(.dark)) .hero-section p {
    color: #475569;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn-primary {
    background: #2563eb;
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-secondary {
    background: rgba(150, 150, 150, 0.12);
    color: inherit;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(150, 150, 150, 0.25);
  }

  .recent-posts-section {
    max-width: 1050px;
    margin: 2rem auto 5rem;
    padding: 0 1rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(150, 150, 150, 0.2);
  }

  .section-header h2 {
    font-size: 1.75rem;
    margin: 0;
  }

  .view-all-link {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(150, 150, 150, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  :global(html:not(.dark)) .post-card {
    background: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }

  :global(html.dark) .post-card {
    background: #1e293b;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: #3b82f6;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
  }

  .post-category {
    background: rgba(59, 130, 246, 0.12);
    color: #3b82f6;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .post-card h3 {
    font-size: 1.2rem;
    line-height: 1.4;
    margin: 0 0 0.75rem;
  }

  .post-card h3 a {
    color: inherit;
    text-decoration: none;
    font-weight: 700;
  }

  .post-card h3 a:hover {
    color: #3b82f6;
  }

  .post-card p {
    color: #94a3b8;
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  :global(html:not(.dark)) .post-card p {
    color: #475569;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    border-top: 1px solid rgba(150, 150, 150, 0.15);
    padding-top: 0.75rem;
    color: #94a3b8;
  }

  .read-more {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .hero-section h1 {
      font-size: 2rem;
    }
    .hero-actions {
      flex-direction: column;
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
