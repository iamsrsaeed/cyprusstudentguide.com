---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Cyprus Student Guide | Survival & Living Tips';
const description = 'Practical survival guides for international students in Cyprus: grocery budgeting, legal part-time work, accommodation, and university living.';
const permalink = Astro.site ? Astro.site.href : '/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="home">
  <div class="home-container">
    <div class="badge">Cyprus Student Resource Hub</div>
    
    <h1 class="hero-title">
      Your Practical Guide for Student Life in Cyprus
    </h1>
    
    <p class="hero-desc">
      Clear, actionable advice on smart grocery budgeting, legal part-time work rules, affordable housing, and university living for international students.
    </p>

    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">
        Explore Student Guides →
      </a>
      <a href="/about" class="btn btn-secondary">
        About This Project
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 720px;
    margin: 2.5rem auto;
    padding: 0 1rem;
    text-align: center;
  }

  .badge {
    display: inline-block;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 2.25rem;
    line-height: 1.25;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .btn-primary {
    background: #2563eb;
    color: #ffffff;
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: rgba(150, 150, 150, 0.12);
    color: inherit;
  }

  @media screen and (max-width: 640px) {
    .home-container {
      margin: 1.5rem auto;
    }
    .hero-title {
      font-size: 1.75rem;
    }
    .hero-desc {
      font-size: 0.95rem;
    }
  }
</style>
