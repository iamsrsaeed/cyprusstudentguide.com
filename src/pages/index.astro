---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Cyprus Student Guide | Survival & Living Tips';
const description = 'Practical survival guides for international students in Cyprus: grocery budgeting, legal part-time work, accommodation, and university living.';
const permalink = Astro.site ? Astro.site.href : '/';

// লেটেস্ট ৩টি পোস্ট ফেচ করা
const latestPosts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} permalink={permalink} current="home">
  <div class="home-container">
    <div class="badge">Cyprus Student Resource Hub</div>
    
    <h1 class="hero-title">
      Your Practical Guide for Student Life in Cyprus
    </h1>
    
    <p class="hero-desc">
      Clear, actionable advice on smart grocery budgeting, legal part-time work rules, affordable housing, and university living for international students.
    </p>

    <div class="hero-actions">
      <a href="/blog" class="btn btn-primary">
        Explore Student Guides →
      </a>
      <a href="/about" class="btn btn-secondary">
        About This Project
      </a>
    </div>

    <!-- Standard Student Lifestyle Banner -->
    <div class="hero-image-wrapper">
      <img 
        src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1000&q=80" 
        alt="International Students studying and planning in Cyprus" 
        class="hero-banner-img"
        loading="eager"
      />
      <div class="banner-overlay">
        <span>Verified Guides • Budget Tips • Legal Regulations</span>
      </div>
    </div>

    <!-- Quick Feature Cards -->
    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">🛒</div>
        <h3>Smart Groceries</h3>
        <p>Master Lidl Plus, compare local supermarkets, and slash monthly food bills.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚖️</div>
        <h3>Legal Part-Time</h3>
        <p>Understand student employment limits, contracts, and eligible sectors.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🛵</div>
        <h3>Living & Transport</h3>
        <p>Affordable telecom plans, bus passes, e-scooter rules, and housing tips.</p>
      </div>
    </div>

    <!-- Latest Guides Section -->
    <section class="latest-guides-section">
      <div class="section-header">
        <h2>Latest Guides & Articles</h2>
        <a href="/blog" class="view-all-link">View All Posts →</a>
      </div>

      <div class="posts-grid">
        {latestPosts.map((post) => (
          <article class="post-card">
            <div class="card-meta">
              <span class="category-badge">{post.data.category || 'Guide'}</span>
              <time>{new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            </div>
            <h3>
              <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            </h3>
            <p class="card-desc">{post.data.description}</p>
            <a href={`/blog/${post.slug}/`} class="read-link">Read Guide →</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    max-width: 800px;
    margin: 2rem auto 3.5rem auto;
    padding: 0 1.25rem;
    text-align: center;
  }

  .badge {
    display: inline-block;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: 2.25rem;
    line-height: 1.25;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: transform 0.15s ease, opacity 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn-primary {
    background: #2563eb;
    color: #ffffff;
  }

  .btn-secondary {
    background: rgba(150, 150, 150, 0.12);
    color: inherit;
  }

  /* Lifestyle Banner */
  .hero-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 2.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  .hero-banner-img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }

  .banner-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    color: #ffffff;
    padding: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Feature Grid */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    text-align: left;
    margin-bottom: 3.5rem;
  }

  .feature-card {
    background: rgba(150, 150, 150, 0.06);
    border: 1px solid rgba(150, 150, 150, 0.18);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .feature-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .feature-card h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
    font-weight: 700;
  }

  .feature-card p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  /* Latest Guides Section Styling */
  .latest-guides-section {
    padding-top: 2rem;
    border-top: 1px solid rgba(150, 150, 150, 0.15);
    text-align: left;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0;
  }

  .view-all-link {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .post-card {
    border: 1px solid rgba(150, 150, 150, 0.2);
    border-radius: 10px;
    padding: 1.25rem;
    background: rgba(150, 150, 150, 0.03);
    display: flex;
    flex-direction: column;
    text-align: left;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    border-color: #2563eb;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
  }

  .category-badge {
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .card-meta time {
    color: var(--text-secondary, #888);
  }

  .post-card h3 {
    font-size: 1.05rem;
    margin: 0 0 0.5rem 0;
    line-height: 1.4;
    font-weight: 700;
  }

  .post-card h3 a {
    text-decoration: none;
    color: inherit;
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-secondary, #666);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .read-link {
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.85rem;
    margin-top: auto;
  }

  @media screen and (max-width: 640px) {
    .home-container {
      margin-top: 1.5rem;
    }
    .hero-title {
      font-size: 1.75rem;
    }
    .hero-banner-img {
      height: 200px;
    }
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
