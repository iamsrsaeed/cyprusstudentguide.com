---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Cyprus Student Guide | Survival & Living Tips';
const description = 'Practical survival guides for international students in Cyprus: grocery budgeting, legal part-time work, accommodation, and university life.';
const permalink = Astro.site ? Astro.site.href : '/';
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
      <h1 class="text-4xl font-bold tracking-tight">
        Your Practical Survival Guide for Student Life in Cyprus
      </h1>
      <p class="hero-desc mt-4 text-lg text-gray-600 dark:text-gray-300">
        Clear, actionable advice on smart grocery budgeting, legal part-time work rules, affordable housing, and university living for international students.
      </p>
      
      <div class="hero-actions mt-6 flex gap-4">
        <a href="/blog" class="btn btn-primary">
          Explore Student Guides
        </a>
        <a href="/about" class="btn btn-secondary">
          About This Project
        </a>
      </div>
    </div>

    <div class="hero-image-container">
      <picture>
        <source srcset="/assets/home-illustration.webp" media="(min-width: 600px)" />
        <img 
          class="hero-image" 
          alt="Illustration of student reading a guide" 
          src="/assets/home-illustration-small.webp" 
          width="550" 
          height="466" 
          loading="eager"
        />
      </picture>
      <p class="caption">
        Illustration by
        <a href="https://icons8.com/illustrations/author/5c07e68d82bcbc0092519bb6" target="_blank" rel="noopener">Icons 8</a>
        from
        <a href="https://icons8.com/illustrations" target="_blank" rel="noopener">Ouch!</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .home-container {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
    gap: 2rem;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
  }

  .home-copy h1 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.5em;
  }

  .hero-desc {
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s ease-in-out;
  }

  .btn-primary {
    background-color: #2563eb;
    color: #ffffff !important;
  }

  .btn-primary:hover {
    background-color: #1d4ed8;
  }

  .btn-secondary {
    border: 1px solid #4b5563;
    color: inherit;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .hero-image-container {
    margin: 0 1em;
    text-align: center;
    flex: 1;
  }

  .hero-image-container picture {
    display: block;
    min-height: 250px;
  }

  .hero-image {
    width: 100%;
    max-width: 500px;
    height: auto;
    margin-bottom: 0.5em;
  }

  .caption {
    font-size: 0.8em;
    font-style: italic;
    text-align: center;
    opacity: 0.7;
  }

  @media (max-width: 850px) {
    .home-container {
      flex-direction: column-reverse;
      text-align: center;
    }

    .home-copy h1 {
      font-size: 2rem;
    }

    .hero-actions {
      justify-content: center;
    }

    .caption {
      text-align: center;
    }
  }
</style>
