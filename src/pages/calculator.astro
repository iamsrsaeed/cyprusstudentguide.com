---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Cyprus Student Monthly Living Cost & Budget Calculator 2026";
const description = "Calculate real-time monthly living costs in Cyprus for international students. Compare rent, food, electricity, transport across Limassol, Nicosia, Larnaca, and Paphos.";
const permalink = "https://cyprusstudentguide.com/calculator/";

const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Living Cost Calculator",
  "url": permalink,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="calculator">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(calcSchema)} />

  <section class="calc-hero">
    <span class="calc-badge">📊 Interactive Financial Tool</span>
    <h1 class="calc-title">Cyprus Student Monthly Budget Calculator</h1>
    <p class="calc-desc">Calculate realistic monthly living expenses across Cyprus cities. Adjust your room type, grocery style, and air conditioning usage to get an authentic budget estimation.</p>
  </section>

  <div class="calc-container notranslate">
    <!-- Controls Section -->
    <div class="calc-inputs-card">
      <div class="form-group">
        <label for="city-select"><strong>📍 Select Study City:</strong></label>
        <select id="city-select" class="calc-select">
          <option value="limassol" selected>Limassol (Highest Rent / High Job Density)</option>
          <option value="nicosia">Nicosia (Moderate Rent / University Hub)</option>
          <option value="larnaca">Larnaca (Lower Rent / Coastal Living)</option>
          <option value="paphos">Paphos (Affordable Rent / Tourism Focus)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="room-type"><strong>🏠 Accommodation Type:</strong></label>
        <select id="room-type" class="calc-select">
          <option value="shared_room" selected>Shared Room in 2-3 Bed Flat (€250 - €400)</option>
          <option value="private_room">Private Room in Shared Flat (€350 - €550)</option>
          <option value="studio">Private Studio / 1-Bedroom (€550 - €850)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="grocery-tier"><strong>🛒 Monthly Grocery & Food:</strong></label>
        <select id="grocery-tier" class="calc-select">
          <option value="budget" selected>Self-Cooking & Discount Stores (Lidl/Sklavenitis) ~ €140</option>
          <option value="standard">Moderate Cooking + Occasional Takeout ~ €210</option>
          <option value="premium">Frequent Dining Out & Deliveries (Wolt/Foody) ~ €320</option>
        </select>
      </div>

      <div class="form-group">
        <label for="ac-usage"><strong>⚡ Electricity & AC Usage (Per Person):</strong></label>
        <select id="ac-usage" class="calc-select">
          <option value="low">Low (Fans Only / Minimal Winter Heater) ~ €40</option>
          <option value="moderate" selected>Moderate (AC 4-6 hrs daily in Summer/Winter) ~ €75</option>
          <option value="high">Heavy (Heavy AC / Electric Water Heater continuous) ~ €125</option>
        </select>
      </div>

      <div class="form-group">
        <label for="transport-type"><strong>🚌 Public Transport & Commute:</strong></label>
        <select id="transport-type" class="calc-select">
          <option value="student_bus" selected>Motion Bus Student Card (~€20/month)</option>
          <option value="intercity_bus">Intercity + Local Student Card (~€40/month)</option>
          <option value="scooter_walk">Walk / E-Scooter / Bicycle (~€5/month charging)</option>
        </select>
      </div>

      <div class="form-group">
        <label for="misc-costs"><strong>📱 Phone SIM + Water + Personal Misc:</strong></label>
        <select id="misc-costs" class="calc-select">
          <option value="minimal" selected>Strict Minimum (SIM €15 + Water/Wifi €25) ~ €40</option>
          <option value="standard">Standard (SIM €20 + Wifi/Water €30 + Misc €30) ~ €80</option>
          <option value="social">Active Social Life + Shopping ~ €140</option>
        </select>
      </div>
    </div>

    <!-- Output Section -->
    <div class="calc-results-card">
      <div class="result-box">
        <span class="result-label">Estimated Monthly Expense</span>
        <div class="result-amount">
          <span class="currency">€</span><span id="total-cost">525</span><span class="period">/month</span>
        </div>
        <div id="cost-category-pill" class="cost-pill budget-friendly">Manageable Student Budget</div>
      </div>

      <div class="breakdown-list">
        <div class="breakdown-item">
          <span>🏠 Rent:</span>
          <strong id="b-rent">€300</strong>
        </div>
        <div class="breakdown-item">
          <span>🛒 Groceries:</span>
          <strong id="b-food">€140</strong>
        </div>
        <div class="breakdown-item">
          <span>⚡ Utilities (Power/Water):</span>
          <strong id="b-elec">€75</strong>
        </div>
        <div class="breakdown-item">
          <span>🚌 Mobility & Transport:</span>
          <strong id="b-trans">€20</strong>
        </div>
        <div class="breakdown-item">
          <span>📱 Internet & Misc:</span>
          <strong id="b-misc">€40</strong>
        </div>
      </div>

      <!-- Conversion Hook Box -->
      <div class="taptap-calc-box">
        <div class="taptap-badge">💡 Money Transfer Tip</div>
        <p class="taptap-txt">Sending tuition fees or living funds from abroad? Use Taptap Send with <strong>zero transaction fees</strong> + get <strong>€10 bonus</strong> on your first transfer.</p>
        <div class="taptap-action">
          <span class="promo-code-calc">CODE: MDSAIDUR240</span>
          <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="btn-claim-bonus">Claim €10 ➔</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function calculateBudget() {
    const city = document.getElementById('city-select').value;
    const room = document.getElementById('room-type').value;
    const food = document.getElementById('grocery-tier').value;
    const ac = document.getElementById('ac-usage').value;
    const trans = document.getElementById('transport-type').value;
    const misc = document.getElementById('misc-costs').value;

    // Base Rent Pricing Matrix
    let rentCost = 280;
    if (city === 'limassol') {
      if (room === 'shared_room') rentCost = 350;
      else if (room === 'private_room') rentCost = 480;
      else if (room === 'studio') rentCost = 750;
    } else if (city === 'nicosia') {
      if (room === 'shared_room') rentCost = 270;
      else if (room === 'private_room') rentCost = 380;
      else if (room === 'studio') rentCost = 550;
    } else if (city === 'larnaca') {
      if (room === 'shared_room') rentCost = 240;
      else if (room === 'private_room') rentCost = 340;
      else if (room === 'studio') rentCost = 500;
    } else if (city === 'paphos') {
      if (room === 'shared_room') rentCost = 230;
      else if (room === 'private_room') rentCost = 320;
      else if (room === 'studio') rentCost = 480;
    }

    // Grocery
    let foodCost = 140;
    if (food === 'standard') foodCost = 210;
    if (food === 'premium') foodCost = 320;

    // AC / Electricity
    let elecCost = 75;
    if (ac === 'low') elecCost = 40;
    if (ac === 'high') elecCost = 125;

    // Transport
    let transCost = 20;
    if (trans === 'intercity_bus') transCost = 40;
    if (trans === 'scooter_walk') transCost = 5;

    // Misc
    let miscCost = 40;
    if (misc === 'standard') miscCost = 80;
    if (misc === 'social') miscCost = 140;

    const total = rentCost + foodCost + elecCost + transCost + miscCost;

    // Update DOM
    document.getElementById('total-cost').innerText = total;
    document.getElementById('b-rent').innerText = '€' + rentCost;
    document.getElementById('b-food').innerText = '€' + foodCost;
    document.getElementById('b-elec').innerText = '€' + elecCost;
    document.getElementById('b-trans').innerText = '€' + transCost;
    document.getElementById('b-misc').innerText = '€' + miscCost;

    const pill = document.getElementById('cost-category-pill');
    if (total <= 550) {
      pill.innerText = "Budget Friendly & Efficient";
      pill.className = "cost-pill budget-friendly";
    } else if (total <= 850) {
      pill.innerText = "Standard Moderate Student Living";
      pill.className = "cost-pill moderate";
    } else {
      pill.innerText = "High Comfort / Independent Living";
      pill.className = "cost-pill high-cost";
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const selects = document.querySelectorAll('.calc-select');
    selects.forEach(select => select.addEventListener('change', calculateBudget));
    calculateBudget();
  });
</script>

<style>
  .calc-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .calc-badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .calc-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }
  .calc-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0 auto;
  }

  .calc-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .calc-inputs-card, .calc-results-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .form-group {
    margin-bottom: 1.35rem;
  }
  .form-group:last-child {
    margin-bottom: 0;
  }
  .form-group label {
    display: block;
    font-size: 0.92rem;
    color: var(--text-main);
    margin-bottom: 0.45rem;
  }
  .calc-select {
    width: 100%;
    background: var(--bg-color);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .calc-select:focus {
    border-color: var(--primary-blue);
  }

  .result-box {
    text-align: center;
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(56, 189, 248, 0.04) 100%);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.75rem 1rem;
    margin-bottom: 1.75rem;
  }
  .result-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .result-amount {
    font-size: 3.25rem;
    font-weight: 900;
    color: var(--primary-blue);
    line-height: 1.1;
    margin: 0.35rem 0 0.65rem;
  }
  .result-amount .currency { font-size: 2rem; vertical-align: super; }
  .result-amount .period { font-size: 1.1rem; color: var(--text-muted); font-weight: 600; }

  .cost-pill {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 800;
  }
  .budget-friendly { background: #dcfce7; color: #15803d; }
  .moderate { background: #e0f2fe; color: #0369a1; }
  .high-cost { background: #fee2e2; color: #b91c1c; }

  .breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .breakdown-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--card-border);
    color: var(--text-main);
  }

  .taptap-calc-box {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.25rem;
    color: #f8fafc;
  }
  .taptap-badge {
    color: #facc15;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }
  .taptap-txt {
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .taptap-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .promo-code-calc {
    font-family: var(--font-mono);
    background: #1e293b;
    border: 1px dashed #facc15;
    color: #facc15;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
  }
  .btn-claim-bonus {
    background: #2563eb;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
  }

  @media (max-width: 820px) {
    .calc-container {
      grid-template-columns: 1fr;
    }
  }
</style>
