---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Interactive Cyprus Student Monthly Living Cost & Budget Calculator 2026";
const description = "Custom interactive budget calculator for international students in Cyprus. Enter custom expenses or select real-time city averages for rent, food, AC electricity, and transport.";
const permalink = "https://cyprusstudentguide.com/calculator/";

const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Living Cost Calculator",
  "url": permalink,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="calculator">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(calcSchema)} />

  <section class="calc-hero">
    <span class="calc-badge">⚡ Fully Customizable Student Tool</span>
    <h1 class="calc-title">Cyprus Student Living Cost Calculator</h1>
    <p class="calc-desc">Enter your exact monthly amounts or click our verified city-rate suggestions below each field to calculate your authentic monthly budget in Cyprus.</p>
  </section>

  <div class="calc-container notranslate">
    <div class="calc-inputs-card">
      <div class="form-group">
        <label for="city-select"><strong>📍 Step 1: Select Your Study City</strong></label>
        <select id="city-select" class="calc-select">
          <option value="limassol" selected>Limassol (High Job Density / Higher Rent)</option>
          <option value="nicosia">Nicosia (University Capital / Balanced Cost)</option>
          <option value="larnaca">Larnaca (Moderate Rent / Coastal City)</option>
          <option value="paphos">Paphos (Affordable Rent / Hospitality Hub)</option>
        </select>
        <span class="field-hint">City changes will auto-adjust average rent suggestions.</span>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="input-rent"><strong>🏠 Monthly Rent (€):</strong></label>
          <span class="hint-badge">Customizable</span>
        </div>
        <div class="input-wrapper">
          <span class="input-prefix">€</span>
          <input type="number" id="input-rent" class="calc-input" value="350" min="0" step="10" placeholder="Enter rent" />
        </div>
        <div class="suggestion-chips" id="rent-chips">
          <span class="chip-label">Suggestions:</span>
          <button type="button" class="chip-btn" data-target="input-rent" data-val="300">Shared Bed (€300)</button>
          <button type="button" class="chip-btn active" data-target="input-rent" data-val="450">Private Room (€450)</button>
          <button type="button" class="chip-btn" data-target="input-rent" data-val="750">Studio Flat (€750)</button>
        </div>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="input-food"><strong>🛒 Monthly Grocery & Food (€):</strong></label>
          <span class="hint-badge">Customizable</span>
        </div>
        <div class="input-wrapper">
          <span class="input-prefix">€</span>
          <input type="number" id="input-food" class="calc-input" value="160" min="0" step="10" placeholder="Enter food expense" />
        </div>
        <div class="suggestion-chips">
          <span class="chip-label">Suggestions:</span>
          <button type="button" class="chip-btn" data-target="input-food" data-val="130">Self-Cooking (€130)</button>
          <button type="button" class="chip-btn active" data-target="input-food" data-val="180">Balanced Diet (€180)</button>
          <button type="button" class="chip-btn" data-target="input-food" data-val="280">Takeouts / Wolt (€280)</button>
        </div>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="input-elec"><strong>⚡ Electricity, AC & Water Share (€):</strong></label>
          <span class="hint-badge">Customizable</span>
        </div>
        <div class="input-wrapper">
          <span class="input-prefix">€</span>
          <input type="number" id="input-elec" class="calc-input" value="70" min="0" step="5" placeholder="Enter utility cost" />
        </div>
        <div class="suggestion-chips">
          <span class="chip-label">Suggestions:</span>
          <button type="button" class="chip-btn" data-target="input-elec" data-val="40">Low / Fan Only (€40)</button>
          <button type="button" class="chip-btn active" data-target="input-elec" data-val="75">AC 4-6 hrs/day (€75)</button>
          <button type="button" class="chip-btn" data-target="input-elec" data-val="120">Heavy AC (€120)</button>
        </div>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="input-trans"><strong>🚌 Public Bus & Commute (€):</strong></label>
          <span class="hint-badge">Customizable</span>
        </div>
        <div class="input-wrapper">
          <span class="input-prefix">€</span>
          <input type="number" id="input-trans" class="calc-input" value="20" min="0" step="5" placeholder="Enter transit cost" />
        </div>
        <div class="suggestion-chips">
          <span class="chip-label">Suggestions:</span>
          <button type="button" class="chip-btn" data-target="input-trans" data-val="5">E-Scooter / Walk (€5)</button>
          <button type="button" class="chip-btn active" data-target="input-trans" data-val="20">City Bus Card (€20)</button>
          <button type="button" class="chip-btn" data-target="input-trans" data-val="40">Intercity Travel (€40)</button>
        </div>
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="input-misc"><strong>📱 SIM, Wi-Fi & Personal Misc (€):</strong></label>
          <span class="hint-badge">Customizable</span>
        </div>
        <div class="input-wrapper">
          <span class="input-prefix">€</span>
          <input type="number" id="input-misc" class="calc-input" value="45" min="0" step="5" placeholder="Enter personal misc" />
        </div>
        <div class="suggestion-chips">
          <span class="chip-label">Suggestions:</span>
          <button type="button" class="chip-btn active" data-target="input-misc" data-val="40">SIM + Wi-Fi (€40)</button>
          <button type="button" class="chip-btn" data-target="input-misc" data-val="80">Standard Student (€80)</button>
          <button type="button" class="chip-btn" data-target="input-misc" data-val="140">Active Lifestyle (€140)</button>
        </div>
      </div>
    </div>

    <div class="calc-results-card">
      <div class="result-box">
        <span class="result-label">Total Estimated Monthly Expense</span>
        <div class="result-amount">
          <span class="currency">€</span><span id="total-cost">645</span><span class="period">/month</span>
        </div>
        <div id="cost-category-pill" class="cost-pill moderate">Standard Moderate Student Budget</div>
      </div>

      <div class="breakdown-list">
        <div class="breakdown-item">
          <span>🏠 Accommodation:</span>
          <strong id="b-rent">€350</strong>
        </div>
        <div class="breakdown-item">
          <span>🛒 Grocery & Nutrition:</span>
          <strong id="b-food">€160</strong>
        </div>
        <div class="breakdown-item">
          <span>⚡ Power, AC & Water:</span>
          <strong id="b-elec">€70</strong>
        </div>
        <div class="breakdown-item">
          <span>🚌 Local Bus / Transit:</span>
          <strong id="b-trans">€20</strong>
        </div>
        <div class="breakdown-item">
          <span>📱 Internet, SIM & Misc:</span>
          <strong id="b-misc">€45</strong>
        </div>
      </div>

      <div class="analysis-box">
        <h4 class="analysis-title">💡 Field Insight for Students</h4>
        <p class="analysis-txt" id="analysis-text">In Limassol, room sharing cuts accommodation costs by over 50%. A legal 20-hour part-time job (€850 - €1,000/mo) comfortably offsets this living cost with surplus savings.</p>
      </div>

      <div class="taptap-calc-box">
        <div class="taptap-badge">🎁 Remittance & Tuition Fee Tip</div>
        <p class="taptap-txt">Sending money from Cyprus or receiving study funds? Use Taptap Send with <strong>0% fee</strong> + get <strong>€10 bonus</strong> on your first transfer.</p>
        <div class="taptap-action">
          <span class="promo-code-calc">CODE: MDSAIDUR240</span>
          <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="btn-claim-bonus">Claim €10 ➔</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  function runCalculation() {
    const rentVal = parseFloat(document.getElementById('input-rent').value) || 0;
    const foodVal = parseFloat(document.getElementById('input-food').value) || 0;
    const elecVal = parseFloat(document.getElementById('input-elec').value) || 0;
    const transVal = parseFloat(document.getElementById('input-trans').value) || 0;
    const miscVal = parseFloat(document.getElementById('input-misc').value) || 0;

    const total = Math.round(rentVal + foodVal + elecVal + transVal + miscVal);

    // Update Summary Elements
    document.getElementById('total-cost').innerText = total;
    document.getElementById('b-rent').innerText = '€' + rentVal;
    document.getElementById('b-food').innerText = '€' + foodVal;
    document.getElementById('b-elec').innerText = '€' + elecVal;
    document.getElementById('b-trans').innerText = '€' + transVal;
    document.getElementById('b-misc').innerText = '€' + miscVal;

    // Status Pill
    const pill = document.getElementById('cost-category-pill');
    if (total <= 520) {
      pill.innerText = "Budget-Optimized / Highly Economical";
      pill.className = "cost-pill budget-friendly";
    } else if (total <= 800) {
      pill.innerText = "Standard Moderate Student Budget";
      pill.className = "cost-pill moderate";
    } else {
      pill.innerText = "Higher Comfort / Solo Studio Living";
      pill.className = "cost-pill high-cost";
    }

    // Dynamic Field Insight
    const city = document.getElementById('city-select').value;
    const analysis = document.getElementById('analysis-text');
    if (city === 'limassol') {
      analysis.innerText = "In Limassol, accommodation is the biggest factor. A student working 20 hours/week earns ~€850-€1,000, which balances standard living costs nicely.";
    } else if (city === 'nicosia') {
      analysis.innerText = "Nicosia offers lower rent and higher student flat availability near Engomi and Aglantzia. Average total expenses stay tightly around €500 - €650.";
    } else if (city === 'larnaca') {
      analysis.innerText = "Larnaca is one of the most budget-friendly coastal cities for international students with affordable studio rentals and easy bicycle/scooter routes.";
    } else {
      analysis.innerText = "Paphos provides high seasonal hospitality employment opportunities with relatively moderate housing costs throughout the academic year.";
    }
  }

  function handleCityChange() {
    const city = document.getElementById('city-select').value;
    const rentInput = document.getElementById('input-rent');
    const rentChips = document.getElementById('rent-chips');

    if (city === 'limassol') {
      rentInput.value = 350;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="300">Shared Bed (€300)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="450">Private Room (€450)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="750">Studio Flat (€750)</button>
      `;
    } else if (city === 'nicosia') {
      rentInput.value = 280;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="230">Shared Bed (€230)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="380">Private Room (€380)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="550">Studio Flat (€550)</button>
      `;
    } else if (city === 'larnaca') {
      rentInput.value = 260;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="200">Shared Bed (€200)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="340">Private Room (€340)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="500">Studio Flat (€500)</button>
      `;
    } else if (city === 'paphos') {
      rentInput.value = 250;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="190">Shared Bed (€190)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="320">Private Room (€320)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="480">Studio Flat (€480)</button>
      `;
    }
    bindChipEvents();
    runCalculation();
  }

  function bindChipEvents() {
    const chips = document.querySelectorAll('.chip-btn');
    chips.forEach(chip => {
      chip.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('data-target');
        const targetVal = this.getAttribute('data-val');
        const input = document.getElementById(targetId);
        if (input) {
          input.value = targetVal;
          // Toggle active class inside same group
          const parent = this.parentElement;
          parent.querySelectorAll('.chip-btn').forEach(btn => btn.classList.remove('active'));
          this.classList.add('active');
          runCalculation();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    const inputs = document.querySelectorAll('.calc-input');
    inputs.forEach(input => {
      input.addEventListener('input', runCalculation);
    });

    const citySelect = document.getElementById('city-select');
    if (citySelect) {
      citySelect.addEventListener('change', handleCityChange);
    }

    bindChipEvents();
    runCalculation();
  });
</script>

<style>
  .calc-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .calc-badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .calc-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }
  .calc-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .calc-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }

  .calc-inputs-card, .calc-results-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }
  .form-group:last-child {
    margin-bottom: 0;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.45rem;
  }
  .label-row label {
    font-size: 0.92rem;
    color: var(--text-main);
  }
  .hint-badge {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(150, 150, 150, 0.1);
    color: var(--text-muted);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .field-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
    display: block;
    margin-top: 0.35rem;
  }

  .calc-select {
    width: 100%;
    background: var(--bg-color);
    color: var(--text-main);
    border: 1px solid var(--
