---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Interactive Cyprus Student Monthly Budget & Income Calculator 2026";
const description = "Comprehensive interactive budget & income calculator for international students in Cyprus. Calculate monthly living costs, part-time wages (20h/week limit), and net monthly savings balance across Limassol, Nicosia, Larnaca, and Paphos.";
const permalink = "https://cyprusstudentguide.com/calculator/";

const calcSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Cyprus Student Living Cost & Income Calculator",
  "url": permalink,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "description": description
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="calculator">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(calcSchema)} />

  <section class="calc-hero">
    <span class="calc-badge">⚡ Full Income & Expense Analysis Tool</span>
    <h1 class="calc-title">Cyprus Student Budget & Income Calculator</h1>
    <p class="calc-desc">Calculate your real-time expenses, part-time earnings, and net monthly savings balance in Cyprus. Customize living costs and wages or use verified city benchmarks.</p>
  </section>

  <div class="calc-container notranslate">
    <div class="calc-inputs-column">
      
      <div class="calc-card income-card-wrap">
        <div class="section-title-row">
          <span class="sec-icon">💶</span>
          <div>
            <h2 class="sec-heading">Part-Time Income & Earnings</h2>
            <p class="sec-sub">Calculate potential monthly legal wages (Non-EU 20 hrs/week law)</p>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-hourly"><strong>⏱️ Hourly Pay Rate (€/hr):</strong></label>
            <span class="hint-badge">Legal Min ~€5.50</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-hourly" class="calc-input income-field" value="6.50" min="0" step="0.5" placeholder="e.g. 6.50" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Presets:</span>
            <button type="button" class="chip-btn" data-target="input-hourly" data-val="5.50">Hospitality (€5.50)</button>
            <button type="button" class="chip-btn active" data-target="input-hourly" data-val="6.50">Average Standard (€6.50)</button>
            <button type="button" class="chip-btn" data-target="input-hourly" data-val="8.00">Delivery/Skilled (€8.00)</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-hours"><strong>📅 Weekly Working Hours:</strong></label>
            <span class="hint-badge">Legal Limit: 20h</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">⌛</span>
            <input type="number" id="input-hours" class="calc-input income-field" value="20" min="0" max="48" step="1" placeholder="e.g. 20" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Presets:</span>
            <button type="button" class="chip-btn" data-target="input-hours" data-val="10">Light (10 hrs/wk)</button>
            <button type="button" class="chip-btn active" data-target="input-hours" data-val="20">Legal Max (20 hrs/wk)</button>
            <button type="button" class="chip-btn" data-target="input-hours" data-val="0">No Job / Studies Only</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-other-inc"><strong>🎁 Other Support / Freelance (€/mo):</strong></label>
            <span class="hint-badge">Optional</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-other-inc" class="calc-input income-field" value="0" min="0" step="20" placeholder="Family support / freelance" />
          </div>
        </div>
      </div>

      <div class="calc-card">
        <div class="section-title-row">
          <span class="sec-icon">🏠</span>
          <div>
            <h2 class="sec-heading">Monthly Living Expenses</h2>
            <p class="sec-sub">Estimated room rent, electricity, groceries, and travel</p>
          </div>
        </div>

        <div class="form-group">
          <label for="city-select"><strong>📍 Study City:</strong></label>
          <select id="city-select" class="calc-select">
            <option value="limassol" selected>Limassol (High Job Density / Higher Rent)</option>
            <option value="nicosia">Nicosia (University Capital / Balanced Cost)</option>
            <option value="larnaca">Larnaca (Moderate Rent / Coastal City)</option>
            <option value="paphos">Paphos (Affordable Rent / Hospitality Hub)</option>
          </select>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-rent"><strong>🏠 Monthly Rent (€):</strong></label>
            <span class="hint-badge">Customizable</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-rent" class="calc-input exp-field" value="350" min="0" step="10" placeholder="Enter rent" />
          </div>
          <div class="suggestion-chips" id="rent-chips">
            <span class="chip-label">Suggestions:</span>
            <button type="button" class="chip-btn" data-target="input-rent" data-val="300">Shared Bed (€300)</button>
            <button type="button" class="chip-btn active" data-target="input-rent" data-val="450">Private Room (€450)</button>
            <button type="button" class="chip-btn" data-target="input-rent" data-val="750">Studio Flat (€750)</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-food"><strong>🛒 Grocery & Food (€):</strong></label>
            <span class="hint-badge">Customizable</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-food" class="calc-input exp-field" value="160" min="0" step="10" placeholder="Enter food expense" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Suggestions:</span>
            <button type="button" class="chip-btn" data-target="input-food" data-val="130">Self-Cooking (€130)</button>
            <button type="button" class="chip-btn active" data-target="input-food" data-val="180">Balanced Diet (€180)</button>
            <button type="button" class="chip-btn" data-target="input-food" data-val="280">Takeouts / Wolt (€280)</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-elec"><strong>⚡ Power, AC & Water Share (€):</strong></label>
            <span class="hint-badge">Customizable</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-elec" class="calc-input exp-field" value="70" min="0" step="5" placeholder="Enter utility cost" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Suggestions:</span>
            <button type="button" class="chip-btn" data-target="input-elec" data-val="40">Low / Fan Only (€40)</button>
            <button type="button" class="chip-btn active" data-target="input-elec" data-val="75">AC 4-6 hrs/day (€75)</button>
            <button type="button" class="chip-btn" data-target="input-elec" data-val="120">Heavy AC (€120)</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-trans"><strong>🚌 Public Bus & Commute (€):</strong></label>
            <span class="hint-badge">Customizable</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-trans" class="calc-input exp-field" value="20" min="0" step="5" placeholder="Enter transit cost" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Suggestions:</span>
            <button type="button" class="chip-btn" data-target="input-trans" data-val="5">E-Scooter / Walk (€5)</button>
            <button type="button" class="chip-btn active" data-target="input-trans" data-val="20">City Bus Card (€20)</button>
            <button type="button" class="chip-btn" data-target="input-trans" data-val="40">Intercity Travel (€40)</button>
          </div>
        </div>

        <div class="form-group">
          <div class="label-row">
            <label for="input-misc"><strong>📱 SIM, Wi-Fi & Misc (€):</strong></label>
            <span class="hint-badge">Customizable</span>
          </div>
          <div class="input-wrapper">
            <span class="input-prefix">€</span>
            <input type="number" id="input-misc" class="calc-input exp-field" value="45" min="0" step="5" placeholder="Enter personal misc" />
          </div>
          <div class="suggestion-chips">
            <span class="chip-label">Suggestions:</span>
            <button type="button" class="chip-btn active" data-target="input-misc" data-val="40">SIM + Wi-Fi (€40)</button>
            <button type="button" class="chip-btn" data-target="input-misc" data-val="80">Standard Student (€80)</button>
            <button type="button" class="chip-btn" data-target="input-misc" data-val="140">Active Lifestyle (€140)</button>
          </div>
        </div>

        <div class="custom-expense-section">
          <div class="custom-header">
            <label><strong>➕ Other Personal Expenses:</strong></label>
            <span class="field-hint">e.g. Gym, Books, Netflix, Coffee</span>
          </div>

          <div id="custom-expense-list" class="custom-expense-list"></div>

          <button type="button" id="btn-add-expense" class="btn-add-expense">
            + Add Another Expense Field
          </button>
        </div>
      </div>
    </div>

    <div class="calc-results-column">
      
      <div class="net-balance-card" id="balance-card">
        <span class="balance-label">Net Monthly Balance (Savings / Deficit)</span>
        <div class="balance-amount" id="balance-val-container">
          <span class="currency">€</span><span id="net-balance-amount">-85</span>
        </div>
        <div id="balance-status-pill" class="status-pill status-neutral">Calculating...</div>
      </div>

      <div class="calc-card summary-card">
        <h3 class="summary-heading">📊 Monthly Financial Overview</h3>
        
        <div class="financial-row green-row">
          <span>💚 Total Monthly Income:</span>
          <strong id="total-income-display">€560</strong>
        </div>
        <div class="financial-row red-row">
          <span>🔻 Total Monthly Expenses:</span>
          <strong id="total-expense-display">€645</strong>
        </div>

        <div class="breakdown-list" id="breakdown-container">
          <div class="breakdown-divider">Detailed Cost Breakdown</div>
          <div class="breakdown-item">
            <span>🏠 Rent:</span>
            <strong id="b-rent">€350</strong>
          </div>
          <div class="breakdown-item">
            <span>🛒 Food & Grocery:</span>
            <strong id="b-food">€160</strong>
          </div>
          <div class="breakdown-item">
            <span>⚡ Utilities (AC/Power/Water):</span>
            <strong id="b-elec">€70</strong>
          </div>
          <div class="breakdown-item">
            <span>🚌 Bus / Commute:</span>
            <strong id="b-trans">€20</strong>
          </div>
          <div class="breakdown-item">
            <span>📱 Internet & SIM:</span>
            <strong id="b-misc">€45</strong>
          </div>
          <div id="custom-breakdown-items"></div>
        </div>

        <div class="analysis-box">
          <h4 class="analysis-title">💡 Real Student Field Analysis</h4>
          <p class="analysis-txt" id="analysis-text">Loading verified city analysis...</p>
        </div>

        <div class="taptap-calc-box">
          <div class="taptap-badge">🎁 Remittance & Tuition Fee Tip</div>
          <p class="taptap-txt">Sending money from Cyprus or receiving funds from abroad? Use Taptap Send with <strong>0% fee</strong> + get <strong>€10 bonus</strong> on your first transfer.</p>
          <div class="taptap-action">
            <span class="promo-code-calc">CODE: MDSAIDUR240</span>
            <a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/" class="btn-claim-bonus">Claim €10 ➔</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script is:inline>
  function runCalculation() {
    // 1. Income Calculation (Hourly * Weekly Hours * 4.33 weeks/mo + Other)
    const hourlyRate = parseFloat(document.getElementById('input-hourly').value) || 0;
    const weeklyHours = parseFloat(document.getElementById('input-hours').value) || 0;
    const otherIncome = parseFloat(document.getElementById('input-other-inc').value) || 0;

    const wageIncome = Math.round(hourlyRate * weeklyHours * 4.33);
    const totalIncome = wageIncome + otherIncome;

    // 2. Standard Expenses
    const rentVal = parseFloat(document.getElementById('input-rent').value) || 0;
    const foodVal = parseFloat(document.getElementById('input-food').value) || 0;
    const elecVal = parseFloat(document.getElementById('input-elec').value) || 0;
    const transVal = parseFloat(document.getElementById('input-trans').value) || 0;
    const miscVal = parseFloat(document.getElementById('input-misc').value) || 0;

    // 3. Custom Expenses
    let customTotal = 0;
    const customRows = document.querySelectorAll('.custom-expense-row');
    const customBreakdownContainer = document.getElementById('custom-breakdown-items');
    
    if (customBreakdownContainer) {
      customBreakdownContainer.innerHTML = '';
    }

    customRows.forEach((row) => {
      const titleInput = row.querySelector('.custom-name-input');
      const amountInput = row.querySelector('.custom-amount-input');
      
      const title = titleInput && titleInput.value.trim() !== '' ? titleInput.value.trim() : 'Custom Expense';
      const amount = parseFloat(amountInput.value) || 0;
      
      if (amount > 0) {
        customTotal += amount;
        if (customBreakdownContainer) {
          const itemDiv = document.createElement('div');
          itemDiv.className = 'breakdown-item custom-item';
          itemDiv.innerHTML = `<span>📌 ${title}:</span><strong>€${amount}</strong>`;
          customBreakdownContainer.appendChild(itemDiv);
        }
      }
    });

    const totalExpense = Math.round(rentVal + foodVal + elecVal + transVal + miscVal + customTotal);
    const netBalance = totalIncome - totalExpense;

    // 4. Update Displays
    document.getElementById('total-income-display').innerText = '€' + totalIncome;
    document.getElementById('total-expense-display').innerText = '€' + totalExpense;

    document.getElementById('b-rent').innerText = '€' + rentVal;
    document.getElementById('b-food').innerText = '€' + foodVal;
    document.getElementById('b-elec').innerText = '€' + elecVal;
    document.getElementById('b-trans').innerText = '€' + transVal;
    document.getElementById('b-misc').innerText = '€' + miscVal;

    // Net Balance Banner Logic
    const netEl = document.getElementById('net-balance-amount');
    const pill = document.getElementById('balance-status-pill');
    const balanceCard = document.getElementById('balance-card');

    if (netBalance >= 0) {
      netEl.innerText = '+' + netBalance;
      netEl.style.color = '#22c55e';
      pill.innerText = `✅ Monthly Surplus: Saving €${netBalance}/month`;
      pill.className = "status-pill status-surplus";
      balanceCard.style.borderColor = 'rgba(34, 197, 94, 0.4)';
    } else {
      netEl.innerText = netBalance;
      netEl.style.color = '#ef4444';
      pill.innerText = `⚠️ Deficit: Need €${Math.abs(netBalance)} from savings or family`;
      pill.className = "status-pill status-deficit";
      balanceCard.style.borderColor = 'rgba(239, 68, 68, 0.4)';
    }

    // 5. Dynamic Field Insight
    const city = document.getElementById('city-select').value;
    const analysis = document.getElementById('analysis-text');
    if (city === 'limassol') {
      analysis.innerText = `In Limassol, housing is the primary expense. Working legal 20 hrs/week earns ~€${wageIncome}/mo. Sharing a flat helps secure an immediate surplus.`;
    } else if (city === 'nicosia') {
      analysis.innerText = `In Nicosia, lower rent around Engomi/Aglantzia combined with ~€${wageIncome}/mo wages allows students to achieve a comfortable break-even point.`;
    } else if (city === 'larnaca') {
      analysis.innerText = `In Larnaca, moderate living costs make ~€${wageIncome}/mo wages highly efficient, often leaving €100+ monthly net savings.`;
    } else {
      analysis.innerText = `In Paphos, hospitality positions offer steady wages with lower accommodation costs throughout the academic term.`;
    }
  }

  function handleCityChange() {
    const city = document.getElementById('city-select').value;
    const rentInput = document.getElementById('input-rent');
    const rentChips = document.getElementById('rent-chips');

    if (city === 'limassol') {
      rentInput.value = 350;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="300">Shared Bed (€300)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="450">Private Room (€450)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="750">Studio Flat (€750)</button>
      `;
    } else if (city === 'nicosia') {
      rentInput.value = 280;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="230">Shared Bed (€230)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="380">Private Room (€380)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="550">Studio Flat (€550)</button>
      `;
    } else if (city === 'larnaca') {
      rentInput.value = 260;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="200">Shared Bed (€200)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="340">Private Room (€340)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="500">Studio Flat (€500)</button>
      `;
    } else if (city === 'paphos') {
      rentInput.value = 250;
      rentChips.innerHTML = `
        <span class="chip-label">Suggestions:</span>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="190">Shared Bed (€190)</button>
        <button type="button" class="chip-btn active" data-target="input-rent" data-val="320">Private Room (€320)</button>
        <button type="button" class="chip-btn" data-target="input-rent" data-val="480">Studio Flat (€480)</button>
      `;
    }
    bindChipEvents();
    runCalculation();
  }

  function bindChipEvents() {
    const chips = document.querySelectorAll('.chip-btn');
    chips.forEach(chip => {
      chip.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('data-target');
        const targetVal = this.getAttribute('data-val');
        const input = document.getElementById(targetId);
        if (input) {
          input.value = targetVal;
          const parent = this.parentElement;
          parent.querySelectorAll('.chip-btn').forEach(btn => btn.classList.remove('active'));
          this.classList.add('active');
          runCalculation();
        }
      });
    });
  }

  function addCustomExpenseRow(defaultTitle = '', defaultAmount = '') {
    const list = document.getElementById('custom-expense-list');
    if (!list) return;

    const row = document.createElement('div');
    row.className = 'custom-expense-row';
    row.innerHTML = `
      <input type="text" class="calc-input custom-name-input" placeholder="Expense name (e.g. Gym, Netflix)" value="${defaultTitle}" />
      <div class="input-wrapper custom-amt-wrap">
        <span class="input-prefix">€</span>
        <input type="number" class="calc-input custom-amount-input" placeholder="0" min="0" step="5" value="${defaultAmount}" />
      </div>
      <button type="button" class="btn-remove-row" title="Remove this expense">✕</button>
    `;

    row.querySelector('.custom-name-input').addEventListener('input', runCalculation);
    row.querySelector('.custom-amount-input').addEventListener('input', runCalculation);
    row.querySelector('.btn-remove-row').addEventListener('click', () => {
      row.remove();
      runCalculation();
    });

    list.appendChild(row);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const allInputs = document.querySelectorAll('.calc-input');
    allInputs.forEach(input => {
      input.addEventListener('input', runCalculation);
    });

    const citySelect = document.getElementById('city-select');
    if (citySelect) {
      citySelect.addEventListener('change', handleCityChange);
    }

    const addBtn = document.getElementById('btn-add-expense');
    if (addBtn) {
      addBtn.addEventListener('click', () => {
        addCustomExpenseRow('', '');
      });
    }

    bindChipEvents();
    runCalculation();
  });
</script>

<style>
  .calc-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .calc-badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.35rem 0.85rem;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .calc-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }
  .calc-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .calc-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: start;
  }

  .calc-inputs-column {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .calc-results-column {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .calc-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .income-card-wrap {
    border-color: rgba(34, 197, 94, 0.3);
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.03) 0%, rgba(56, 189, 248, 0.02) 100%);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--card-border);
  }
  .sec-icon { font-size: 1.6rem; }
  .sec-heading {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    color: var(--text-main);
  }
  .sec-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.15rem 0 0;
  }

  .form-group {
    margin-bottom: 1.35rem;
  }
  .form-group:last-child {
    margin-bottom: 0;
  }

  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .label-row label {
    font-size: 0.9rem;
    color: var(--text-main);
  }
  .hint-badge {
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(150, 150, 150, 0.1);
    color: var(--text-muted);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .calc-select {
    width: 100%;
    background: var(--bg-color);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
  }

  .input-wrapper {
    position: relative;
