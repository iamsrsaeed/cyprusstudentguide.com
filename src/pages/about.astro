---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About | Cyprus Student Guide';
const description = 'Learn more about Cyprus Student Guide and our mission to support international students in Cyprus.';
const permalink = 'https://cyprusstudentguide.com/about/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="about-container">
    <h1>About <span>Cyprus Student Guide</span></h1>
    
    <p class="lead">
      Empowering international students in Cyprus with practical, verified, and real-world information to make their academic and daily journey smooth and affordable.
    </p>

    <div class="mission-card">
      <h2>🎯 Our Mission</h2>
      <p>
        Moving to a new country for higher education comes with excitement, but navigating grocery budgeting, part-time work regulations, accommodation, and transportation can often be challenging. 
      </p>
      <p>
        <strong>Cyprus Student Guide</strong> was built by international students for international students. We break down complex local rules and share tested everyday hacks—without unnecessary clutter.
      </p>
    </div>

    <h2>📚 What We Cover</h2>
    <ul class="coverage-list">
      <li><strong>Smart Budgeting & Grocery Deals:</strong> Practical guides on Lidl Plus, local discount supermarkets, and weekly fruit markets.</li>
      <li><strong>Legal Employment & Regulations:</strong> Clarity on Non-EU student work rights, 20-hour weekly limits, eligible employment sectors, and contract procedures.</li>
      <li><strong>Local Living Essentials:</strong> Affordable SIM plans, public transit options, e-scooter rules, and finding student accommodation.</li>
    </ul>

    <h2>🤝 Independent & Community-Driven</h2>
    <p>
      All guides published here are based on firsthand experiences, official ministry guidelines, and real student feedback across Nicosia, Limassol, Larnaca, and Paphos.
    </p>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 0;
    line-height: 1.7;
  }

  h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  h1 span {
    color: #2563eb;
  }

  .lead {
    font-size: 1.15rem;
    opacity: 0.9;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .mission-card {
    background: rgba(37, 99, 235, 0.05);
    border-left: 4px solid #2563eb;
    padding: 1.5rem;
    border-radius: 8px;
    margin: 2rem 0;
  }

  .mission-card h2 {
    margin-top: 0;
    font-size: 1.4rem;
  }

  h2 {
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .coverage-list {
    padding-left: 1.25rem;
    margin: 1.25rem 0;
  }

  .coverage-list li {
    margin-bottom: 0.75rem;
  }

  .coverage-list strong {
    color: #2563eb;
  }
</style>
