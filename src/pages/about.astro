---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Us | Cyprus Student Guide';
const description = 'Independent, authentic, and research-backed handbook built to empower international students in Cyprus.';
const permalink = 'https://cyprusstudentguide.com/about/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="about-container notranslate">
    <header class="about-header">
      <span class="badge">OUR MISSION</span>
      <h1>Empowering International Students in Cyprus</h1>
      <p class="lead">Hype-free, ground-tested insights for navigating life, work, legal immigration, and daily budgeting in the Republic of Cyprus.</p>
    </header>

    <div class="about-content">
      <section class="about-card">
        <h2>Why Cyprus Student Guide Exists</h2>
        <p>
          Moving abroad for higher education is an exciting journey, but it often comes with overwhelming paperwork, strict immigration deadlines, banking bottlenecks, and utility traps. Most online information is either outdated, misleading, or designed as promotional agency hype.
        </p>
        <p>
          <strong>Cyprus Student Guide</strong> was created to bridge this information gap with authentic, field-tested guidance covering everything from Civil Registry & Migration Department (CRMD) compliance, student bank account setup, transport discount cards, and supermarket hacks to legal part-time employment regulations.
        </p>
      </section>

      <section class="about-card">
        <h2>Our Editorial Standards & Ground Reality</h2>
        <ul class="standards-list">
          <li>
            <strong>Verified Compliance:</strong> All procedural timelines are cross-verified against decrees from the Ministry of Labour, Tax Department, and Migration Department[cite: 1, 2].
          </li>
          <li>
            <strong>100% Agency & Scam-Free:</strong> We do not sell admission packages or charge students[cite: 1, 2]. Our goal is to help students avoid rental scams, ghost Mukhtar stamps, and expensive remittance wire fees[cite: 1, 2].
          </li>
          <li>
            <strong>Real Field Data:</strong> Built with practical experience from active students living across Limassol, Nicosia, Larnaca, and Paphos[cite: 1, 2].
          </li>
        </ul>
      </section>

      <!-- Fixed Mobile Responsive Contact Box -->
      <div class="contact-card">
        <h3>Get in Touch With Editorial Desk</h3>
        <p>Have suggestions, noticed a recent policy update, or want to contribute verified field data?</p>
        <div class="email-wrapper">
          <span class="email-icon">✉️</span>
          <a href="mailto:contact@cyprusstudentguide.com" class="email-link">contact@cyprusstudentguide.com</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 0.75rem 4rem;
    box-sizing: border-box;
    width: 100%;
  }

  .about-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge {
    background: rgba(37, 99, 235, 0.12);
    color: var(--primary-blue);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    display: inline-block;
    margin-bottom: 0.85rem;
    letter-spacing: 0.04em;
  }

  .about-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.4rem);
    font-weight: 900;
    line-height: 1.25;
    margin: 0 0 0.85rem;
    color: var(--text-main);
  }

  .lead {
    font-size: clamp(0.95rem, 2.5vw, 1.12rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .about-card h2 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0 0 0.85rem;
  }

  .about-card p {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.68;
    margin: 0 0 1rem;
  }
  .about-card p:last-child {
    margin-bottom: 0;
  }

  .standards-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .standards-list li {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .standards-list strong {
    color: var(--text-main);
  }

  /* Contact Callout Card with Bulletproof Mobile Wrapping */
  .contact-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06) 0%, rgba(56, 189, 248, 0.02) 100%);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 1.75rem 1.25rem;
    text-align: center;
    box-sizing: border-box;
    width: 100%;
  }

  .contact-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary-blue);
  }

  .contact-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 540px;
    margin: 0 auto 1.25rem;
  }

  .email-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    padding: 0.65rem 1.15rem;
    border-radius: 30px;
    max-width: 100%;
    box-sizing: border-box;
  }

  .email-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .email-link {
    color: var(--primary-blue);
    font-weight: 800;
    font-size: clamp(0.85rem, 3.5vw, 1.05rem);
    text-decoration: none;
    word-break: break-word;
    overflow-wrap: break-word;
    white-space: normal;
  }

  .email-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .about-card {
      padding: 1.25rem 1rem;
    }
    .contact-card {
      padding: 1.35rem 0.85rem;
    }
    .email-wrapper {
      width: 100%;
      padding: 0.6rem 0.75rem;
    }
  }
</style>
