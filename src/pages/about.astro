---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About Cyprus Student Guide';
const description = 'Independent, authentic, and research-backed resource built to help international students succeed in Cyprus.';
const permalink = 'https://cyprusstudentguide.com/about/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="about-container">
    <header class="about-header">
      <span class="badge">OUR MISSION</span>
      <h1>Empowering International Students in Cyprus</h1>
      <p class="lead">Hype-free, ground-tested information for students navigating life, work, and immigration in the Republic of Cyprus.</p>
    </header>

    <section class="about-content">
      <h2>Why Cyprus Student Guide Exists</h2>
      <p>Moving to a new country for higher education involves confusing paperwork, legal deadlines, banking hurdles, and daily survival challenges. Most online guides are generic or outdated.</p>
      
      <p><strong>Cyprus Student Guide</strong> was created to bridge this information gap with authentic, field-tested guidance covering everything from CRMD immigration deadlines, student banking compliance, affordable transportation, and grocery budget optimization to legal part-time employment.</p>

      <h2>Our Core Standards</h2>
      <ul>
        <li><strong>Factual Ground Reality:</strong> Verified against official government portals (CRMD, Ministry of Labour, Ministry of Transport) and actual expat student experiences.</li>
        <li><strong>Zero Regressions & Scams:</strong> Helping students avoid common rental scams, unverified agent advice, and high remittance transaction fees.</li>
        <li><strong>Community Driven:</strong> Built for students, by students living and studying across Limassol, Nicosia, Larnaca, and Paphos.</li>
      </ul>

      <div class="contact-card">
        <h3>Get in Touch</h3>
        <p>Have suggestions, questions regarding a guide, or want to collaborate?</p>
        <p class="email-row">
          ✉️ Email: <a href="mailto:contact@cyprusstudentguide.com">contact@cyprusstudentguide.com</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .about-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge {
    background: rgba(37, 99, 235, 0.15);
    color: var(--primary-blue);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .about-header h1 {
    font-size: 2.4rem;
    margin-bottom: 0.75rem;
  }

  .lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .about-content h2 {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .about-content p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .about-content ul {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
  }

  .about-content li {
    margin-bottom: 0.75rem;
    font-size: 1.02rem;
  }

  .contact-card {
    background: rgba(37, 99, 235, 0.06);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 1.75rem;
    margin-top: 3rem;
    text-align: center;
  }

  .contact-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    color: var(--primary-blue);
  }

  .contact-card p {
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .email-row a {
    color: var(--primary-blue);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .email-row a:hover {
    text-decoration: underline;
  }
</style>
