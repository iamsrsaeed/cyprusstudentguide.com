---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
  
  return Object.entries(postFiles).map(([filePath, post]: [string, any]) => {
    const frontmatter = post.frontmatter || {};
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = frontmatter.slug || fileSlug;
    
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content, frontmatter } = post;

const title = `${frontmatter.title} | Cyprus Student Guide`;
const description = frontmatter.description || '';
const permalink = `https://cyprusstudentguide.com/blog/${slug}/`;
const publishDate = frontmatter.publishDate || '2026-08-21';
const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <article class="post-single">
    <header class="post-header">
      <div class="post-meta">
        <span class="post-category">{frontmatter.category || 'General'}</span>
        <time datetime={publishDate}>{formattedDate}</time>
      </div>
      <h1>{frontmatter.title}</h1>
      <p class="post-lead">{frontmatter.description}</p>
      <div class="author-bar">
        <span>By <strong>{frontmatter.author || 'Saidur Rahman'}</strong></span>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <!-- Social Media Share Buttons at the end of each guide -->
    <ShareButtons 
      title={frontmatter.title} 
      url={permalink} 
      description={frontmatter.description} 
    />
  </article>
</BaseLayout>

<style>
  .post-single {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color, rgba(150, 150, 150, 0.2));
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .post-category {
    background: rgba(37, 99, 235, 0.15);
    color: var(--primary-blue, #38bdf8);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .post-header h1 {
    font-size: 2.35rem;
    line-height: 1.25;
    margin: 0.5rem 0 1rem;
    color: var(--text-main);
  }

  .post-lead {
    font-size: 1.15rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .author-bar {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
