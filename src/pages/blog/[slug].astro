---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/blog-posts/*.md', { eager: true });

  return Object.entries(posts).map(([filePath, post]: [string, any]) => {
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = post.frontmatter?.slug || fileSlug;
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, frontmatter, rawContent } = post;

const title = frontmatter.title;
const description = frontmatter.description;
const publishDate = frontmatter.publishDate;
const author = frontmatter.author || 'Saidur Rahman';
const category = frontmatter.category || 'General';
const permalink = `https://cyprusstudentguide.com/blog/${Astro.params.slug}/`;

// Dynamic Reading Time
const wordCount = rawContent ? rawContent().split(/\s+/).length : 600;
const readTime = Math.ceil(wordCount / 200);

// Distinct Professional Badge Icons per category
let categoryIcon = '📑';
let categoryThemeClass = 'theme-general';

const catLower = category.toLowerCase();
if (catLower.includes('immigration') || catLower.includes('legal')) {
  categoryIcon = '🏛️';
  categoryThemeClass = 'theme-immigration';
} else if (catLower.includes('finance') || catLower.includes('banking')) {
  categoryIcon = '💳';
  categoryThemeClass = 'theme-banking';
} else if (catLower.includes('job') || catLower.includes('work') || catLower.includes('tax')) {
  categoryIcon = '💼';
  categoryThemeClass = 'theme-jobs';
} else if (catLower.includes('living') || catLower.includes('housing') || catLower.includes('transport')) {
  categoryIcon = '🏠';
  categoryThemeClass = 'theme-living';
}

const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cyprus Student Guide",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cyprusstudentguide.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": permalink
  }
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <!-- Live Top Reading Progress Bar -->
  <div class="reading-progress-track">
    <div id="reading-progress-bar" class="reading-progress-fill"></div>
  </div>

  <article class="post-detail-container notranslate">
    <!-- Clean Minimalist Header Card -->
    <header class={`post-hero-card ${categoryThemeClass}`}>
      <div class="post-hero-meta-row">
        <span class="category-tag"><span class="cat-icon">{categoryIcon}</span> {category}</span>
        <span class="read-time-pill">⏱️ {readTime} min read</span>
        <time datetime={publishDate} class="date-pill">📅 {formattedDate}</time>
      </div>

      <h1 class="post-title">{title}</h1>
      
      <div class="author-row">
        <span>Verified Student Guide • By <strong>{author}</strong></span>
      </div>
    </header>

    <!-- Key Takeaways / Quick TL;DR Card -->
    <div class="tldr-box">
      <div class="tldr-header">
        <span class="tldr-badge">⚡ SUMMARY</span>
        <strong>Key Field Takeaways</strong>
      </div>
      <p>{description}</p>
    </div>

    <!-- Main Markdown Article Body -->
    <div class="post-content-body">
      <Content />
    </div>

    <!-- Smart Interactive Action Widget -->
    <div class="smart-tool-callout">
      <div class="smart-tool-icon">🛠️</div>
      <div class="smart-tool-info">
        <h3>Need to calculate or track this?</h3>
        <p>Use our verified offline-ready web tools designed for international students in Cyprus.</p>
        <div class="smart-tool-buttons">
          <a href="/pink-slip-tracker/" class="btn-smart-action">📋 Pink Slip Tracker</a>
          <a href="/shift-tracker/" class="btn-smart-action">🛵 Shift Tracker</a>
          <a href="/calculator/" class="btn-smart-action">💶 Cost Calculator</a>
        </div>
      </div>
    </div>

    <!-- Article Interactive Feedback & Share -->
    <div class="interactive-engagement-box">
      <div class="engagement-text">Was this guide helpful for your student journey?</div>
      <div class="engagement-actions">
        <button type="button" class="btn-feedback" id="feedback-yes">👍 Helpful</button>
        <button type="button" class="btn-feedback" id="feedback-copy">🔗 Copy Link</button>
      </div>
      <span id="feedback-msg" class="feedback-toast"></span>
    </div>

    <footer class="post-footer-area">
      <ShareButtons url={permalink} title={title} />
      <hr class="footer-divider" />
      <Bio />
    </footer>
  </article>
</BaseLayout>

<script is:inline>
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
    const bar = document.getElementById('reading-progress-bar');
    if (bar) bar.style.width = `${progress}%`;
  });

  const feedbackYes = document.getElementById('feedback-yes');
  const feedbackCopy = document.getElementById('feedback-copy');
  const feedbackMsg = document.getElementById('feedback-msg');

  if (feedbackYes) {
    feedbackYes.addEventListener('click', () => {
      feedbackYes.innerText = '🎉 Thank You!';
      feedbackYes.disabled = true;
    });
  }

  if (feedbackCopy) {
    feedbackCopy.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      if (feedbackMsg) {
        feedbackMsg.innerText = 'Link copied to clipboard!';
        feedbackMsg.style.display = 'inline-block';
        setTimeout(() => { feedbackMsg.style.display = 'none'; }, 2500);
      }
    });
  }
</script>

<style is:global>
  .post-content-body {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-wrap: break-word;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .post-content-body h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 2.25rem 0 0.85rem;
    color: var(--text-main);
    border-bottom: 1px solid var(--card-border);
    padding-bottom: 0.4rem;
  }

  .post-content-body h3 {
    font-size: 1.25rem;
    font-weight: 800;
    margin: 1.75rem 0 0.6rem;
    color: var(--primary-blue);
  }

  .post-content-body p {
    margin: 1.15rem 0;
    color: var(--text-main);
    text-align: left;
  }

  /* List & Bullet Point Boundary Lock */
  .post-content-body ul,
  .post-content-body ol {
    margin: 1.25rem 0 1.5rem 0 !important;
    padding-left: 2rem !important;
    list-style-position: outside !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  .post-content-body ul { list-style-type: disc !important; }
  .post-content-body ol { list-style-type: decimal !important; }

  .post-content-body li {
    margin: 0.65rem 0 !important;
    line-height: 1.65 !important;
    padding-left: 0.25rem !important;
  }

  /* Image Distortion Lock: Never stretch or deform */
  .post-content-body img {
    max-width: 100% !important;
    height: auto !important;
    aspect-ratio: 16/9;
    object-fit: cover !important;
    border-radius: 12px;
    margin: 1.75rem auto;
    display: block;
    border: 1px solid var(--card-border);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }

  /* Responsive Styled Tables in Markdown */
  .post-content-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--card-border);
    display: table;
  }

  .post-content-body th,
  .post-content-body td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--card-border);
    text-align: left;
    font-size: 0.92rem;
  }

  .post-content-body th {
    background: rgba(37, 99, 235, 0.08);
    font-weight: 800;
    color: var(--text-main);
  }

  .post-content-body blockquote {
    border-left: 4px solid var(--primary-blue);
    background: rgba(37, 99, 235, 0.05);
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 0 10px 10px 0;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .post-content-body ul,
    .post-content-body ol {
      padding-left: 1.5rem !important;
    }
    .post-content-body table {
      display: block;
      overflow-x: auto;
    }
    .post-content-body img {
      aspect-ratio: 16/10;
    }
  }
</style>

<style>
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: transparent;
    z-index: 9999;
  }
  .reading-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #2563eb, #38bdf8);
    transition: width 0.1s ease-out;
  }

  .post-detail-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 0.75rem 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Header Card */
  .post-hero-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    padding: 2.25rem 2rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .post-hero-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #2563eb, #38bdf8);
  }

  .theme-immigration::before { background: linear-gradient(90deg, #2563eb, #6366f1); }
  .theme-banking::before { background: linear-gradient(90deg, #059669, #10b981); }
  .theme-jobs::before { background: linear-gradient(90deg, #d97706, #f59e0b); }
  .theme-living::before { background: linear-gradient(90deg, #0284c7, #38bdf8); }

  .post-hero-meta-row {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .category-tag {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .read-time-pill, .date-pill {
    background: rgba(150, 150, 150, 0.08);
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.65rem;
    border-radius: 8px;
  }

  .post-title {
    font-size: clamp(1.75rem, 5vw, 2.45rem);
    font-weight: 900;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: var(--text-main);
  }

  .author-row {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Summary Box */
  .tldr-box {
    background: rgba(37, 99, 235, 0.04);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: 14px;
    padding: 1.35rem 1.5rem;
    margin-bottom: 2.25rem;
  }
  .tldr-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .tldr-badge {
    background: var(--primary-blue);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }
  .tldr-box p {
    margin: 0;
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Smart Tool Widget */
  .smart-tool-callout {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem;
    margin: 3rem 0 2rem;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  .smart-tool-icon {
    font-size: 2.2rem;
    line-height: 1;
  }
  .smart-tool-info h3 {
    margin: 0 0 0.4rem;
    font-size: 1.18rem;
    font-weight: 800;
  }
  .smart-tool-info p {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .smart-tool-buttons {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .btn-smart-action {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-size: 0.84rem;
    font-weight: 800;
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn-smart-action:hover {
    background: var(--primary-blue);
    color: #ffffff;
  }

  /* Feedback Box */
  .interactive-engagement-box {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .engagement-text {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-main);
  }
  .engagement-actions {
    display: flex;
    gap: 0.65rem;
  }
  .btn-feedback {
    background: rgba(150, 150, 150, 0.1);
    border: 1px solid var(--card-border);
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 700;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-feedback:hover {
    border-color: var(--primary-blue);
    color: var(--primary-blue);
  }
  .feedback-toast {
    display: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: #16a34a;
    width: 100%;
  }

  .post-footer-area { margin-top: 2rem; }
  .footer-divider {
    border: 0;
    border-top: 1px solid var(--card-border);
    margin: 2rem 0;
  }

  @media (max-width: 640px) {
    .post-hero-card { padding: 1.5rem 1.25rem; }
    .smart-tool-callout { flex-direction: column; padding: 1.25rem; }
    .interactive-engagement-box { flex-direction: column; text-align: center; }
  }
</style>
