---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/blog-posts/*.md', { eager: true });

  return Object.entries(posts).map(([filePath, post]: [string, any]) => {
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = post.frontmatter?.slug || fileSlug;
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content, frontmatter } = post;

const title = frontmatter.title;
const description = frontmatter.description;
const publishDate = frontmatter.publishDate;
const author = frontmatter.author || 'Saidur Rahman';
const category = frontmatter.category || 'General';
const permalink = `https://cyprusstudentguide.com/blog/${Astro.params.slug}/`;

const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cyprus Student Guide",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cyprusstudentguide.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": permalink
  }
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <article class="post-detail-container notranslate">
    <header class="post-header">
      <div class="post-meta-top">
        <span class="category-badge">{category}</span>
        <time datetime={publishDate}>{formattedDate}</time>
      </div>
      <h1 class="post-title">{title}</h1>
      <div class="author-row">
        <span>By <strong>{author}</strong></span>
      </div>
    </header>

    <!-- Main Markdown Article Content -->
    <div class="post-content-body">
      <Content />
    </div>

    <footer class="post-footer-area">
      <ShareButtons url={permalink} title={title} />
      <hr class="footer-divider" />
      <Bio />
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /* Global overrides strictly for rendered markdown body elements */
  .post-content-body {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  .post-content-body p {
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 1.25rem 0;
    color: var(--text-main);
    text-align: left;
  }

  /* List & Bullet Point Boundary Lock */
  .post-content-body ul,
  .post-content-body ol {
    margin: 1.25rem 0 1.5rem 0 !important;
    padding-left: 2rem !important;
    list-style-position: outside !important;
    box-sizing: border-box !important;
    width: 100% !important;
  }

  .post-content-body ul {
    list-style-type: disc !important;
  }

  .post-content-body ol {
    list-style-type: decimal !important;
  }

  .post-content-body li {
    margin: 0.65rem 0 !important;
    font-size: 1.02rem !important;
    line-height: 1.65 !important;
    padding-left: 0.35rem !important;
  }

  .post-content-body li p {
    margin: 0.35rem 0 !important;
  }

  /* Mobile Inset Protection */
  @media (max-width: 640px) {
    .post-content-body ul,
    .post-content-body ol {
      padding-left: 1.65rem !important;
    }

    .post-content-body li {
      font-size: 0.98rem !important;
    }

    .post-content-body p {
      font-size: 1rem;
      line-height: 1.7;
    }
  }
</style>

<style>
  .post-detail-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 1rem 0.5rem 4rem;
    width: 100%;
    box-sizing: border-box;
  }

  .post-header {
    text-align: left;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--card-border);
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .category-badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .post-title {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    font-weight: 900;
    line-height: 1.25;
    margin: 0 0 1rem;
    color: var(--text-main);
  }

  .author-row {
    font-size: 0.92rem;
    color: var(--text-muted);
  }

  .author-row strong {
    color: var(--text-main);
  }

  .post-footer-area {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
  }

  .footer-divider {
    border: 0;
    border-top: 1px solid var(--card-border);
    margin: 2rem 0;
  }

  @media (max-width: 640px) {
    .post-detail-container {
      padding: 0.5rem 0.25rem 3rem;
    }
  }
</style>
