---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
  
  const allPosts = Object.entries(postFiles).map(([filePath, post]: [string, any]) => {
    const frontmatter = post.frontmatter || {};
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = frontmatter.slug || fileSlug;
    return { post, slug, frontmatter };
  });

  return allPosts.map(({ post, slug, frontmatter }) => {
    const relatedPosts = allPosts
      .filter(p => p.slug !== slug)
      .slice(0, 3)
      .map(p => ({
        title: p.frontmatter.title,
        slug: p.slug,
        description: p.frontmatter.description,
        category: p.frontmatter.category || 'Guide'
      }));

    return {
      params: { slug },
      props: { post, slug, relatedPosts },
    };
  });
}

const { post, slug, relatedPosts } = Astro.props;
const { Content, frontmatter } = post;

const title = `${frontmatter.title} | Cyprus Student Guide`;
const description = frontmatter.description || '';
const permalink = `https://cyprusstudentguide.com/blog/${slug}/`;
const publishDate = frontmatter.publishDate || '2026-08-21';
const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});

const isoDate = new Date(publishDate).toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": permalink
  },
  "headline": frontmatter.title,
  "description": description,
  "image": "https://cyprusstudentguide.com/favicon.svg",
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": {
    "@type": "Person",
    "name": frontmatter.author || "Saidur Rahman",
    "url": "https://cyprusstudentguide.com/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cyprus Student Guide",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cyprusstudentguide.com/favicon.svg"
    }
  },
  "keywords": (frontmatter.tags || []).join(", ")
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cyprusstudentguide.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://cyprusstudentguide.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": frontmatter.title,
      "item": permalink
    }
  ]
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <!-- Google Structured Data (JSON-LD) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="post-single">
    <!-- Visual Hero Section Header -->
    <header class="post-hero-card">
      <div class="hero-meta-row">
        <span class="hero-category-pill">📌 {frontmatter.category || 'Official Guide'}</span>
        <div class="hero-date-badge">
          <span>📅 {formattedDate}</span>
          <span class="dot">•</span>
          <span>⏱️ 5 min read</span>
        </div>
      </div>

      <h1 class="hero-title">{frontmatter.title}</h1>
      <p class="hero-subtitle">{frontmatter.description}</p>
      
      <div class="hero-author-footer">
        <div class="author-avatar">SR</div>
        <div class="author-info">
          <span class="author-name">{frontmatter.author || 'Saidur Rahman'}</span>
          <span class="author-title">Verified Field Contributor • Cyprus</span>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="article-body">
      <Content />
    </div>

    <!-- Social Media Sharing Block -->
    <ShareButtons 
      title={frontmatter.title} 
      url={permalink} 
      description={frontmatter.description} 
    />

    <!-- Recommended / Related Guides Grid -->
    {relatedPosts && relatedPosts.length > 0 && (
      <section class="related-guides-section notranslate">
        <div class="related-header">
          <h3 class="related-title">📚 Recommended Next Guides</h3>
          <p class="related-sub">Essential guides every international student in Cyprus should read:</p>
        </div>
        <div class="related-grid">
          {relatedPosts.map((guide) => (
            <a href={`/blog/${guide.slug}/`} class="related-card">
              <span class="related-badge">{guide.category}</span>
              <h4 class="related-card-title">{guide.title}</h4>
              <p class="related-card-desc">{guide.description}</p>
              <span class="read-more-link">Read Guide ➔</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <!-- Compact Mobile Floating Share Bar -->
  <aside class="mobile-floating-bar notranslate">
    <div class="floating-inner">
      <span class="float-label">Share:</span>
      <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(frontmatter.title + ' - ' + permalink)}`} target="_blank" rel="noopener noreferrer" class="float-btn wa-btn">
        WhatsApp
      </a>
      <a href={`https://t.me/share/url?url=${encodeURIComponent(permalink)}&text=${encodeURIComponent(frontmatter.title)}`} target="_blank" rel="noopener noreferrer" class="float-btn tg-btn">
        Telegram
      </a>
      <button type="button" id="copy-link-btn" class="float-btn copy-btn">
        🔗 Copy
      </button>
    </div>
  </aside>

  <!-- Global Toast Notification -->
  <div id="toast-msg" class="toast-msg">✅ Link Copied!</div>
</BaseLayout>

<script is:inline>
  function handleBlogPageInteractions() {
    // ১. রিডিং প্রোগ্রেস বার (হেডারের সাথে সিঙ্ক)
    const progressBar = document.getElementById('site-reading-progress');
    
    function updateProgress() {
      if (!progressBar) return;
      const totalScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      
      if (windowHeight > 0) {
        const scrollPercent = (totalScroll / windowHeight) * 100;
        progressBar.style.width = Math.min(100, Math.max(0, scrollPercent)) + '%';
      }
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();

    // ২. কপি লিংক হ্যান্ডলার
    const copyBtn = document.getElementById('copy-link-btn');
    const toast = document.getElementById('toast-msg');

    if (copyBtn) {
      copyBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        const currentUrl = window.location.href;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(currentUrl);
          } else {
            const tempInput = document.createElement('input');
            tempInput.value = currentUrl;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
          }

          copyBtn.innerText = 'Copied!';
          if (toast) {
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 2200);
          }
          setTimeout(() => {
            copyBtn.innerText = '🔗 Copy';
          }, 2000);
        } catch (err) {
          console.error('Copy failed: ', err);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handleBlogPageInteractions);
  } else {
    handleBlogPageInteractions();
  }
</script>

<style>
  .post-single {
    max-width: 840px;
    margin: 0 auto;
  }

  /* Visual Hero Card */
  .post-hero-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(56, 189, 248, 0.03) 100%);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    margin-bottom: 2.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }

  html.dark .post-hero-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
  }

  .hero-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero-category-pill {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }

  .hero-date-badge {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-title {
    font-size: 2.35rem;
    line-height: 1.25;
    margin: 0 0 1rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0 0 1.75rem;
  }

  .hero-author-footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--card-border);
  }

  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-title {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* Related Guides Section */
  .related-guides-section {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 2px dashed var(--card-border);
  }

  .related-header {
    margin-bottom: 1.5rem;
  }

  .related-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--primary-blue);
    margin: 0 0 0.4rem;
  }

  .related-sub {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .related-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-blue);
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.12);
  }

  .related-badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.6rem;
  }

  .related-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }

  .related-card-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-blue);
  }

  /* Compact Mobile Floating Bar */
  .mobile-floating-bar {
    display: none;
    position: fixed;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 32px);
    max-width: 380px;
    background: rgba(15, 23, 42, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.45rem 0.75rem;
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
  }

  .floating-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
  }

  .float-label {
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding-left: 0.25rem;
  }

  .float-btn {
    text-decoration: none;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.35rem 0.7rem;
    border-radius: 30px;
    display: inline-flex;
    align-items: center;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .float-btn:active { transform: scale(0.95); }
  .wa-btn { background: #22c55e; color: #ffffff; }
  .tg-btn { background: #0284c7; color: #ffffff; }
  .copy-btn { background: #334155; color: #f8fafc; }

  /* Minimal Toast */
  .toast-msg {
    visibility: hidden;
    position: fixed;
    bottom: 70px;
    left: 50%;
    transform: translateX(-50%);
    background: #0f172a;
    color: #38bdf8;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.82rem;
    font-weight: 700;
    border: 1px solid rgba(56, 189, 248, 0.4);
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    z-index: 100000;
    opacity: 0;
    transition: opacity 0.25s, visibility 0.25s;
  }

  .toast-msg.show {
    visibility: visible;
    opacity: 1;
  }

  @media (max-width: 768px) {
    .mobile-floating-bar {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .post-hero-card {
      padding: 1.5rem 1.25rem;
    }
    .hero-title {
      font-size: 1.85rem;
    }
  }
</style>
