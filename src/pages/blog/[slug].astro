---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import MiniTaxCalc from '../../components/MiniTaxCalc.astro';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
  const allPostsList = Object.entries(posts).map(([filePath, post]: [string, any]) => {
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = post.frontmatter?.slug || fileSlug;
    return {
      slug,
      title: post.frontmatter?.title || 'Student Guide',
      category: post.frontmatter?.category || 'Living & Survival',
      publishDate: post.frontmatter?.publishDate || '2026-08-16',
      post
    };
  }).sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

  return allPostsList.map((item) => {
    // স্বয়ংক্রিয়ভাবে বর্তমান পোস্ট বাদে ৪টি নতুন ও রিলেটেড পোস্ট বেছে নেবে
    const relatedPosts = allPostsList
      .filter((p) => p.slug !== item.slug)
      .slice(0, 4);

    return {
      params: { slug: item.slug },
      props: { post: item.post, relatedPosts },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { Content, frontmatter, rawContent } = post;

const title = frontmatter.title;
const description = frontmatter.description;
const publishDate = frontmatter.publishDate;
const author = frontmatter.author || 'Saidur Rahman';
const category = frontmatter.category || 'Living & Survival';
const currentSlug = Astro.params.slug || '';
const permalink = `https://cyprusstudentguide.com/blog/${currentSlug}/`;

// ক্যাটাগরি কালার ও আইকন ম্যাপিং
let categoryIcon = '📌';
let categoryThemeClass = 'theme-general';

const catLower = category.toLowerCase();
if (catLower.includes('immigration') || catLower.includes('visa')) {
  categoryIcon = '🏛️';
  categoryThemeClass = 'theme-immigration';
} else if (catLower.includes('work') || catLower.includes('job')) {
  categoryIcon = '💼';
  categoryThemeClass = 'theme-jobs';
} else if (catLower.includes('bank') || catLower.includes('tax')) {
  categoryIcon = '💳';
  categoryThemeClass = 'theme-banking';
} else if (catLower.includes('living') || catLower.includes('grocer') || catLower.includes('transport')) {
  categoryIcon = '🛒';
  categoryThemeClass = 'theme-living';
}

const showTaxWidget = 
  catLower.includes('work') || 
  catLower.includes('job') || 
  catLower.includes('tax') || 
  currentSlug.includes('part-time-work') || 
  currentSlug.includes('gesy');

const text = typeof rawContent === 'function' ? rawContent() : '';
const wordCount = text.split(/\s+/g).length;
const readTime = Math.max(2, Math.ceil(wordCount / 200));

const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

// গুগল রিচ স্নsnippet-এর জন্য স্কিমা
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishDate,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cyprus Student Guide",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cyprusstudentguide.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": permalink
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cyprusstudentguide.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Guides",
      "item": "https://cyprusstudentguide.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": permalink
    }
  ]
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="reading-progress-track">
    <div id="reading-progress-bar" class="reading-progress-fill"></div>
  </div>

  <article class="post-detail-container">
    <header class={`post-hero-card ${categoryThemeClass}`}>
      <div class="post-hero-meta-row">
        <span class="category-tag"><span class="cat-icon notranslate">{categoryIcon}</span> {category}</span>
        <span class="read-time-pill notranslate">⏱️ {readTime} min read</span>
        <time datetime={publishDate} class="date-pill notranslate">📅 {formattedDate}</time>
      </div>

      <h1 class="post-title">{title}</h1>
      
      <div class="author-row">
        <span>Verified Student Guide • By <strong>{author}</strong></span>
      </div>
    </header>

    <div class="tldr-box">
      <div class="tldr-header">
        <span class="tldr-badge notranslate">⚡ SUMMARY</span>
        <strong>Key Field Takeaways</strong>
      </div>
      <p>{description}</p>
    </div>

    <div class="post-content-body">
      <Content />
    </div>

    {showTaxWidget && <MiniTaxCalc />}

    <div class="smart-tool-callout">
      <div class="smart-tool-icon notranslate">🛠️</div>
      <div class="smart-tool-info">
        <h3>Track Shifts & Split Courier Fuel Payouts</h3>
        <p>Log your delivery shifts (Wolt / Foody), calculate accurate 8.3% Social Insurance & 2.65% GeSY deductions, and generate audit slips.</p>
      </div>
      <a href="/shift-tracker/" class="smart-tool-btn">Open Shift Tracker ➔</a>
    </div>

    <!-- ৪টি ডাইনামিক পোস্টের ইন্টারনাল লিংক ইঞ্জিন (এসইও বুস্টার) -->
    <div class="related-guides-section notranslate">
      <h3 class="related-title">📌 Essential Student Guides & Handbooks</h3>
      <div class="related-grid">
        {relatedPosts.map((rel: any) => (
          <a href={`/blog/${rel.slug}/`} class="related-card">
            <span class="related-card-tag tag-blue">{rel.category}</span>
            <h4 class="related-card-heading">{rel.title} ➔</h4>
          </a>
        ))}
      </div>
    </div>

    <footer class="post-footer-section">
      <div class="share-box-wrap">
        <span class="share-label">Help fellow students in Cyprus:</span>
        <ShareButtons title={title} url={permalink} />
      </div>
      <Bio />
    </footer>

    <div class="back-hub-wrap">
      <a href="/blog/" class="back-hub-link">← Return to All Guides & Articles</a>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = (window.scrollY / totalHeight) * 100;
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      bar.style.width = Math.min(100, Math.max(0, progress)) + '%';
    }
  });
</script>

<style>
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: transparent;
    z-index: 99999;
    pointer-events: none;
  }
  .reading-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #2563eb, #0284c7);
    transition: width 0.08s ease-out;
  }

  .post-detail-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 0.75rem 4rem;
  }

  .post-hero-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 2.25rem 2rem 2rem;
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  .post-hero-card:before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
  }
  .theme-immigration:before { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
  .theme-banking:before { background: linear-gradient(90deg, #059669, #10b981); }
  .theme-jobs:before { background: linear-gradient(90deg, #f59e0b, #d97706); }
  .theme-living:before { background: linear-gradient(90deg, #0284c7, #0ea5e9); }
  .theme-general:before { background: linear-gradient(90deg, #2563eb, #3b82f6); }

  .post-hero-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .category-tag {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .read-time-pill, .date-pill {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .post-title {
    font-size: clamp(1.6rem, 4vw, 2.35rem);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1rem;
  }
  .author-row {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .tldr-box {
    background: rgba(37, 99, 235, 0.05);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-left: 4px solid var(--primary-blue);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }
  .tldr-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .tldr-badge {
    background: var(--primary-blue);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 900;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }
  .tldr-box p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-main);
    margin: 0;
  }

  .post-content-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-main);
  }

  .smart-tool-callout {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 3rem 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .smart-tool-icon {
    font-size: 2.2rem;
  }
  .smart-tool-info h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
  }
  .smart-tool-info p {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
  }
  .smart-tool-btn {
    margin-left: auto;
    white-space: nowrap;
    background: var(--primary-blue);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.88rem;
    padding: 0.65rem 1.2rem;
    border-radius: 8px;
  }

  .related-guides-section {
    margin: 3.5rem 0 2rem;
  }
  .related-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }
  .related-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.25rem;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary-blue);
  }
  .related-card-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--primary-blue);
    text-transform: uppercase;
  }
  .related-card-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.4;
    margin: 0;
  }

  .post-footer-section {
    border-top: 1px dashed var(--card-border);
    padding-top: 2rem;
    margin-top: 3rem;
  }
  .share-box-wrap {
    margin-bottom: 2rem;
    text-align: center;
  }
  .share-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .back-hub-wrap {
    text-align: center;
    margin-top: 2.5rem;
  }
  .back-hub-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-decoration: none;
  }
  .back-hub-link:hover { text-decoration: underline; }

  @media (max-width: 640px) {
    .smart-tool-callout {
      flex-direction: column;
      align-items: flex-start;
    }
    .smart-tool-btn {
      margin-left: 0;
      width: 100%;
      text-align: center;
    }
  }
</style>
