---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
  
  return Object.entries(postFiles).map(([filePath, post]: [string, any]) => {
    const frontmatter = post.frontmatter || {};
    const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
    const slug = frontmatter.slug || fileSlug;
    
    return {
      params: { slug },
      props: { post, slug },
    };
  });
}

const { post, slug } = Astro.props;
const { Content, frontmatter } = post;

const title = `${frontmatter.title} | Cyprus Student Guide`;
const description = frontmatter.description || '';
const permalink = `https://cyprusstudentguide.com/blog/${slug}/`;
const publishDate = frontmatter.publishDate || '2026-08-21';
const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});

// ISO 8601 টাইম ফরম্যাট (Schema Warnings দূর করার জন্য)
const isoDate = new Date(publishDate).toISOString();

// ১. Article Schema (Clean & Warning-Free)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": permalink
  },
  "headline": frontmatter.title,
  "description": description,
  "image": "https://cyprusstudentguide.com/favicon.svg",
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": {
    "@type": "Person",
    "name": frontmatter.author || "Saidur Rahman",
    "url": "https://cyprusstudentguide.com/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Cyprus Student Guide",
    "logo": {
      "@type": "ImageObject",
      "url": "https://cyprusstudentguide.com/favicon.svg"
    }
  },
  "keywords": (frontmatter.tags || []).join(", ")
};

// ২. Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://cyprusstudentguide.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://cyprusstudentguide.com/blog/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": frontmatter.title,
      "item": permalink
    }
  ]
};
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <!-- Google Structured Data (JSON-LD) -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="post-single">
    <!-- Visual Hero Section Header -->
    <header class="post-hero-card">
      <div class="hero-meta-row">
        <span class="hero-category-pill">📌 {frontmatter.category || 'Official Guide'}</span>
        <div class="hero-date-badge">
          <span>📅 {formattedDate}</span>
          <span class="dot">•</span>
          <span>⏱️ 5 min read</span>
        </div>
      </div>

      <h1 class="hero-title">{frontmatter.title}</h1>
      <p class="hero-subtitle">{frontmatter.description}</p>
      
      <div class="hero-author-footer">
        <div class="author-avatar">SR</div>
        <div class="author-info">
          <span class="author-name">{frontmatter.author || 'Saidur Rahman'}</span>
          <span class="author-title">Verified Field Contributor • Cyprus</span>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="article-body">
      <Content />
    </div>

    <!-- Social Media Sharing Block -->
    <ShareButtons 
      title={frontmatter.title} 
      url={permalink} 
      description={frontmatter.description} 
    />
  </article>
</BaseLayout>

<style>
  .post-single {
    max-width: 840px;
    margin: 0 auto;
  }

  /* Visual Hero Card Styling */
  .post-hero-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(56, 189, 248, 0.03) 100%);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    margin-bottom: 2.75rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }

  html.dark .post-hero-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.9) 100%);
  }

  .hero-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero-category-pill {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }

  .hero-date-badge {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-title {
    font-size: 2.35rem;
    line-height: 1.25;
    margin: 0 0 1rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .hero-subtitle {
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0 0 1.75rem;
  }

  .hero-author-footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--card-border);
  }

  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.9rem;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .author-title {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .post-hero-card {
      padding: 1.5rem 1.25rem;
    }
    .hero-title {
      font-size: 1.85rem;
    }
  }
</style>
