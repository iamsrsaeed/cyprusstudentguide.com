---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Cyprus Student Guides & Articles | Knowledge Base';
const description = 'Practical, authentic, and step-by-step guides covering student immigration, part-time work, banking, and daily budgeting in Cyprus.';
const permalink = 'https://cyprusstudentguide.com/blog/';

const postFiles = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
const allPosts = Object.entries(postFiles).map(([filePath, post]: [string, any]) => {
  const frontmatter = post.frontmatter || {};
  const fileSlug = filePath.split('/').pop()?.replace('.md', '') || '';
  const slug = frontmatter.slug || fileSlug;
  const category = frontmatter.category || 'General';

  // Dynamic 3D Thumbnail for Blog Listing Cards
  let thumb = '/assets/blog/casual-life-3d-workspace.webp';
  if (category.toLowerCase().includes('immigration') || category.toLowerCase().includes('legal')) {
    thumb = '/assets/blog/casual-life-3d-girl-boy-poses.webp';
  } else if (category.toLowerCase().includes('finance') || category.toLowerCase().includes('banking') || category.toLowerCase().includes('living')) {
    thumb = '/assets/blog/casual-life-3d-meditation-crystal.webp';
  }

  return {
    slug,
    title: frontmatter.title || 'Student Guide',
    description: frontmatter.description || '',
    category: category,
    publishDate: frontmatter.publishDate || '2026-08-16',
    thumb: thumb,
    rawText: `${frontmatter.title} ${frontmatter.description} ${category}`.toLowerCase()
  };
}).sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

const categories = ['All', ...new Set(allPosts.map(p => p.category))];
---

<BaseLayout title={title} description={description} permalink={permalink} current="guides">
  <div class="blog-hub-container notranslate">
    
    <!-- Hero Header -->
    <header class="blog-hub-header">
      <span class="hub-badge">KNOWLEDGE BASE</span>
      <h1>Student Guides & Articles</h1>
      <p class="hub-desc">Practical, hype-free insights on part-time work, banking, public transit, and smart budgeting in Cyprus.</p>
    </header>

    <!-- Search & Filter Controls -->
    <div class="controls-panel">
      <div class="search-box-wrap">
        <input 
          type="text" 
          id="guide-search-input" 
          placeholder="🔍 Search guides (e.g., Lidl, Bank, Pink Slip, Tax, Bus, Work)..." 
          aria-label="Search student guides"
        />
      </div>

      <div class="category-pills-row">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`category-pill ${idx === 0 ? 'active' : ''}`} 
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="filter-status-row">
        <span id="results-count-text">Showing <strong>{allPosts.length}</strong> of {allPosts.length} articles</span>
      </div>
    </div>

    <!-- Articles Grid with 3D Graphic Cards -->
    <div class="articles-grid" id="articles-grid">
      {allPosts.map((post) => (
        <article 
          class="article-card" 
          data-category={post.category} 
          data-search-content={post.rawText}
        >
          <div class="card-thumb-wrap">
            <img src={post.thumb} alt={post.category} loading="lazy" width="80" height="80" />
          </div>
          <div class="card-body">
            <div class="card-meta">
              <span class="cat-tag">{post.category}</span>
              <span class="date-tag">{new Date(post.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}</span>
            </div>
            <h2 class="card-title">
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="card-excerpt">{post.description}</p>
            <a href={`/blog/${post.slug}/`} class="card-read-link">Read Full Guide ➔</a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results-box" class="no-results-card" style="display: none;">
      <div class="no-results-icon">🔎</div>
      <h3>No matching guides found</h3>
      <p>Try searching with different keywords like "bank", "jobs", "lidl", or clear the filter.</p>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  function initSearchFilter() {
    const searchInput = document.getElementById('guide-search-input');
    const catButtons = document.querySelectorAll('.category-pill');
    const articles = document.querySelectorAll('.article-card');
    const countText = document.getElementById('results-count-text');
    const noResults = document.getElementById('no-results-box');

    let activeCat = 'All';
    let searchQuery = '';

    function filterGuides() {
      let visibleCount = 0;

      articles.forEach(article => {
        const artCat = article.getAttribute('data-category');
        const artSearch = article.getAttribute('data-search-content') || '';

        const matchesCat = (activeCat === 'All' || artCat === activeCat);
        const matchesQuery = !searchQuery || artSearch.includes(searchQuery);

        if (matchesCat && matchesQuery) {
          article.style.display = 'flex';
          visibleCount++;
        } else {
          article.style.display = 'none';
        }
      });

      if (countText) {
        countText.innerHTML = `Showing <strong>${visibleCount}</strong> of ${articles.length} articles`;
      }

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterGuides();
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCat = btn.getAttribute('data-category') || 'All';
        filterGuides();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initSearchFilter);
</script>

<style>
  .blog-hub-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 1rem 0.75rem 4rem;
  }

  .blog-hub-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .hub-badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-blue);
    font-size: 0.76rem;
    font-weight: 800;
    padding: 0.35rem 0.85rem;
    border-radius: 30px;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .blog-hub-header h1 {
    font-size: clamp(2rem, 4.5vw, 2.7rem);
    font-weight: 900;
    margin: 0 0 0.6rem;
  }
  .hub-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Controls Panel */
  .controls-panel {
    margin-bottom: 2.5rem;
  }
  .search-box-wrap {
    margin-bottom: 1.25rem;
  }
  #guide-search-input {
    width: 100%;
    background: var(--card-bg);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 0.85rem 1.15rem;
    font-family: inherit;
    font-size: 0.98rem;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-sizing: border-box;
  }
  #guide-search-input:focus {
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .category-pills-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .category-pill {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 0.85rem;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .category-pill:hover,
  .category-pill.active {
    background: var(--primary-blue);
    color: #ffffff;
    border-color: var(--primary-blue);
  }

  .filter-status-row {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.5rem;
  }
  .article-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--primary-blue);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
  }

  .card-thumb-wrap {
    background: rgba(37, 99, 235, 0.04);
    border-radius: 12px;
    padding: 0.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .card-thumb-wrap img {
    height: 70px;
    width: auto;
    object-fit: contain;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  .cat-tag {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--primary-blue);
  }
  .date-tag {
    font-size: 0.74rem;
    color: var(--text-muted);
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }
  .card-title a {
    color: var(--text-main);
    text-decoration: none;
  }
  .card-title a:hover { color: var(--primary-blue); }
  .card-excerpt {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    flex-grow: 1;
    margin: 0 0 1rem;
  }
  .card-read-link {
    color: var(--primary-blue);
    font-weight: 800;
    font-size: 0.84rem;
    text-decoration: none;
  }

  /* No results state */
  .no-results-card {
    text-align: center;
    background: var(--card-bg);
    border: 1px dashed var(--card-border);
    border-radius: 16px;
    padding: 3rem 1.5rem;
  }
  .no-results-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
  .no-results-card h3 { margin: 0 0 0.35rem; font-size: 1.25rem; }
  .no-results-card p { color: var(--text-muted); margin: 0; }
</style>
