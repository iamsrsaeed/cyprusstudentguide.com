---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Blog & Student Guides';
const description = 'Practical guides, tips, and essential survival advice for international students in Cyprus.';
const permalink = 'https://cyprusstudentguide.com/blog/';

// Load all markdown files directly using import.meta.glob (Safe across all structures)
const postFiles = import.meta.glob('../../data/blog-posts/*.md', { eager: true });
const fallbackFiles = import.meta.glob('../../../src/data/blog-posts/*.md', { eager: true });
const postsSource = Object.keys(postFiles).length > 0 ? postFiles : fallbackFiles;

const allPosts = Object.values(postsSource).map((post: any) => {
  const frontmatter = post.frontmatter || {};
  const fileSlug = post.file ? post.file.split('/').pop().replace('.md', '') : '';
  const slug = frontmatter.slug || fileSlug;
  
  return {
    slug,
    title: frontmatter.title || 'Untitled Post',
    description: frontmatter.description || '',
    publishDate: frontmatter.publishDate || '2026-08-16',
    author: frontmatter.author || 'Saidur Rahman',
    category: frontmatter.category || 'General',
  };
});

// Default sort: Newest first
const sortedPosts = allPosts.sort((a, b) => {
  return new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime();
});
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="blog-container">
    <header class="blog-header">
      <span class="badge">KNOWLEDGE BASE</span>
      <h1>Student Guides & Articles</h1>
      <p>Practical, hype-free insights on part-time work, banking, public transit, and smart budgeting in Cyprus.</p>
    </header>

    <div class="controls-bar">
      <div class="post-count">
        Showing <span id="visible-count">{sortedPosts.length}</span> articles
      </div>
      
      <div class="sort-wrapper">
        <label for="sort-select">Sort by:</label>
        <select id="sort-select" aria-label="Sort blog posts">
          <option value="newest">Newest First</option>
          <option value="oldest">Oldest First</option>
          <option value="title">Title (A-Z)</option>
        </select>
      </div>
    </div>

    <div class="posts-grid" id="posts-container">
      {sortedPosts.map((post) => {
        const publishTime = new Date(post.publishDate).getTime();
        const formattedDate = new Date(post.publishDate).toLocaleDateString('en-GB', {
          day: 'numeric',
          month: 'short',
          year: 'numeric'
        });

        return (
          <article 
            class="post-card" 
            data-date={publishTime} 
            data-title={post.title.toLowerCase()}
          >
            <div class="post-meta">
              <span class="post-category">{post.category}</span>
              <time datetime={post.publishDate}>{formattedDate}</time>
            </div>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p>{post.description}</p>
            <div class="post-footer">
              <span class="author">By {post.author}</span>
              <a href={`/blog/${post.slug}/`} class="read-more">Read Guide →</a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge {
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-color, #2563eb);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .blog-header h1 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
    color: var(--text-main, #1e293b);
  }

  .blog-header p {
    color: var(--text-secondary, #64748b);
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(150, 150, 150, 0.2);
    font-size: 0.9rem;
    color: var(--text-secondary, #64748b);
  }

  .sort-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sort-wrapper select {
    background: rgba(150, 150, 150, 0.08);
    color: inherit;
    border: 1px solid rgba(150, 150, 150, 0.3);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: var(--card-bg, #ffffff);
    border: 1px solid rgba(150, 150, 150, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.08);
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-secondary, #64748b);
    margin-bottom: 0.75rem;
  }

  .post-category {
    background: rgba(150, 150, 150, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  .post-card h2 {
    font-size: 1.2rem;
    line-height: 1.4;
    margin: 0 0 0.75rem;
  }

  .post-card h2 a {
    color: var(--text-main, #1e293b);
    text-decoration: none;
  }

  .post-card h2 a:hover {
    color: var(--primary-color, #2563eb);
  }

  .post-card p {
    color: var(--text-secondary, #64748b);
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    border-top: 1px solid rgba(150, 150, 150, 0.15);
    padding-top: 0.75rem;
  }

  .read-more {
    color: var(--primary-color, #2563eb);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .controls-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  function initPostSorting() {
    const sortSelect = document.getElementById('sort-select');
    const postsContainer = document.getElementById('posts-container');
    
    if (!sortSelect || !postsContainer) return;

    sortSelect.addEventListener('change', () => {
      const criteria = sortSelect.value;
      const cards = Array.from(postsContainer.querySelectorAll('.post-card'));

      cards.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date') || '0', 10);
        const dateB = parseInt(b.getAttribute('data-date') || '0', 10);
        const titleA = (a.getAttribute('data-title') || '').trim();
        const titleB = (b.getAttribute('data-title') || '').trim();

        if (criteria === 'newest') {
          return dateB - dateA;
        } else if (criteria === 'oldest') {
          return dateA - dateB;
        } else if (criteria === 'title') {
          return titleA.localeCompare(titleB);
        }
        return 0;
      });

      postsContainer.innerHTML = '';
      cards.forEach(card => postsContainer.appendChild(card));
    });
  }

  document.addEventListener('DOMContentLoaded', initPostSorting);
</script>
