---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Us | Cyprus Student Guide';
const description = 'Get in touch with the Cyprus Student Guide editorial desk for inquiries, corrections, or collaborations.';
const permalink = 'https://cyprusstudentguide.com/contact/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="contact">
  <div class="contact-page-container">
    <header class="page-header">
      <span class="badge">HELP & SUPPORT DESK</span>
      <h1>Contact the Editorial Team</h1>
      <p class="subtitle">Have questions about student procedures, spotted a policy update, or want to contribute field data?</p>
    </header>

    <div class="contact-grid">
      <div class="contact-card primary-contact">
        <div class="icon">✉️</div>
        <h2>Direct Email Inquiries</h2>
        <p>For student guidance queries, correction requests, and institutional collaborations:</p>
        <a href="mailto:contact@cyprusstudentguide.com" class="email-btn">contact@cyprusstudentguide.com</a>
        <span class="response-time">⏱️ Average response time: 24–48 business hours</span>
      </div>

      <div class="info-card">
        <h3>What We Assist With</h3>
        <ul>
          <li><strong>Immigration & Residency:</strong> General inquiries on CRMD procedures, biometric appointments, and Pink Slip medicals.</li>
          <li><strong>Corrections & Takedowns:</strong> Submitting updated government fee notices or landlord/Mukhtar regulation shifts.</li>
          <li><strong>Student Experience Stories:</strong> Sharing your verified onboarding or accommodation journey in Cyprus.</li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .badge {
    background: rgba(37, 99, 235, 0.12);
    color: var(--primary-blue);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    display: inline-block;
    margin-bottom: 0.85rem;
  }

  .page-header h1 {
    font-size: 2.3rem;
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-card {
    background: rgba(37, 99, 235, 0.05);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .contact-card h2 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .contact-card p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.02rem;
  }

  .email-btn {
    display: inline-block;
    background: var(--primary-blue);
    color: #ffffff;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1.05rem;
    transition: opacity 0.15s ease;
  }

  .email-btn:hover {
    opacity: 0.9;
  }

  .response-time {
    display: block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .info-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2rem;
  }

  .info-card h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
    color: var(--primary-blue);
  }

  .info-card ul {
    margin: 0;
    padding-left: 1.35rem;
  }

  .info-card li {
    margin-bottom: 0.75rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }
</style>
