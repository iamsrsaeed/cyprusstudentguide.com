---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact Us | Cyprus Student Guide';
const description = 'Get in touch with the Cyprus Student Guide editorial desk for inquiries, corrections, or collaborations.';
const permalink = 'https://cyprusstudentguide.com/contact/';
---

<BaseLayout title={title} description={description} permalink={permalink} current="contact">
  <div class="contact-page-container notranslate">
    <header class="page-header">
      <span class="badge">HELP & SUPPORT DESK</span>
      <h1>Contact the Editorial Team</h1>
      <p class="subtitle">Have questions about student procedures, spotted a policy update, or want to contribute verified field data?</p>
    </header>

    <div class="contact-grid">
      <!-- Direct Email Action Box -->
      <div class="contact-card primary-contact">
        <div class="icon">✉️</div>
        <h2>Direct Email Inquiries</h2>
        <p class="contact-sub">For student guidance queries, correction requests, and institutional collaborations:</p>
        
        <div class="email-btn-wrap">
          <a href="mailto:contact@cyprusstudentguide.com" class="email-btn">
            contact@cyprusstudentguide.com
          </a>
        </div>
        
        <span class="response-time">⏱️ Average response time: 24–48 business hours</span>
      </div>

      <!-- Scope of Assistance Card -->
      <div class="info-card">
        <h3>What We Assist With</h3>
        <ul>
          <li>
            <strong>Immigration & Residency:</strong> Clarifications on CRMD appointment rules, Mukhtar certification, and Pink Slip medical screenings[cite: 1, 2].
          </li>
          <li>
            <strong>Corrections & Updates:</strong> Submitting newly published government wage decrees, bus fares, or banking fee adjustments[cite: 1, 2].
          </li>
          <li>
            <strong>Student Stories:</strong> Sharing your verified accommodation and job search experiences to help incoming students[cite: 1, 2].
          </li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 0.75rem 4rem;
    box-sizing: border-box;
    width: 100%;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .badge {
    background: rgba(37, 99, 235, 0.12);
    color: var(--primary-blue);
    padding: 0.35rem 0.85rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    display: inline-block;
    margin-bottom: 0.85rem;
    letter-spacing: 0.04em;
  }

  .page-header h1 {
    font-size: clamp(1.75rem, 5vw, 2.3rem);
    font-weight: 900;
    margin: 0 0 0.75rem;
    line-height: 1.25;
    color: var(--text-main);
  }

  .subtitle {
    font-size: clamp(0.95rem, 2.5vw, 1.1rem);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .contact-card {
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.06) 0%, rgba(56, 189, 248, 0.02) 100%);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 2.25rem 1.25rem;
    text-align: center;
    box-sizing: border-box;
    width: 100%;
  }

  .icon {
    font-size: 2.3rem;
    margin-bottom: 0.65rem;
  }

  .contact-card h2 {
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0 0 0.4rem;
    color: var(--text-main);
  }

  .contact-sub {
    color: var(--text-muted);
    margin: 0 auto 1.35rem;
    font-size: 0.96rem;
    line-height: 1.5;
    max-width: 520px;
  }

  .email-btn-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .email-btn {
    display: inline-block;
    background: var(--primary-blue);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    font-weight: 800;
    font-size: clamp(0.85rem, 3.6vw, 1.05rem);
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    box-sizing: border-box;
    text-align: center;
  }

  .email-btn:hover {
    background: var(--primary-blue-hover);
    transform: translateY(-2px);
  }

  .response-time {
    display: block;
    margin-top: 1.15rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .info-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
  }

  .info-card h3 {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 1rem;
    color: var(--primary-blue);
  }

  .info-card ul {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-card li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .info-card strong {
    color: var(--text-main);
  }

  @media (max-width: 600px) {
    .contact-card {
      padding: 1.5rem 1rem;
    }
    .info-card {
      padding: 1.35rem 1rem;
    }
    .email-btn {
      width: 100%;
      padding: 0.7rem 0.5rem;
    }
  }
</style>
