---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found (404) | Cyprus Student Guide';
const description = 'The page you are looking for does not exist or has been moved.';
const permalink = 'https://cyprusstudentguide.com/404/';
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="error-container">
    <div class="error-code">404</div>
    <h1>Page Not Found</h1>
    <p class="error-desc">The survival guide or resource you were looking for might have been updated, relocated, or temporarily removed.</p>
    
    <div class="quick-links">
      <a href="/" class="btn-primary">Return to Home</a>
      <a href="/blog/" class="btn-secondary">Browse All Guides</a>
    </div>

    <div class="popular-picks">
      <p class="picks-label">Popular Verified Guides:</p>
      <ul>
        <li><a href="/blog/cyprus-student-medical-test-health-insurance-guide/">🏥 Student Medical & Pink Slip Guide</a></li>
        <li><a href="/blog/how-to-open-bank-account-cyprus-student-immigration-guide/">💳 Bank Account Opening Walkthrough</a></li>
        <li><a href="/blog/how-to-send-money-from-cyprus-taptap-send-bonus-guide/">💸 0% Fee Money Transfer Cashback</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 3rem 1rem 5rem;
    text-align: center;
  }

  .error-code {
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #2563eb, #38bdf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .error-container h1 {
    font-size: 2rem;
    margin: 0 0 1rem;
  }

  .error-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .quick-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .btn-primary {
    background: var(--primary-blue);
    color: #ffffff;
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .btn-secondary {
    background: rgba(150, 150, 150, 0.1);
    color: var(--text-main);
    border: 1px solid var(--card-border);
    padding: 0.65rem 1.4rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .popular-picks {
    background: rgba(37, 99, 235, 0.04);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: left;
  }

  .picks-label {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--primary-blue);
  }

  .popular-picks ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .popular-picks li {
    margin-bottom: 0.5rem;
  }

  .popular-picks a {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .popular-picks a:hover {
    color: var(--primary-blue);
    text-decoration: underline;
  }
</style>
